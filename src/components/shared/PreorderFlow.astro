---
/**
 * Click&Collect-Vorbestellung für Brot & Torten (Master-Prompt §9.8).
 * Vier Schritte (Produkte → Abholtag → Zeitfenster → Zusammenfassung), reine
 * Mock-Datenschicht — nichts wird übertragen. Zustand lebt nur im Browser-
 * Speicher des Scripts (kein localStorage/sessionStorage, Master-Prompt-Verbot).
 * Abholtags-Logik nutzt die zentrale Öffnungszeiten-Bibliothek (nicht neu
 * erfunden) für Ruhetage/Ausnahmen; Bestellschluss (18 Uhr) und Vorlaufzeiten
 * (Torten: 5 Tage) sind hier fest hinterlegt.
 */
import site from '../../data/site.json';
import { formatMenuPrice } from '../../lib/format';

interface Props {
  /** Varianten-Basispfad, z. B. "/a" — für den Rücksprung nach Erfolg. */
  base: string;
}
const { base } = Astro.props;

interface Product {
  id: string;
  name: string;
  price: number;
  leadDays: number;
  note?: string;
  /** true = Beispielpreis (°); Brotpreise sind bestätigt (Tafel im Café, 16.08.2026) */
  placeholder?: boolean;
}

const PRODUCTS: Product[] = [
  { id: 'bauernbrot', name: 'Bauernbrot', price: 7.0, leadDays: 0 },
  { id: 'roggenvollkorn', name: 'Roggenvollkorn', price: 7.0, leadDays: 0 },
  { id: 'dinkelvollkorn-saaten', name: 'Dinkelvollkorn mit Saaten', price: 6.5, leadDays: 0, note: 'neu' },
  { id: 'schnecke-pistazie', name: 'Sauerteigschnecke Pistazie', price: 4.2, leadDays: 0, placeholder: true },
  { id: 'schnecke-lotus', name: 'Sauerteigschnecke Lotus', price: 4.2, leadDays: 0, placeholder: true },
  { id: 'schnecke-haselnuss', name: 'Sauerteigschnecke Haselnuss', price: 4.2, leadDays: 0, placeholder: true },
  { id: 'kaesekuchen', name: 'Käsekuchen ganz', price: 24.0, leadDays: 5, note: 'Vorlauf 5 Tage', placeholder: true },
  { id: 'obsttorte', name: 'Obsttorte ganz', price: 26.0, leadDays: 5, note: 'Vorlauf 5 Tage', placeholder: true },
];

const WINDOWS = [
  { value: '08-10', label: '8–10 Uhr' },
  { value: '10-12', label: '10–12 Uhr' },
  { value: '12-14', label: '12–14 Uhr' },
  { value: '14-16', label: '14–16 Uhr' },
];

const STEP_LABELS = ['Produkte', 'Abholtag', 'Zeitfenster', 'Zusammenfassung'];

const scheduleJson = JSON.stringify(site.openingHours);

const btnPrimary =
  'inline-flex min-h-[44px] items-center justify-center rounded-card bg-ink px-5 py-2.5 font-mono text-sm text-bg transition-colors duration-[var(--dur-fast)] ease-[var(--ease-brand)] disabled:cursor-not-allowed disabled:bg-ink/30 disabled:text-bg/70';
const btnSecondary =
  'inline-flex min-h-[44px] items-center justify-center rounded-card border-2 border-ink px-5 py-2.5 font-mono text-sm text-ink transition-colors duration-[var(--dur-fast)] ease-[var(--ease-brand)]';
---

<div
  class="preorder-flow rounded-card border border-ink/10 bg-paper p-5 md:p-7"
  data-preorder-flow
  data-schedule={scheduleJson}
>
  <p class="sr-only" role="status" aria-live="polite" data-step-announcer></p>

  <ol class="mb-6 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-sm text-ink-soft" aria-label="Fortschritt der Vorbestellung" data-progress>
    {STEP_LABELS.map((label, i) => (
      <li data-progress-item={i + 1} class:list={['flex items-center gap-1.5', i === 0 && 'text-ink font-semibold']}>
        <span aria-hidden="true">{i + 1}.</span>
        <span>{label}</span>
      </li>
    ))}
  </ol>

  <form data-preorder-form novalidate>
    <div data-steps-wrap>
      {/* Schritt 1 — Produkte */}
      <section data-step="1">
        <h3 class="sr-only">Schritt 1 von 4: Produkte wählen</h3>
        <fieldset>
          <legend class="font-mono text-sm uppercase tracking-widest text-ink-soft">Was möchtest du abholen?</legend>
          <ul class="mt-4 flex flex-col divide-y divide-ink/10">
            {PRODUCTS.map((p) => (
              <li
                class="flex flex-wrap items-center justify-between gap-3 py-3"
                data-product-row
                data-product-id={p.id}
                data-name={p.name}
                data-price={p.price}
                data-lead-days={p.leadDays}
                data-qty="0"
              >
                <div>
                  <p class="text-base">{p.name}</p>
                  <p class="font-mono text-sm text-ink-soft">
                    {formatMenuPrice(p.price, p.placeholder ?? false)}{p.note ? ` · ${p.note}` : ''}
                  </p>
                </div>
                <div class="inline-flex items-center gap-3">
                  <button
                    type="button"
                    data-qty-minus
                    disabled
                    class="grid size-11 place-items-center rounded-card border-2 border-ink text-lg leading-none transition-colors duration-[var(--dur-fast)] ease-[var(--ease-brand)] disabled:cursor-not-allowed disabled:border-ink/20 disabled:text-ink-soft"
                    aria-label={`${p.name}: Menge verringern`}
                  >−</button>
                  <output class="qty-value w-6 text-center font-mono tabular text-base" data-qty-value>0</output>
                  <button
                    type="button"
                    data-qty-plus
                    class="grid size-11 place-items-center rounded-card border-2 border-ink text-lg leading-none transition-colors duration-[var(--dur-fast)] ease-[var(--ease-brand)] disabled:cursor-not-allowed disabled:border-ink/20 disabled:text-ink-soft"
                    aria-label={`${p.name}: Menge erhöhen`}
                  >+</button>
                </div>
              </li>
            ))}
          </ul>
        </fieldset>
        <p class="mt-3 text-sm text-ink-soft">° Beispielpreis — finale Preise folgen. Brotpreise sind aktuell.</p>
        <div class="mt-6 flex flex-wrap items-center justify-end gap-3">
          <p class="mr-auto text-sm text-ink-soft" data-hint-step1>Wähle mindestens ein Produkt, um weiterzugehen.</p>
          <button type="button" class={btnPrimary} data-action="next" data-target-step="2" disabled>Weiter</button>
        </div>
      </section>

      {/* Schritt 2 — Abholtag */}
      <section data-step="2" hidden>
        <h3 class="sr-only">Schritt 2 von 4: Abholtag wählen</h3>
        <p class="font-mono text-sm uppercase tracking-widest text-ink-soft">Wann möchtest du abholen?</p>
        <p class="mt-2 text-sm text-ink-soft" data-cutoff-countdown aria-live="polite" hidden></p>
        <p class="mt-2 text-sm text-accent-ink" data-lead-note hidden>
          Für Torten planen wir 5 Tage Vorlauf ein — dein frühester Abholtag verschiebt sich entsprechend.
        </p>
        <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4" data-day-grid></div>
        <div class="mt-6 flex flex-wrap items-center justify-between gap-3">
          <button type="button" class={btnSecondary} data-action="back" data-target-step="1">Zurück</button>
          <button type="button" class={btnPrimary} data-action="next" data-target-step="3" disabled>Weiter</button>
        </div>
      </section>

      {/* Schritt 3 — Zeitfenster */}
      <section data-step="3" hidden>
        <h3 class="sr-only">Schritt 3 von 4: Zeitfenster wählen</h3>
        <fieldset>
          <legend class="font-mono text-sm uppercase tracking-widest text-ink-soft">In welchem Zeitfenster?</legend>
          <div class="mt-4 grid grid-cols-2 gap-3">
            {WINDOWS.map((w) => (
              <label class="window-tile relative flex min-h-[44px] cursor-pointer items-center justify-center rounded-card border-2 border-ink/20 px-4 py-3 font-mono text-sm transition-colors duration-[var(--dur-fast)] ease-[var(--ease-brand)] has-[:checked]:border-primary has-[:checked]:bg-primary has-[:checked]:text-bg">
                <input type="radio" name="pickup-window" value={w.value} class="sr-only" />
                <span data-window-label>{w.label}</span>
              </label>
            ))}
          </div>
        </fieldset>
        <div class="mt-6 flex flex-wrap items-center justify-between gap-3">
          <button type="button" class={btnSecondary} data-action="back" data-target-step="2">Zurück</button>
          <button type="button" class={btnPrimary} data-action="next" data-target-step="4" disabled>Weiter</button>
        </div>
      </section>

      {/* Schritt 4 — Zusammenfassung */}
      <section data-step="4" hidden data-summary>
        <h3 class="sr-only">Schritt 4 von 4: Zusammenfassung & Kontakt</h3>
        <p class="font-mono text-sm uppercase tracking-widest text-ink-soft">Deine Vorbestellung</p>
        <ul class="mt-4 flex flex-col divide-y divide-ink/10" data-summary-items></ul>
        <div class="mt-3 flex items-center justify-between border-t border-ink/20 pt-3 font-mono text-base">
          <span>Summe</span>
          <span data-summary-total>–</span>
        </div>
        <dl class="mt-4 grid grid-cols-2 gap-2 font-mono text-sm text-ink-soft">
          <dt>Abholtag</dt>
          <dd data-summary-day class="text-ink">–</dd>
          <dt>Zeitfenster</dt>
          <dd data-summary-window class="text-ink">–</dd>
        </dl>

        <div class="mt-6 flex flex-col gap-4">
          <div>
            <label for="preorder-name" class="block text-sm text-ink-soft">Name*</label>
            <input
              id="preorder-name"
              name="name"
              type="text"
              autocomplete="name"
              class="mt-1 min-h-[44px] w-full rounded-card border-2 border-ink/20 bg-paper px-3 py-2 text-base"
              aria-describedby="preorder-name-error"
            />
            <p id="preorder-name-error" class="mt-1 text-sm text-closed" data-error-for="name" aria-live="polite" hidden></p>
          </div>
          <div>
            <label for="preorder-phone" class="block text-sm text-ink-soft">Telefon*</label>
            <input
              id="preorder-phone"
              name="phone"
              type="tel"
              autocomplete="tel"
              class="mt-1 min-h-[44px] w-full rounded-card border-2 border-ink/20 bg-paper px-3 py-2 text-base"
              aria-describedby="preorder-phone-error"
            />
            <p id="preorder-phone-error" class="mt-1 text-sm text-closed" data-error-for="phone" aria-live="polite" hidden></p>
          </div>
        </div>

        <div class="mt-6 flex flex-wrap items-center justify-between gap-3">
          <button type="button" class={btnSecondary} data-action="back" data-target-step="3">Zurück</button>
          <button type="submit" class={btnPrimary}>Vorbestellung senden (Demo)</button>
        </div>
      </section>
    </div>

    <div class="success-panel" data-success hidden tabindex="-1" aria-live="polite">
      <p class="text-xl">Danke, deine Vorbestellung ist vorgemerkt.</p>
      <p class="mt-2 text-base">
        Demo — die Bestellung wurde nicht übertragen. Ruf uns an: <a class="underline" href={`tel:${site.phone.replace(/[^+\d]/g, '')}`}>{site.phoneDisplay}</a>
      </p>
      <a href={base} class="mt-4 inline-block font-mono text-sm text-ink-soft underline">Zurück zur Startseite</a>
    </div>
  </form>
</div>

<script>
  import { berlinParts, type Schedule, type WeekKey } from '../../lib/opening-hours';
  import { formatPrice, formatDateShort } from '../../lib/format';

  interface CartItem {
    id: string;
    name: string;
    price: number;
    leadDays: number;
    qty: number;
  }

  const WEEK_KEYS: WeekKey[] = ['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat'];
  const CUTOFF_MINUTES = 18 * 60;

  /** Kalendertag + Wochentag N Tage nach `dateISO` — DST-sicher (Mittag UTC). */
  function addDaysISO(dateISO: string, days: number): { dateISO: string; weekday: WeekKey } {
    const d = new Date(`${dateISO}T12:00:00Z`);
    d.setUTCDate(d.getUTCDate() + days);
    const iso = d.toISOString().slice(0, 10);
    return { dateISO: iso, weekday: WEEK_KEYS[d.getUTCDay()] as WeekKey };
  }

  function isDayClosed(schedule: Schedule, dateISO: string, weekday: WeekKey): boolean {
    const ex = schedule.exceptions.find((e) => e.date === dateISO);
    const hours = ex ? ex.hours : (schedule.week[weekday] ?? []);
    return hours.length === 0;
  }

  function init() {
    const root = document.querySelector<HTMLElement>('[data-preorder-flow]');
    if (!root || root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';

    const schedule = JSON.parse(root.dataset.schedule ?? '{}') as Schedule;
    const form = root.querySelector<HTMLFormElement>('[data-preorder-form]')!;
    const announcer = root.querySelector<HTMLElement>('[data-step-announcer]')!;
    const dayGrid = root.querySelector<HTMLElement>('[data-day-grid]')!;
    const countdownEl = root.querySelector<HTMLElement>('[data-cutoff-countdown]')!;
    const leadNoteEl = root.querySelector<HTMLElement>('[data-lead-note]')!;
    const successEl = root.querySelector<HTMLElement>('[data-success]')!;
    const stepsWrap = root.querySelector<HTMLElement>('[data-steps-wrap]')!;
    const progressItems = Array.from(root.querySelectorAll<HTMLElement>('[data-progress-item]'));

    const state: { step: number; date: string | null; window: string | null } = {
      step: 1,
      date: null,
      window: null,
    };

    function getCartItems(): CartItem[] {
      return Array.from(root!.querySelectorAll<HTMLElement>('[data-product-row]'))
        .map((row) => ({
          id: row.dataset.productId ?? '',
          name: row.dataset.name ?? '',
          price: Number(row.dataset.price ?? '0'),
          leadDays: Number(row.dataset.leadDays ?? '0'),
          qty: Number(row.dataset.qty ?? '0'),
        }))
        .filter((i) => i.qty > 0);
    }

    function setRowQty(row: HTMLElement, qty: number) {
      row.dataset.qty = String(qty);
      const out = row.querySelector<HTMLElement>('[data-qty-value]');
      if (out) out.textContent = String(qty);
      const minus = row.querySelector<HTMLButtonElement>('[data-qty-minus]');
      const plus = row.querySelector<HTMLButtonElement>('[data-qty-plus]');
      if (minus) minus.disabled = qty <= 0;
      if (plus) plus.disabled = qty >= 10;
    }

    function updateStep1Gate() {
      const total = getCartItems().reduce((n, i) => n + i.qty, 0);
      const nextBtn = root!.querySelector<HTMLButtonElement>('[data-step="1"] [data-action="next"]')!;
      nextBtn.disabled = total < 1;
    }

    /** Frühester Abholtag als Tages-Offset — `minutes`/`hasLongLead` stammen aus einem gemeinsamen `now`, damit Countdown und Tagesliste nie auseinanderlaufen (z. B. bei Mitternacht/18-Uhr-Grenze). */
    function computeEarliestOffsetDays(minutes: number, hasLongLead: boolean): number {
      if (hasLongLead) return 5;
      return minutes < CUTOFF_MINUTES ? 1 : 2;
    }

    function renderDayGrid() {
      const hasLongLead = getCartItems().some((i) => i.leadDays > 0);
      leadNoteEl.hidden = !hasLongLead;

      const now = new Date();
      const { dateISO: todayISO, minutes } = berlinParts(now);
      if (!hasLongLead && minutes < CUTOFF_MINUTES) {
        const left = CUTOFF_MINUTES - minutes;
        const h = Math.floor(left / 60);
        const m = left % 60;
        countdownEl.textContent = `Bestellschluss für morgen in ${h} Std ${m} Min`;
        countdownEl.hidden = false;
      } else {
        countdownEl.hidden = true;
      }

      const offset = computeEarliestOffsetDays(minutes, hasLongLead);
      dayGrid.innerHTML = '';
      let stillValid = false;
      for (let i = 0; i < 7; i++) {
        const { dateISO, weekday } = addDaysISO(todayISO, offset + i);
        const closed = isDayClosed(schedule, dateISO, weekday);
        if (dateISO === state.date && !closed) stillValid = true;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.dataset.dayOption = 'true';
        btn.dataset.date = dateISO;
        btn.disabled = closed;
        btn.setAttribute('aria-pressed', String(state.date === dateISO));
        btn.className =
          'flex min-h-[44px] flex-col items-center justify-center gap-0.5 rounded-card border-2 px-2 py-2 font-mono text-sm transition-colors duration-[var(--dur-fast)] ease-[var(--ease-brand)] ' +
          (closed
            ? 'cursor-not-allowed border-ink/10 bg-bg-alt text-ink-soft'
            : state.date === dateISO
              ? 'border-primary bg-primary text-bg'
              : 'border-ink/20 text-ink');
        btn.innerHTML = `<span>${formatDateShort(dateISO)}</span>${closed ? '<span class="text-xs">Ruhetag</span>' : ''}`;
        dayGrid.appendChild(btn);
      }
      if (!stillValid) {
        state.date = null;
      }
      const nextBtn = root!.querySelector<HTMLButtonElement>('[data-step="2"] [data-action="next"]')!;
      nextBtn.disabled = !state.date;
    }

    function selectDay(dateISO: string) {
      state.date = dateISO;
      renderDayGrid();
    }

    function goToStep(n: number) {
      state.step = n;
      root!.querySelectorAll<HTMLElement>('[data-step]').forEach((sec) => {
        sec.hidden = Number(sec.dataset.step) !== n;
      });
      progressItems.forEach((li, i) => {
        li.classList.toggle('text-ink', i + 1 === n);
        li.classList.toggle('font-semibold', i + 1 === n);
        li.classList.toggle('text-ink-soft', i + 1 !== n);
      });
      const label = ['Produkte wählen', 'Abholtag wählen', 'Zeitfenster wählen', 'Zusammenfassung & Kontakt'][n - 1];
      announcer.textContent = `Schritt ${n} von 4: ${label}`;
      if (n === 2) renderDayGrid();
      if (n === 4) renderSummary();
    }

    function renderSummary() {
      const items = getCartItems();
      const list = root!.querySelector<HTMLElement>('[data-summary-items]')!;
      list.innerHTML = '';
      for (const item of items) {
        const li = document.createElement('li');
        li.className = 'flex items-center justify-between gap-4 py-1.5';
        const left = document.createElement('span');
        left.textContent = `${item.qty}× ${item.name}`;
        const right = document.createElement('span');
        right.className = 'font-mono';
        right.textContent = formatPrice(item.price * item.qty);
        li.append(left, right);
        list.appendChild(li);
      }
      const total = items.reduce((sum, i) => sum + i.price * i.qty, 0);
      root!.querySelector<HTMLElement>('[data-summary-total]')!.textContent = formatPrice(total);
      root!.querySelector<HTMLElement>('[data-summary-day]')!.textContent = state.date ? formatDateShort(state.date) : '–';
      const checkedWindow = root!.querySelector<HTMLInputElement>('input[name="pickup-window"]:checked');
      const windowLabel = checkedWindow?.closest('label')?.querySelector('[data-window-label]')?.textContent ?? '–';
      root!.querySelector<HTMLElement>('[data-summary-window]')!.textContent = windowLabel;
    }

    function validateStep4(): boolean {
      let valid = true;
      const nameInput = form.querySelector<HTMLInputElement>('#preorder-name')!;
      const phoneInput = form.querySelector<HTMLInputElement>('#preorder-phone')!;
      const nameError = form.querySelector<HTMLElement>('[data-error-for="name"]')!;
      const phoneError = form.querySelector<HTMLElement>('[data-error-for="phone"]')!;

      if (!nameInput.value.trim()) {
        nameError.textContent = 'Da fehlt noch dein Name.';
        nameError.hidden = false;
        nameInput.setAttribute('aria-invalid', 'true');
        valid = false;
      } else {
        nameError.hidden = true;
        nameInput.removeAttribute('aria-invalid');
      }

      if (!phoneInput.value.trim()) {
        phoneError.textContent = 'Da fehlt noch deine Telefonnummer — sonst können wir dich nicht kurz erreichen.';
        phoneError.hidden = false;
        phoneInput.setAttribute('aria-invalid', 'true');
        valid = false;
      } else {
        phoneError.hidden = true;
        phoneInput.removeAttribute('aria-invalid');
      }
      return valid;
    }

    function showSuccess() {
      stepsWrap.hidden = true;
      root!.querySelector<HTMLElement>('[data-progress]')!.hidden = true;
      successEl.hidden = false;
      successEl.focus();
    }

    root.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;

      const minusBtn = target.closest<HTMLButtonElement>('[data-qty-minus]');
      const plusBtn = target.closest<HTMLButtonElement>('[data-qty-plus]');
      if (minusBtn || plusBtn) {
        const row = (minusBtn ?? plusBtn)!.closest<HTMLElement>('[data-product-row]');
        if (!row) return;
        const qty = Number(row.dataset.qty ?? '0');
        setRowQty(row, minusBtn ? Math.max(0, qty - 1) : Math.min(10, qty + 1));
        updateStep1Gate();
        return;
      }

      const dayBtn = target.closest<HTMLButtonElement>('[data-day-option]');
      if (dayBtn && !dayBtn.disabled) {
        selectDay(dayBtn.dataset.date ?? '');
        return;
      }

      const navBtn = target.closest<HTMLButtonElement>('[data-action]');
      if (navBtn) {
        const action = navBtn.dataset.action;
        if (action === 'next' || action === 'back') {
          const targetStep = Number(navBtn.dataset.targetStep);
          if (targetStep) goToStep(targetStep);
        }
      }
    });

    root.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.name === 'pickup-window') {
        state.window = t.value;
        const nextBtn = root!.querySelector<HTMLButtonElement>('[data-step="3"] [data-action="next"]')!;
        nextBtn.disabled = false;
      }
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!validateStep4()) return;
      showSuccess();
    });

    setInterval(renderDayGrid, 60_000);
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>
