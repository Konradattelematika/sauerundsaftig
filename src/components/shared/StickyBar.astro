---
/**
 * Mobile Sticky-Bar (immer sichtbar, <768px): Karte · Anrufen · Route · Vorbestellen.
 * Touch-Targets ≥44 px, Safe-Area-Inset. Seiten mit dieser Bar tragen
 * die Klasse `has-sticky-bar` auf <body> (Platz am Seitenende).
 * Live-Site (base ""): Einträge aus dem CMS (layout.stickyBar.items, Reihenfolge = Inhaltsstand;
 * variant accent/primary = hervorgehobener Eintrag). Altvarianten (/b /c /d): feste Einträge wie bisher.
 */
import site from '../../data/site.json';
import { routeHref, telHref } from '../../lib/format';
import { cms, linkAttrs, shown, tokens } from '../../cms';

interface Props {
  base: string; // "" (Live-Site A im Wurzelpfad) | "/b" | "/c" | "/d"
}
const { base } = Astro.props;

type Item = { label: string; attrs: Record<string, string>; icon: string; cta?: boolean };
const items: Item[] =
  base === ''
    ? (cms().layout?.stickyBar?.items ?? []).filter(shown).map((it) => ({
        label: tokens(it.label),
        attrs: linkAttrs(it),
        icon: it.icon,
        cta: it.variant === 'accent' || it.variant === 'primary',
      }))
    : [
        { label: 'Karte', attrs: { href: `${base}/karte` }, icon: 'menu' },
        { label: 'Anrufen', attrs: { href: telHref(site.phone) }, icon: 'phone' },
        {
          label: 'Route',
          attrs: { href: routeHref(site.address.street, site.address.zip, site.address.city), target: '_blank', rel: 'noopener' },
          icon: 'route',
        },
        { label: 'Vorbestellen', attrs: { href: `${base}/vorbestellen` }, icon: 'bag', cta: true },
      ];
const icons: Record<string, string> = {
  menu: 'M3 5h18M3 12h18M3 19h12',
  phone: 'M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2Z',
  route: 'M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11Zm0-8.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z',
  bag: 'M6 7h12l1 14H5L6 7Zm3 0a3 3 0 0 1 6 0',
};
// Spaltenzahl = Zahl der Einträge (Klassen ausgeschrieben, damit Tailwind sie findet)
const COLS: Record<number, string> = { 1: 'grid-cols-1', 2: 'grid-cols-2', 3: 'grid-cols-3', 4: 'grid-cols-4', 5: 'grid-cols-5', 6: 'grid-cols-6' };
---

{items.length > 0 && (
  <nav
    class="sticky-bar fixed inset-x-0 bottom-0 z-50 border-t border-ink/10 bg-paper pb-safe md:hidden"
    aria-label="Schnellzugriff"
  >
    <ul class:list={['grid', COLS[items.length] ?? 'grid-cols-6']}>
      {items.map((it) => (
        <li>
          <a
            {...it.attrs}
            class:list={[
              'flex min-h-[60px] flex-col items-center justify-center gap-1 px-1 py-2 font-mono text-[13px]',
              it.cta ? 'bg-accent text-white' : 'text-ink',
            ]}
          >
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={icons[it.icon] ?? icons.menu} />
            </svg>
            {it.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
