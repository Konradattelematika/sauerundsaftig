---
/**
 * Gutschein-Konfigurator (Master-Prompt §9.9). Zwei Modi — Betrag oder
 * Workshop — mit Live-Vorschau als gestaltete Karte. Reine Mock-Datenschicht:
 * Der „Kauf" überträgt nichts, Zahlung folgt später über Shopify. Zustand nur
 * im Browser-Speicher des Scripts, kein localStorage/sessionStorage.
 */
import { formatMenuPrice, formatPrice } from '../../lib/format';

interface Props {
  /** Varianten-Basispfad, z. B. "/a" — für den Rücksprung nach Erfolg. */
  base: string;
}
const { base } = Astro.props;

const AMOUNT_TILES = [20, 35, 50];
const WORKSHOPS = [
  { id: 'anfaenger', title: 'Sauerteig für Anfänger', price: 129 },
  { id: 'intensiv', title: 'Brot & Schnecken intensiv', price: 189 },
];

const btnPrimary =
  'inline-flex min-h-[44px] items-center justify-center rounded-card bg-ink px-5 py-2.5 font-mono text-sm text-bg transition-colors duration-[var(--dur-fast)] ease-[var(--ease-brand)] disabled:cursor-not-allowed disabled:bg-ink/30 disabled:text-bg/70';
---

<div class="voucher-configurator grid gap-6 md:grid-cols-2" data-voucher-configurator>
  <form data-voucher-form novalidate>
    <fieldset>
      <legend class="font-mono text-sm uppercase tracking-widest text-ink-soft">Art des Gutscheins</legend>
      <div class="mt-3 grid grid-cols-2 gap-3">
        <label class="voucher-type-tile relative flex min-h-[44px] cursor-pointer items-center justify-center rounded-card border-2 border-ink/20 px-4 py-3 font-mono text-sm transition-colors duration-[var(--dur-fast)] ease-[var(--ease-brand)] has-[:checked]:border-primary has-[:checked]:bg-primary has-[:checked]:text-bg">
          <input type="radio" name="voucher-type" value="amount" class="sr-only" checked />
          <span>Betrag</span>
        </label>
        <label class="voucher-type-tile relative flex min-h-[44px] cursor-pointer items-center justify-center rounded-card border-2 border-ink/20 px-4 py-3 font-mono text-sm transition-colors duration-[var(--dur-fast)] ease-[var(--ease-brand)] has-[:checked]:border-primary has-[:checked]:bg-primary has-[:checked]:text-bg">
          <input type="radio" name="voucher-type" value="workshop" class="sr-only" />
          <span>Workshop</span>
        </label>
      </div>
    </fieldset>

    <div class="mt-6" data-panel-amount>
      <fieldset>
        <legend class="font-mono text-sm uppercase tracking-widest text-ink-soft">Betrag wählen</legend>
        <div class="mt-3 grid grid-cols-3 gap-3">
          {AMOUNT_TILES.map((amount) => (
            <label class="amount-tile relative flex min-h-[44px] cursor-pointer items-center justify-center rounded-card border-2 border-ink/20 px-3 py-3 font-mono text-sm transition-colors duration-[var(--dur-fast)] ease-[var(--ease-brand)] has-[:checked]:border-primary has-[:checked]:bg-primary has-[:checked]:text-bg">
              <input type="radio" name="voucher-amount" value={amount} class="sr-only" data-amount-radio />
              <span>{formatPrice(amount)}</span>
            </label>
          ))}
        </div>
        <div class="mt-3">
          <label for="voucher-custom-amount" class="block text-sm text-ink-soft">Eigener Betrag (20–200 €)</label>
          <input
            id="voucher-custom-amount"
            type="number"
            inputmode="numeric"
            min="20"
            max="200"
            step="1"
            placeholder="z. B. 75"
            class="mt-1 min-h-[44px] w-full max-w-[10rem] rounded-card border-2 border-ink/20 bg-paper px-3 py-2 text-base"
            data-custom-amount
            aria-describedby="voucher-amount-error"
          />
        </div>
        <p id="voucher-amount-error" class="mt-2 text-sm text-closed" data-error-for="amount" aria-live="polite" hidden></p>
      </fieldset>
    </div>

    <div class="mt-6" data-panel-workshop hidden>
      <fieldset>
        <legend class="font-mono text-sm uppercase tracking-widest text-ink-soft">Workshop wählen</legend>
        <div class="mt-3 flex flex-col gap-3">
          {WORKSHOPS.map((w) => (
            <label class="workshop-tile relative flex min-h-[44px] cursor-pointer items-center justify-between gap-3 rounded-card border-2 border-ink/20 px-4 py-3 transition-colors duration-[var(--dur-fast)] ease-[var(--ease-brand)] has-[:checked]:border-primary has-[:checked]:bg-primary has-[:checked]:text-bg">
              <input type="radio" name="voucher-workshop" value={w.id} class="sr-only" />
              <span data-workshop-title>{w.title}</span>
              <span class="font-mono text-sm" data-workshop-price={w.price}>{formatMenuPrice(w.price, true)}</span>
            </label>
          ))}
        </div>
        <p id="voucher-workshop-error" class="mt-2 text-sm text-closed" data-error-for="workshop" aria-live="polite" hidden></p>
      </fieldset>
    </div>

    <div class="mt-6">
      <label for="voucher-for" class="block text-sm text-ink-soft">Für (optional)</label>
      <input
        id="voucher-for"
        type="text"
        maxlength="40"
        placeholder="Name der beschenkten Person"
        class="mt-1 min-h-[44px] w-full rounded-card border-2 border-ink/20 bg-paper px-3 py-2 text-base"
        data-for-name
      />
    </div>

    <div class="mt-6">
      <button type="submit" class={btnPrimary}>Gutschein kaufen (Demo)</button>
    </div>

    <div class="success-panel mt-6" data-success hidden tabindex="-1" aria-live="polite">
      <p class="text-xl">Demo — der Gutschein wurde nicht gekauft.</p>
      <p class="mt-2 text-base">Zahlung folgt in der Shop-Phase (Shopify).</p>
      <a href={base} class="mt-4 inline-block font-mono text-sm text-ink-soft underline">Zurück zur Startseite</a>
    </div>
  </form>

  <div class="voucher-preview rounded-card border border-ink/10 bg-paper p-6 text-center" data-voucher-preview aria-hidden="true">
    <img src="/brand/logo-wordmark-ink-640.png" alt="Sauer & Saftig" width={220} height={138} class="mx-auto h-auto w-[180px]" />
    <p class="mt-6 font-display text-4xl" data-preview-value>{formatPrice(20)}</p>
    <p class="mt-1 text-sm text-ink-soft" data-preview-sub hidden></p>
    <p class="mt-3 text-base text-ink-soft" data-preview-for hidden></p>
    <p class="mt-6 font-mono text-sm text-ink-soft">3 Jahre gültig · einlösbar im Café, Dünenstraße 1, Rerik</p>
  </div>
</div>

<script>
  import { formatPrice } from '../../lib/format';

  function init() {
    const root = document.querySelector<HTMLElement>('[data-voucher-configurator]');
    if (!root || root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';

    const form = root.querySelector<HTMLFormElement>('[data-voucher-form]')!;
    const panelAmount = root.querySelector<HTMLElement>('[data-panel-amount]')!;
    const panelWorkshop = root.querySelector<HTMLElement>('[data-panel-workshop]')!;
    const customAmount = root.querySelector<HTMLInputElement>('[data-custom-amount]')!;
    const forName = root.querySelector<HTMLInputElement>('[data-for-name]')!;
    const previewValue = root.querySelector<HTMLElement>('[data-preview-value]')!;
    const previewSub = root.querySelector<HTMLElement>('[data-preview-sub]')!;
    const previewFor = root.querySelector<HTMLElement>('[data-preview-for]')!;
    const amountError = root.querySelector<HTMLElement>('[data-error-for="amount"]')!;
    const workshopError = root.querySelector<HTMLElement>('[data-error-for="workshop"]')!;
    const successEl = root.querySelector<HTMLElement>('[data-success]')!;

    function currentType(): 'amount' | 'workshop' {
      const checked = form.querySelector<HTMLInputElement>('input[name="voucher-type"]:checked');
      return checked?.value === 'workshop' ? 'workshop' : 'amount';
    }

    function selectedAmount(): number | null {
      const radio = form.querySelector<HTMLInputElement>('[data-amount-radio]:checked');
      if (radio) return Number(radio.value);
      const custom = Number(customAmount.value);
      if (customAmount.value.trim() && custom >= 20 && custom <= 200) return custom;
      return null;
    }

    function updatePreview() {
      const type = currentType();
      panelAmount.hidden = type !== 'amount';
      panelWorkshop.hidden = type !== 'workshop';

      if (type === 'amount') {
        const amount = selectedAmount();
        previewValue.textContent = amount ? formatPrice(amount) : '–';
        previewSub.hidden = true;
        previewSub.textContent = '';
      } else {
        const checked = form.querySelector<HTMLInputElement>('input[name="voucher-workshop"]:checked');
        const label = checked?.closest('label');
        const title = label?.querySelector('[data-workshop-title]')?.textContent ?? null;
        const price = label?.querySelector('[data-workshop-price]')?.textContent ?? '';
        previewValue.textContent = title ?? 'Workshop wählen';
        previewSub.textContent = title ? price : '';
        previewSub.hidden = !title;
      }

      const forValue = forName.value.trim();
      previewFor.textContent = forValue ? `Für ${forValue}` : '';
      previewFor.hidden = !forValue;
    }

    root.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.name === 'voucher-amount') customAmount.value = '';
      updatePreview();
    });

    customAmount.addEventListener('input', () => {
      form.querySelectorAll<HTMLInputElement>('[data-amount-radio]').forEach((r) => (r.checked = false));
      updatePreview();
    });

    forName.addEventListener('input', updatePreview);

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const type = currentType();
      let valid = true;

      amountError.hidden = true;
      workshopError.hidden = true;

      if (type === 'amount') {
        if (!selectedAmount()) {
          amountError.textContent = 'Wähl eine Kachel oder gib einen Betrag zwischen 20 € und 200 € ein.';
          amountError.hidden = false;
          valid = false;
        }
      } else {
        const checked = form.querySelector<HTMLInputElement>('input[name="voucher-workshop"]:checked');
        if (!checked) {
          workshopError.textContent = 'Wähl einen Workshop aus, bevor du fortfährst.';
          workshopError.hidden = false;
          valid = false;
        }
      }

      if (!valid) return;

      form.querySelectorAll<HTMLElement>('fieldset, [data-for-name], button[type="submit"]').forEach((el) => {
        el.hidden = true;
      });
      successEl.hidden = false;
      successEl.focus();
    });

    updatePreview();
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>
