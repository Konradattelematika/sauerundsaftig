---
/**
 * Alternative 2 „Türschild": das Wendeschild an der Ladentür als Papierkarte an der Kordel.
 * Live-Update im Browser, statische Beispiele für alle Zustände.
 */
import Rahmen from './parts/Rahmen.astro';
import Schild from './parts/Tuerschild.astro';
import { exampleViews, viewNow, SCHEDULE_JSON } from './parts/examples';
import { FALLBACK } from './parts/view';
import { btnPrimary, btnSecondary } from '../../../variants/a-krume/lib/ui';
import site from '../../../data/site.json';
import { telHref } from '../../../lib/format';

const examples = exampleViews();
const now = viewNow();
---

<Rahmen
  eyebrow="Alternative 2"
  title="Türschild"
  lead="Das klassische Wendeschild an der Ladentür: „Offen“ auf Papier mit grüner Kante, „Geschlossen“ als dunkle Karte mit roter Kante — darunter, wann es weitergeht. Beim Darüberfahren pendelt es leicht."
>
  <div slot="live" class="flex flex-col gap-6 rounded-card bg-paper p-5 md:flex-row md:items-start md:justify-between md:p-6">
    <div>
      <p class="font-mono text-[11px] uppercase tracking-widest text-ink-soft">Klein · Kopfzeile</p>
      <div class="mt-2"><Schild size="sm" view={FALLBACK} live schedule={SCHEDULE_JSON} /></div>
    </div>
    <div>
      <p class="font-mono text-[11px] uppercase tracking-widest text-ink-soft">Groß · Startseite, Besuch</p>
      <div class="mt-2"><Schild size="lg" view={FALLBACK} live schedule={SCHEDULE_JSON} /></div>
    </div>
  </div>

  <ul slot="examples" class="grid gap-4 sm:grid-cols-3">
    {examples.map((e) => (
      <li class="rounded-card bg-paper p-4">
        <p class="font-mono text-[11px] uppercase tracking-widest text-ink-soft">{e.label}</p>
        <div class="mt-3 flex flex-col items-start gap-4">
          <Schild size="lg" view={e.view} />
          <Schild size="sm" view={e.view} />
        </div>
      </li>
    ))}
  </ul>

  <div slot="context" class="rounded-card bg-bg-alt px-5 py-8 md:px-10 md:py-12">
    <div class="grid gap-8 md:grid-cols-12 md:items-center">
      <div class="md:col-span-7">
        <p class="font-mono text-xs uppercase tracking-[0.25em] text-ink-soft">Besuch</p>
        <span class="tz-rule mt-3" aria-hidden="true"></span>
        <h2 class="mt-3 text-[clamp(1.75rem,4vw,2.5rem)]">Wann du uns findest</h2>
        <p class="prose-measure mt-4 text-lg text-ink-soft">Reserviere deinen Tisch per Telefon.</p>
        <div class="mt-6 flex flex-wrap gap-4">
          <a href={telHref(site.phone)} class:list={[btnPrimary, 'px-5 py-2.5 text-xl']}>{site.phoneDisplay}</a>
          <a href="/besuch" class:list={[btnSecondary, 'px-5 py-2.5']}>Alle Infos zum Besuch</a>
        </div>
      </div>
      <div class="flex md:col-span-5 md:justify-center">
        <Schild size="lg" view={now} live schedule={SCHEDULE_JSON} />
      </div>
    </div>
  </div>
</Rahmen>
