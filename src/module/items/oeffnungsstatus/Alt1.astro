---
/**
 * Alternative 1 „Kreidetafel": dunkles Täfelchen (bg-ink) mit leicht unregelmäßigem Rahmen,
 * Schlagwort in Fraunces (Kreide), Detail in Mono. Ton über Datenattribut: open = Dünengras-
 * helle Kreide, soon = Sanddorn, closed = Krume gedimmt + rotes Kreuz. Live-Update im Browser
 * über getOpeningStatus (jede Minute), Fallback ohne JS = Wochenzusammenfassung.
 */
import Rahmen from './parts/Rahmen.astro';
import Tafel from './parts/Kreidetafel.astro';
import { exampleViews, viewNow, SCHEDULE_JSON } from './parts/examples';
import { FALLBACK } from './parts/view';
import { btnPrimary, btnSecondary } from '../../../variants/a-krume/lib/ui';
import site from '../../../data/site.json';
import { telHref } from '../../../lib/format';

const examples = exampleViews();
const now = viewNow();
---

<Rahmen
  eyebrow="Alternative 1"
  title="Kreidetafel"
  lead="Wie die Tafel an der Theke: dunkler Grund, das Wichtigste mit Kreide groß geschrieben. Grün-helle Kreide heißt offen, Sanddorn heißt „bald zu", gedimmt mit Kreuz heißt Ruhetag."
>
  <div slot="live" class="flex flex-col gap-6 rounded-card bg-paper p-5 md:flex-row md:items-end md:justify-between md:p-6">
    <div>
      <p class="font-mono text-[11px] uppercase tracking-widest text-ink-soft">Klein · Kopfzeile</p>
      <div class="mt-2"><Tafel size="sm" view={FALLBACK} live schedule={SCHEDULE_JSON} /></div>
    </div>
    <div>
      <p class="font-mono text-[11px] uppercase tracking-widest text-ink-soft">Groß · Startseite, Besuch</p>
      <div class="mt-2"><Tafel size="lg" view={FALLBACK} live schedule={SCHEDULE_JSON} /></div>
    </div>
  </div>

  <ul slot="examples" class="grid gap-4 sm:grid-cols-3">
    {examples.map((e) => (
      <li class="rounded-card bg-paper p-4">
        <p class="font-mono text-[11px] uppercase tracking-widest text-ink-soft">{e.label}</p>
        <div class="mt-3"><Tafel size="lg" view={e.view} /></div>
        <div class="mt-3"><Tafel size="sm" view={e.view} /></div>
      </li>
    ))}
  </ul>

  <div slot="context" class="rounded-card bg-bg-alt px-5 py-8 md:px-10 md:py-12">
    <div class="grid gap-8 md:grid-cols-12 md:items-center">
      <div class="md:col-span-7">
        <p class="font-mono text-xs uppercase tracking-[0.25em] text-ink-soft">Besuch</p>
        <span class="tz-rule mt-3" aria-hidden="true"></span>
        <h2 class="mt-3 text-[clamp(1.75rem,4vw,2.5rem)]">Wann du uns findest</h2>
        <p class="prose-measure mt-4 text-lg text-ink-soft">Dienstag und Mittwoch backen wir nicht — plan deinen Besuch drumherum.</p>
        <div class="mt-6 flex flex-wrap gap-4">
          <a href={telHref(site.phone)} class:list={[btnPrimary, 'px-5 py-2.5 text-xl']}>{site.phoneDisplay}</a>
          <a href="/besuch" class:list={[btnSecondary, 'px-5 py-2.5']}>Alle Infos zum Besuch</a>
        </div>
      </div>
      <div class="md:col-span-5">
        <Tafel size="lg" view={now} live schedule={SCHEDULE_JSON} class="w-full" />
      </div>
    </div>
  </div>
</Rahmen>
