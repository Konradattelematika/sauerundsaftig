---
/**
 * Beispiel-Seiteninhalt unter der Kopfzeile, damit Sticky- und Scroll-Verhalten erlebbar sind:
 * Startseiten-Bühne (echte Texte, echtes Foto) plus zwei kurze Abschnitte — insgesamt deutlich
 * länger als ein Bildschirm.
 */
import Figure from '../../../../variants/a-krume/components/Figure.astro';
import site from '../../../../data/site.json';
import { btnAccent, btnSecondary, arrowIcon } from '../../../../variants/a-krume/lib/ui';
import { routeHref } from '../../../../lib/format';

const route = routeHref(site.address.street, site.address.zip, site.address.city);
---

<main>
  <section class="bg-bg pb-14 pt-8 md:pb-24 md:pt-14">
    <div class="mx-auto max-w-[1440px] px-4 md:px-8">
      <p class="mb-6 font-mono text-[11px] uppercase tracking-widest text-ink-soft">↓ Beispiel-Seiteninhalt zum Scrollen — oben bleibt die Kopfzeile stehen</p>
      <div class="grid grid-cols-1 gap-10 md:grid-cols-12 md:items-center md:gap-6">
        <div class="order-2 md:order-1 md:col-span-5">
          <p><span class="tz-tag">Café &amp; Backstube · Ostseebad Rerik</span></p>
          <h1 class="mt-5 text-[clamp(2.5rem,7vw,4.75rem)]">Fast alles bei uns beginnt mit Sauerteig. Auch der Käsekuchen.</h1>
          <p class="prose-measure mt-5 text-lg text-ink-soft md:text-xl">{site.subline}</p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="/karte" class={btnAccent}>
              Karte ansehen
              <svg class={arrowIcon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </a>
            <a href={route} target="_blank" rel="noopener" class={btnSecondary}>Route</a>
          </div>
        </div>
        <div class="order-1 md:order-2 md:col-span-7 md:pl-6">
          <Figure motif="theke" aspect="aspect-[4/5] md:aspect-[3/4]" sizes="(min-width: 768px) 55vw, 100vw" loading="eager" mat="offset" />
        </div>
      </div>
    </div>
  </section>

  <span class="tz-band" aria-hidden="true"></span>

  <section class="bg-bg-alt py-14 md:py-24">
    <div class="mx-auto max-w-[1440px] px-4 md:px-8">
      <p class="font-mono text-xs uppercase tracking-[0.25em] text-ink-soft">Wer hier bäckt</p>
      <span class="tz-rule mt-3" aria-hidden="true"></span>
      <h2 class="mt-4 text-[clamp(2.25rem,5.5vw,4rem)]">Moin, ich bin Josie.</h2>
      <p class="prose-measure mt-5 text-lg text-ink-soft md:text-xl">
        Ich habe in Rerik ein Café übernommen, das viele schon lange kannten — und eine Backstube hineingestellt, in der fast
        alles mit Sauerteig beginnt.
      </p>
    </div>
  </section>

  <section class="bg-bg py-14 md:py-24">
    <div class="mx-auto max-w-[1440px] px-4 md:px-8">
      <p class="font-mono text-xs uppercase tracking-[0.25em] text-ink-soft">Besuch</p>
      <h2 class="mt-3 text-[clamp(2rem,5vw,3.25rem)]">Wann du uns findest</h2>
      <p class="prose-measure mt-4 text-lg text-ink-soft">Reserviere deinen Tisch per Telefon.</p>
    </div>
  </section>
</main>
