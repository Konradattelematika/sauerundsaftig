---
/**
 * Alternative 1 „Infoleiste & Logo mittig": dunkle Infozeile (Öffnungsstatus, Telefon,
 * Instagram) scrollt weg; darunter die klebende Hauptzeile mit Logo in der Mitte, Menü links
 * und rechts, CTA außen. Hover: Punkt unter dem Menüpunkt. Mobil: Seitenpanel von rechts
 * (<details>, CSS-first) mit Fraunces-Links, CTA, Telefon und Status.
 */
import Logo from '../../../components/shared/Logo.astro';
import OpeningStatus from '../../../components/shared/OpeningStatus.astro';
import site from '../../../data/site.json';
import { telHref } from '../../../lib/format';
import { NAV_MAIN, NAV_CTA, INSTAGRAM_URL } from './parts/nav';
import Seite from './parts/Seite.astro';

const left = NAV_MAIN.slice(0, 2);
const right = NAV_MAIN.slice(2);
const phoneHref = telHref(site.phone);
const navLink =
  'hdr1-link relative inline-flex min-h-11 items-center px-1 font-body text-[1.05rem] font-medium text-ink transition-colors duration-[var(--dur-fast)] ease-[var(--ease-brand)] hover:text-primary-deep';
---

<div class="bg-ink text-bg">
  <div class="mx-auto flex max-w-[1440px] items-center justify-between gap-4 px-4 py-1.5 font-mono text-xs md:px-8">
    <OpeningStatus size="sm" class="text-xs!" />
    <div class="hidden items-center gap-6 sm:flex">
      <a href={phoneHref} class="inline-flex min-h-8 items-center transition-colors duration-[var(--dur-fast)] hover:text-accent">{site.phoneDisplay}</a>
      <a href={INSTAGRAM_URL(site.instagram)} target="_blank" rel="noopener" class="inline-flex min-h-8 items-center transition-colors duration-[var(--dur-fast)] hover:text-accent">@{site.instagram}</a>
    </div>
  </div>
</div>

<header class="hdr1 sticky top-0 z-50 border-b border-ink/10 bg-paper" data-header>
  <div class="mx-auto grid max-w-[1440px] grid-cols-[auto_1fr_auto] items-center gap-4 px-4 py-3 md:px-8 lg:grid-cols-[1fr_auto_1fr] lg:py-4">
    <nav aria-label="Hauptnavigation links" class="hidden lg:col-start-1 lg:block">
      <ul class="flex items-center justify-end gap-8 pr-10">
        {left.map((item) => (
          <li><a href={item.path} class={navLink}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <a href="/" class="relative z-50 col-start-1 shrink-0 justify-self-start lg:col-start-2 lg:justify-self-center" aria-label="Sauer & Saftig — Startseite">
      <Logo variant="lockup" tone="dark" width={150} loading="eager" />
    </a>

    <div class="hidden items-center lg:col-start-3 lg:flex">
      <nav aria-label="Hauptnavigation rechts">
        <ul class="flex items-center gap-8 pl-10">
          {right.map((item) => (
            <li><a href={item.path} class={navLink}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
      <a href={NAV_CTA.path} class="ml-auto inline-flex min-h-11 items-center justify-center rounded-card bg-ink px-5 py-2.5 font-mono text-sm text-bg transition-colors duration-[var(--dur-fast)] ease-[var(--ease-brand)] hover:bg-primary-deep">
        {NAV_CTA.label}
      </a>
    </div>

    <details class="hdr1-mobile col-start-3 justify-self-end lg:hidden">
      <summary
        class="relative z-50 grid size-11 cursor-pointer list-none place-items-center rounded-card border-2 border-ink bg-paper text-ink transition-colors duration-[var(--dur-fast)] ease-[var(--ease-brand)] hover:bg-ink hover:text-bg"
        aria-label="Menü öffnen"
      >
        <svg class="icon-menu" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
        <svg class="icon-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </summary>
      <div class="fixed inset-0 z-40 flex justify-end bg-ink/40">
        <nav aria-label="Mobile Navigation" class="hdr1-panel flex h-full w-[86%] max-w-sm flex-col overflow-y-auto bg-paper px-6 pb-8 pt-24 shadow-[-12px_0_40px_-20px_rgb(36_27_20/0.6)]">
          <ul class="flex flex-col divide-y divide-ink/10 font-display text-3xl">
            {NAV_MAIN.map((item) => (
              <li><a href={item.path} class="flex min-h-14 items-center py-3 text-ink hover:text-primary-deep">{item.label}</a></li>
            ))}
          </ul>
          <a href={NAV_CTA.path} class="mt-6 inline-flex min-h-12 items-center justify-center rounded-card bg-ink px-6 py-3 font-mono text-sm text-bg hover:bg-primary-deep">{NAV_CTA.label}</a>
          <div class="mt-auto flex flex-col gap-3 pt-10 font-mono text-sm">
            <OpeningStatus size="sm" />
            <a href={phoneHref} class="inline-flex min-h-11 items-center text-ink">{site.phoneDisplay}</a>
            <a href={INSTAGRAM_URL(site.instagram)} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center text-ink">@{site.instagram}</a>
          </div>
        </nav>
      </div>
    </details>
  </div>
</header>

<Seite />

<style>
  .hdr1 { transition: box-shadow var(--dur-fast) var(--ease-brand); }
  .hdr1.is-scrolled { box-shadow: 0 1px 0 rgb(36 27 20 / 0.06), 0 8px 24px -16px rgb(36 27 20 / 0.25); }
  /* Punkt unter dem Menüpunkt beim Hover/Fokus/aktiv */
  .hdr1-link::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0.3rem;
    width: 5px;
    height: 5px;
    border-radius: 9999px;
    background: var(--color-primary);
    transform: translateX(-50%) scale(0);
    transition: transform var(--dur-fast) var(--ease-brand);
  }
  .hdr1-link:hover::after,
  .hdr1-link:focus-visible::after,
  .hdr1-link[aria-current='page']::after { transform: translateX(-50%) scale(1); }

  details.hdr1-mobile > summary::-webkit-details-marker { display: none; }
  details.hdr1-mobile[open] > summary .icon-menu { display: none; }
  details.hdr1-mobile:not([open]) > summary .icon-close { display: none; }
  details.hdr1-mobile:not([open]) > div { display: none; }
  details.hdr1-mobile[open] .hdr1-panel { animation: hdr1-in var(--dur-base) var(--ease-brand) both; }
  @keyframes hdr1-in { from { transform: translateX(40px); opacity: 0; } to { transform: none; opacity: 1; } }
</style>

<script>
  let bound = false;
  function paint() {
    document.querySelector<HTMLElement>('[data-header]')?.classList.toggle('is-scrolled', window.scrollY > 8);
  }
  function bind() {
    paint();
    if (bound) return;
    bound = true;
    window.addEventListener('scroll', paint, { passive: true });
  }
  bind();
  document.addEventListener('astro:page-load', bind);
</script>
