---
/**
 * Schnecken Alt 1 „Die Spirale": rundes Schneckenfoto (echtes Foto), um das ein Satz aus dem
 * Karten-Intro im Kreis läuft (SVG textPath, dreht sich langsam — reduced-motion: steht still).
 * Rechts Titel, Intro und die drei Sorten mit Beschreibung. Daten: menu/schnecken.json.
 */
import { getEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import { getAlt, getImage } from '../../../lib/images';
import { safeWidths } from '../../../variants/a-krume/lib/picture';
import { btnSecondary, arrowIcon } from '../../../variants/a-krume/lib/ui';

const schnecken = await getEntry('menu', 'schnecken');
const img = getImage('a', 'hero-krume');
const ring = 'Sauerteig statt Hefeteig · dreimal gefüllt · jeden Morgen frisch gedreht · ';
---

{schnecken && (
  <section class="overflow-x-clip bg-bg py-14 md:py-24" aria-labelledby="sn-alt1-title">
    <div class="mx-auto max-w-[1440px] px-4 md:px-8">
      <div class="grid grid-cols-1 items-center gap-12 md:grid-cols-12 md:gap-8">
        <div class="relative mx-auto w-full max-w-[34rem] md:col-span-6 md:max-w-none md:pr-6" data-reveal>
          <div class="spirale relative aspect-square">
            <svg class="spirale__ring absolute inset-0 h-full w-full text-primary-deep" viewBox="0 0 400 400" aria-hidden="true">
              <defs>
                <path id="sn-alt1-circle" d="M200 200 m-178 0 a178 178 0 1 1 356 0 a178 178 0 1 1 -356 0" />
              </defs>
              <text class="font-mono" font-size="15.5" letter-spacing="3.2" fill="currentColor">
                <textPath href="#sn-alt1-circle" textLength="1110" lengthAdjust="spacing">{ring.toUpperCase()}</textPath>
              </text>
            </svg>
            <div class="absolute inset-[13%] overflow-hidden rounded-full bg-bg-alt ring-1 ring-ink/10">
              <Picture
                src={img}
                widths={safeWidths(img, [480, 800, img.width])}
                sizes="(min-width: 768px) 36vw, 74vw"
                formats={['avif', 'webp']}
                alt={getAlt('hero-krume')}
                loading="lazy"
                class="spirale__foto h-full w-full object-cover"
              />
            </div>
          </div>
        </div>

        <div class="md:col-span-6 md:col-start-7" data-reveal style="--reveal-delay:100ms">
          <p class="font-mono text-xs uppercase tracking-[0.25em] text-ink-soft">Die Signature</p>
          <span class="tz-rule mt-3" aria-hidden="true"></span>
          <h2 id="sn-alt1-title" class="mt-3 text-[clamp(2rem,4.2vw,3.5rem)] leading-[1.02]">{schnecken.data.title}</h2>
          <p class="prose-measure mt-4 text-lg text-ink-soft md:text-xl">{schnecken.data.intro}</p>

          <ol class="mt-8 flex flex-col gap-1" role="list">
            {schnecken.data.items.map((it, i) => (
              <li class="sorte group grid grid-cols-[2.75rem_1fr] gap-x-3 rounded-card py-3 pr-3 transition-colors duration-[var(--dur-fast)] hover:bg-bg-alt">
                <svg class="sorte__kringel size-11 text-primary" viewBox="0 0 44 44" aria-hidden="true">
                  <circle cx="22" cy="22" r="20" fill="none" stroke="currentColor" stroke-opacity="0.25" stroke-width="1.5" />
                  <text x="22" y="26.5" text-anchor="middle" class="font-mono" font-size="12" fill="currentColor">0{i + 1}</text>
                </svg>
                <div>
                  <h3 class="font-display text-2xl leading-tight">{it.name}</h3>
                  {it.description && <p class="mt-1 text-ink-soft">{it.description}</p>}
                </div>
              </li>
            ))}
          </ol>

          <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
            <a href="/karte/schnecken" class={btnSecondary}>
              Zur Signature-Seite
              <svg class={arrowIcon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </a>
            {schnecken.data.note && <p class="font-mono text-sm text-ink-soft">{schnecken.data.note}</p>}
          </div>
        </div>
      </div>
    </div>
  </section>
)}

<style>
  .spirale__ring {
    animation: sn-drehen 60s linear infinite;
    transform-origin: 50% 50%;
  }
  .spirale:hover .spirale__ring {
    animation-play-state: paused;
  }
  .spirale__foto {
    transition: transform var(--dur-slow) var(--ease-brand);
  }
  .spirale:hover .spirale__foto {
    transform: scale(1.06) rotate(-4deg);
  }
  @keyframes sn-drehen {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .spirale__ring {
      animation: none;
    }
  }
  .sorte__kringel {
    transition: transform var(--dur-base) var(--ease-brand);
  }
  .sorte:hover .sorte__kringel {
    transform: rotate(-20deg);
  }
</style>
