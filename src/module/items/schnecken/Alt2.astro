---
/**
 * Schnecken Alt 2 „Drei Füllungen, drei Farben": jede Sorte als eigene Farbkarte mit gezeichneter
 * Spirale (Pistazie = Dünengras, Lotus = Kruste, Haselnuss = Ofenschluss — alles A-Tokens).
 * Darunter Blechfoto + wie die Schnecken entstehen (Text von der Signature-Seite). Daten: menu/schnecken.json.
 */
import { getEntry } from 'astro:content';
import Figure from '../../../variants/a-krume/components/Figure.astro';
import { btnPrimary, arrowIcon } from '../../../variants/a-krume/lib/ui';
import { spiralPath } from './spiral';

const schnecken = await getEntry('menu', 'schnecken');
const TONES = [
  'bg-secondary-soft text-ink',
  'bg-primary text-bg',
  'bg-primary-deep text-bg',
];
const spiral = spiralPath(100, 100, 92, 3.4, 56, 3);
---

{schnecken && (
  <section class="bg-bg py-14 md:py-24" aria-labelledby="sn-alt2-title">
    <div class="mx-auto max-w-[1440px] px-4 md:px-8">
      <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-4" data-reveal>
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.25em] text-ink-soft">Die Signature</p>
          <h2 id="sn-alt2-title" class="mt-3 text-[clamp(2.2rem,5vw,3.75rem)] leading-[1.02]">{schnecken.data.title}</h2>
        </div>
        <p class="prose-measure max-w-md text-lg text-ink-soft">{schnecken.data.intro}</p>
      </div>

      <ul class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-3 md:mt-14 md:gap-6" role="list">
        {schnecken.data.items.map((it, i) => (
          <li
            class:list={['fuellung group relative flex min-h-[19rem] flex-col overflow-hidden rounded-card p-6 md:min-h-[26rem] md:p-8', TONES[i % TONES.length]]}
            data-reveal
            style={`--reveal-delay:${i * 100}ms`}
          >
            <svg class="fuellung__spirale pointer-events-none absolute -right-10 -top-10 size-56 opacity-35 md:size-72" viewBox="0 0 200 200" aria-hidden="true">
              <path d={spiral} fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round" />
            </svg>
            <p class="relative font-mono text-sm">0{i + 1}</p>
            <div class="relative mt-auto pt-16">
              <h3 class="font-display text-[clamp(2.25rem,4vw,3.25rem)] leading-none">{it.name}</h3>
              {it.description && <p class="mt-3 text-[1.05rem] leading-relaxed">{it.description}</p>}
              <p class="mt-4 border-t border-current/30 pt-3 font-mono text-xs uppercase tracking-widest">
                {it.vegan ? 'vegan' : it.veggie ? 'vegetarisch' : ''}{it.allergens.length > 0 && ` · enthält ${it.allergens.join(', ')}`}
              </p>
            </div>
          </li>
        ))}
      </ul>

      <div class="mt-12 grid grid-cols-1 items-center gap-8 md:mt-16 md:grid-cols-12 md:gap-10">
        <div class="md:col-span-5" data-reveal>
          <Figure motif="schnecke-blech" aspect="aspect-[4/3] md:aspect-[4/5]" sizes="(min-width: 768px) 38vw, 100vw" mat="flat" hover />
        </div>
        <div class="md:col-span-6 md:col-start-7" data-reveal style="--reveal-delay:100ms">
          <p class="font-mono text-xs uppercase tracking-[0.25em] text-ink-soft">So entstehen sie</p>
          <p class="mt-4 font-display text-[clamp(1.5rem,2.8vw,2.25rem)] leading-snug">
            Jeden Morgen von Hand gedreht: Creme verteilen, aufrollen, schneiden — dann geht das Blech in den Ofen,
            bis die Ränder karamellisieren.
          </p>
          {schnecken.data.note && <p class="mt-5 font-mono text-sm text-ink-soft">{schnecken.data.note}</p>}
          <a href="/karte/schnecken" class:list={[btnPrimary, 'mt-8']}>
            Zur Signature-Seite
            <svg class={arrowIcon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
        </div>
      </div>
    </div>
  </section>
)}

<style>
  .fuellung {
    transition: transform var(--dur-base) var(--ease-brand);
  }
  .fuellung:hover {
    transform: translateY(-4px);
  }
  .fuellung__spirale {
    transition: transform 900ms var(--ease-brand);
  }
  .fuellung:hover .fuellung__spirale {
    transform: rotate(-90deg);
  }
</style>
