---
/**
 * Alternative 1 „Rund & freundlich": vollrunde Pillen in der Textschrift (General Sans),
 * halbfett, etwas größer. Hover: hebt sich 2 px an, weicher Schatten. Hauptaktion in Kruste
 * statt Röstkern, damit die Pillen wärmer wirken. Alle Farben über die A-Tokens.
 */
import Tafel from './parts/Tafel.astro';
---

<Tafel
  eyebrow="Alternative 1"
  title="Rund & freundlich"
  lead="Vollrunde Pillen in der Textschrift, etwas größer und weicher. Beim Darüberfahren heben sie sich leicht an — wie ein Kissen, das man drückt."
  classes={{
    primary: 'bp bp-primary',
    accent: 'bp bp-accent',
    secondary: 'bp bp-secondary',
    ghost: 'bp bp-ghost',
    link: 'bp-link',
    linkArrow: 'bp-link bp-link--arrow',
    arrow: 'bp-arrow',
  }}
  hoverClass="is-hover"
/>

<style is:global>
  .bp {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: 9999px;
    padding: 0.75rem 1.6rem;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1.05rem;
    line-height: 1.2;
    letter-spacing: 0.005em;
    border: 2px solid transparent;
    transition:
      transform var(--dur-fast) var(--ease-brand),
      box-shadow var(--dur-fast) var(--ease-brand),
      background-color var(--dur-fast) var(--ease-brand),
      color var(--dur-fast) var(--ease-brand),
      border-color var(--dur-fast) var(--ease-brand);
  }
  .bp:hover,
  .bp:focus-visible,
  .bp.is-hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 22px -12px color-mix(in srgb, var(--color-ink) 55%, transparent);
  }
  .bp:active {
    transform: translateY(0);
    box-shadow: none;
  }

  .bp-primary { background: var(--color-primary); color: var(--color-paper); }
  .bp-primary:hover, .bp-primary:focus-visible, .bp-primary.is-hover { background: var(--color-primary-deep); }

  .bp-accent { background: var(--color-accent); color: var(--color-ink); }
  .bp-accent:hover, .bp-accent:focus-visible, .bp-accent.is-hover { background: var(--color-accent-ink); color: var(--color-paper); }

  .bp-secondary { background: transparent; color: var(--color-ink); border-color: var(--color-ink); }
  .bp-secondary:hover, .bp-secondary:focus-visible, .bp-secondary.is-hover { background: var(--color-ink); color: var(--color-bg); }

  .bp-ghost {
    min-height: 2.75rem;
    padding: 0.5rem 1.1rem;
    background: var(--color-bg-alt);
    color: var(--color-ink);
    font-weight: 500;
    font-size: 0.95rem;
  }
  .bp-ghost:hover, .bp-ghost:focus-visible, .bp-ghost.is-hover {
    background: var(--color-paper);
    border-color: var(--color-ink);
    transform: none;
    box-shadow: none;
  }

  /* Textlink: kräftige Unterstreichung, Pfeil im Kreis füllt sich beim Hover */
  .bp-link {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--color-primary-deep);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
    text-decoration-color: color-mix(in srgb, var(--color-primary) 40%, transparent);
    transition: color var(--dur-fast) var(--ease-brand), text-decoration-color var(--dur-fast) var(--ease-brand);
  }
  .bp-link:hover, .bp-link:focus-visible, .bp-link.is-hover { color: var(--color-ink); text-decoration-color: currentColor; }
  .bp-link--arrow { text-decoration: none; }
  .bp-arrow {
    box-sizing: content-box;
    width: 1rem;
    height: 1rem;
    padding: 0.35rem;
    border-radius: 9999px;
    border: 2px solid currentColor;
    transition: background-color var(--dur-fast) var(--ease-brand), color var(--dur-fast) var(--ease-brand), transform var(--dur-fast) var(--ease-brand);
  }
  .bp-link:hover .bp-arrow, .bp-link:focus-visible .bp-arrow, .bp-link.is-hover .bp-arrow {
    background: var(--color-ink);
    color: var(--color-bg);
    border-color: var(--color-ink);
    transform: translateX(3px);
  }
  /* Pfeil in Pillen: kein Kreis, nur Bewegung */
  .bp .bp-arrow { border: 0; padding: 0; width: 1.1rem; height: 1.1rem; }
  .bp:hover .bp-arrow, .bp.is-hover .bp-arrow { background: transparent; color: inherit; transform: translateX(3px); }
</style>
