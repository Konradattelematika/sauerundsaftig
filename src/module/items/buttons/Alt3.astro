---
/**
 * Alternative 3 „Theke & Fraunces": weiche Kissen-Form (Radius 1 rem), Beschriftung in der
 * Überschriften-Schrift Fraunces mit weichen Achsen. Zweitaktionen und Chips liegen auf der
 * echten Thekenoberfläche (Terrazzo, --tz-url) und kippen beim Hover ins Dunkle. Textlinks
 * kursiv mit welliger Sanddorn-Unterstreichung, die beim Hover fest wird.
 */
import Tafel from './parts/Tafel.astro';
---

<Tafel
  eyebrow="Alternative 3"
  title="Theke & Fraunces"
  lead="Weiche Kissen-Form mit Beschriftung in der Überschriften-Schrift. Nebenaktionen liegen auf der Thekenoberfläche und färben sich beim Darüberfahren dunkel."
  classes={{
    primary: 'bt bt-primary',
    accent: 'bt bt-accent',
    secondary: 'bt bt-secondary',
    ghost: 'bt bt-ghost',
    link: 'bt-link',
    linkArrow: 'bt-link',
    arrow: 'bt-arrow',
  }}
  hoverClass="is-hover"
/>

<style is:global>
  .bt {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    border-radius: 1rem;
    padding: 0.65rem 1.5rem;
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 70, 'WONK' 0, 'opsz' 18;
    font-weight: 500;
    font-size: 1.2rem;
    line-height: 1.1;
    letter-spacing: -0.005em;
    transition:
      background-color var(--dur-fast) var(--ease-brand),
      color var(--dur-fast) var(--ease-brand),
      transform var(--dur-fast) var(--ease-brand),
      box-shadow var(--dur-fast) var(--ease-brand);
  }
  .bt:hover, .bt:focus-visible, .bt.is-hover { transform: scale(1.02); }
  .bt:active { transform: scale(0.99); }

  .bt-primary { background: var(--color-primary-deep); color: var(--color-paper); }
  .bt-primary:hover, .bt-primary:focus-visible, .bt-primary.is-hover { background: var(--color-primary); }

  .bt-accent { background: var(--color-accent); color: var(--color-ink); }
  .bt-accent:hover, .bt-accent:focus-visible, .bt-accent.is-hover { background: var(--color-accent-ink); color: var(--color-paper); }

  /* Thekenoberfläche: Terrazzo mit Papier-Schleier, damit die Schrift sauber steht */
  .bt-secondary,
  .bt-ghost {
    color: var(--color-ink);
    background-color: var(--color-bg-alt);
    background-image:
      linear-gradient(color-mix(in srgb, var(--color-paper) 62%, transparent), color-mix(in srgb, var(--color-paper) 62%, transparent)),
      var(--tz-url);
    background-size: 520px auto, 520px auto;
    background-repeat: repeat;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-ink) 18%, transparent);
  }
  .bt-secondary:hover, .bt-secondary:focus-visible, .bt-secondary.is-hover,
  .bt-ghost:hover, .bt-ghost:focus-visible, .bt-ghost.is-hover {
    background-image: none;
    background-color: var(--color-ink);
    color: var(--color-bg);
    box-shadow: inset 0 0 0 1px var(--color-ink);
  }
  .bt-ghost {
    min-height: 2.75rem;
    padding: 0.45rem 1.1rem;
    font-size: 1.05rem;
    border-radius: 0.75rem;
  }
  .bt-ghost:hover, .bt-ghost.is-hover { transform: none; }

  /* Textlink: Fraunces kursiv, wellige Sanddorn-Linie wird beim Hover fest */
  .bt-link {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 70, 'WONK' 1, 'opsz' 18;
    font-style: italic;
    font-size: 1.25rem;
    color: var(--color-primary-deep);
    text-decoration: underline;
    text-decoration-style: wavy;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 5px;
    text-decoration-color: color-mix(in srgb, var(--color-accent) 75%, transparent);
    transition: color var(--dur-fast) var(--ease-brand), text-decoration-color var(--dur-fast) var(--ease-brand);
  }
  .bt-link:hover, .bt-link:focus-visible, .bt-link.is-hover {
    color: var(--color-ink);
    text-decoration-style: solid;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--color-accent);
  }
  .bt-arrow { width: 1.1rem; height: 1.1rem; flex-shrink: 0; transition: transform var(--dur-fast) var(--ease-brand); }
  .bt-link:hover .bt-arrow, .bt-link.is-hover .bt-arrow, .bt:hover .bt-arrow, .bt.is-hover .bt-arrow { transform: translateX(3px); }
</style>
