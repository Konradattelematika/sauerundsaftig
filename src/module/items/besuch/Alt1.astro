---
/**
 * Besuch Alt 1 „Wochenstreifen": die sieben Tage als Streifen nebeneinander (Ruhetage in Terrazzo,
 * der heutige Tag wird im Browser in Europe/Berlin markiert), darunter Telefon/Reservierung,
 * Adresse/Route und die Hinweise mit Symbolen. Daten: site.json + lib/opening-hours.
 */
import site from '../../../data/site.json';
import OpeningStatus from '../../../components/shared/OpeningStatus.astro';
import { btnPrimary, btnSecondary } from '../../../variants/a-krume/lib/ui';
import Icon from './Icon.astro';
import { week, WEEK_KEYS, phoneHref, route, RESERVIEREN, HINTS, ICON_PHONE, ICON_PIN, ICON_SUNRISE, breakfastUntil } from './data';

const days = week.map((d, i) => {
  const [open, close] = d.hours === 'Ruhetag' ? [] : d.hours.replace(' Uhr', '').split('–');
  return { ...d, key: WEEK_KEYS[i], open, close };
});
---

<section class="bg-bg-alt py-14 md:py-24" aria-labelledby="bs-alt1-title">
  <div class="mx-auto max-w-[1440px] px-4 md:px-8">
    <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-4" data-reveal>
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.25em] text-ink-soft">Besuch</p>
        <span class="tz-rule mt-3" aria-hidden="true"></span>
        <h2 id="bs-alt1-title" class="mt-3 text-[clamp(2rem,4.5vw,3.25rem)] leading-[1.05]">Deine Woche bei uns</h2>
      </div>
      <OpeningStatus size="lg" />
    </div>

    <ol class="woche mt-8 grid grid-cols-7 gap-1.5 md:mt-12 md:gap-3" role="list" aria-label="Öffnungszeiten der Woche" data-woche>
      {days.map((d) => (
        <li
          class:list={['tag relative flex min-h-[9.5rem] flex-col items-center rounded-card px-1 pb-3 pt-3 text-center md:min-h-[13rem] md:px-3 md:pt-5', d.open ? 'bg-paper' : 'tag--ruhe tz-surface tz-surface--fine']}
          data-day={d.key}
        >
          <span class="tag__heute font-mono text-[10px] uppercase tracking-widest md:text-xs" aria-hidden="true">Heute</span>
          <span class="font-display text-2xl leading-none md:text-4xl" aria-hidden="true">{d.short}</span>
          <span class="sr-only">{d.day}{' '}</span>
          {d.open ? (
            <span class="mt-auto flex flex-col items-center font-mono text-[11px] leading-tight tabular sm:text-sm md:text-lg">
              <span>{d.open}</span>
              <span class="my-1 h-5 w-px bg-current opacity-40 md:h-8" aria-hidden="true"></span>
              <span class="sr-only">bis</span>
              <span>{d.close}</span>
            </span>
          ) : (
            <span class="tag__ruhe mt-auto rounded-[2px] bg-paper/85 px-1 py-2 font-mono text-[11px] uppercase tracking-widest text-closed md:text-sm">Ruhetag</span>
          )}
        </li>
      ))}
    </ol>

    <div class="mt-10 grid grid-cols-1 gap-10 md:mt-14 md:grid-cols-3 md:gap-8">
      <div data-reveal>
        <p class="flex items-center gap-2 font-mono text-xs uppercase tracking-[0.2em] text-ink-soft">
          <Icon svg={ICON_PHONE} class="size-4" /> Tisch reservieren
        </p>
        <p class="mt-3 text-lg">{RESERVIEREN}</p>
        <a href={phoneHref} class:list={[btnPrimary, 'mt-4 px-5 text-xl md:text-2xl']}>{site.phoneDisplay}</a>
      </div>
      <div data-reveal style="--reveal-delay:100ms">
        <p class="flex items-center gap-2 font-mono text-xs uppercase tracking-[0.2em] text-ink-soft">
          <Icon svg={ICON_PIN} class="size-4" /> So findest du uns
        </p>
        <address class="mt-3 text-lg not-italic">
          {site.address.street}<br />{site.address.zip} {site.address.city}
        </address>
        <div class="mt-4 flex flex-wrap gap-3">
          <a href={route} target="_blank" rel="noopener" class={btnSecondary}>Route planen</a>
          <a href="/besuch" class={btnSecondary}>Alle Infos</a>
        </div>
      </div>
      <div data-reveal style="--reveal-delay:200ms">
        <p class="flex items-center gap-2 font-mono text-xs uppercase tracking-[0.2em] text-ink-soft">
          <Icon svg={ICON_SUNRISE} class="size-4" /> Gut zu wissen
        </p>
        <ul class="mt-3 flex flex-col gap-3" role="list">
          <li class="flex items-start gap-3 text-lg">
            <span class="grid size-10 shrink-0 place-items-center rounded-full bg-paper text-primary-deep"><Icon svg={ICON_SUNRISE} /></span>
            <span class="pt-1.5">Frühstück gibt’s bis {breakfastUntil} Uhr.</span>
          </li>
          {HINTS.map((h) => (
            <li class="flex items-start gap-3 text-lg">
              <span class="grid size-10 shrink-0 place-items-center rounded-full bg-paper text-primary-deep"><Icon svg={h.icon} /></span>
              <span class="pt-1.5">{h.text}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .tag {
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-ink) 8%, transparent);
    transition: transform var(--dur-fast) var(--ease-brand);
  }
  .tag__heute {
    visibility: hidden;
    min-height: 1.4em;
  }
  .tag[data-today] {
    background: var(--color-ink);
    color: var(--color-bg);
    transform: translateY(-6px);
  }
  .tag[data-today] .tag__heute {
    visibility: visible;
  }
  .tag--ruhe[data-today] .tag__ruhe {
    background: var(--color-paper);
  }
  /* Ruhetag: Terrazzo mit Papierschleier (wie .tz-tag), damit das Tageskürzel lesbar bleibt */
  .tag--ruhe {
    color: var(--color-ink);
    background-image:
      linear-gradient(color-mix(in srgb, var(--color-paper) 58%, transparent), color-mix(in srgb, var(--color-paper) 58%, transparent)),
      var(--tz-url);
    background-size: auto, 520px auto;
  }
  /* Ruhetag hochkant, damit er auch in der schmalen Mobil-Spalte passt */
  @media (max-width: 639px) {
    .tag__ruhe {
      writing-mode: vertical-rl;
      transform: rotate(180deg);
      padding: 0.5rem 0.2rem;
    }
  }
</style>

<script>
  import { berlinParts } from '../../../lib/opening-hours';

  function markToday() {
    const { weekday } = berlinParts(new Date());
    document.querySelectorAll<HTMLElement>('[data-woche] [data-day]').forEach((el) => {
      const isToday = el.dataset.day === weekday;
      el.toggleAttribute('data-today', isToday);
      if (isToday) el.setAttribute('aria-current', 'date');
      else el.removeAttribute('aria-current');
    });
  }
  markToday();
  document.addEventListener('astro:page-load', markToday);
</script>
