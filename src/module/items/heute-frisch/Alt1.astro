---
/**
 * Heute frisch Alt 1 „Kreidetafel": dunkle Tafel (Röstkern) im Holzrahmen (Kruste/Ofenschluss), kleine
 * runde Fotos, Namen kursiv in Fraunces, Kreidestriche als gestrichelte Linien. Vergriffenes wird
 * durchgestrichen wie mit Kreide. Daten: heuteFrisch-Collection.
 */
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import { formatDate } from '../../../lib/format';
import { getAlt, getImage } from '../../../lib/images';
import { safeWidths } from '../../../variants/a-krume/lib/picture';
import { arrowIcon } from '../../../variants/a-krume/lib/ui';

const entries = await getCollection('heuteFrisch');
const today = entries[0];
const items = (today?.data.items ?? []).map((item) => {
  const img = item.motif ? getImage('a', item.motif) : undefined;
  return { ...item, img, widths: img ? safeWidths(img, [160, 320]) : [] };
});
const dateLabel = today ? formatDate(today.data.date, { weekday: 'long', year: undefined }) : '';
---

{today && (
  <section class="bg-bg-alt py-14 md:py-24" aria-labelledby="hf-alt1-title">
    <div class="mx-auto max-w-[1440px] px-4 md:px-8">
      <div class="tafel-rahmen mx-auto max-w-5xl rounded-card p-3 md:p-5" data-reveal>
        <div class="tafel relative overflow-hidden rounded-[3px] bg-ink px-5 py-8 text-bg sm:px-8 md:px-14 md:py-14">
          <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-2">
            <h2 id="hf-alt1-title" class="kreide-titel text-[clamp(2.4rem,6vw,4.25rem)] leading-none">Heute frisch</h2>
            <p class="font-mono text-sm uppercase tracking-widest text-bg/80">{dateLabel}</p>
          </div>
          <svg class="mt-3 h-3 w-48 text-bg/70 md:w-64" viewBox="0 0 260 12" fill="none" aria-hidden="true">
            <path d="M2 8c40-5 80-6 120-3s90 3 136-2" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
          </svg>

          <ul class="mt-8 grid grid-cols-1 gap-x-12 sm:grid-cols-2 md:mt-10" role="list">
            {items.map((item, i) => (
              <li
                class="kreide-zeile group flex items-center gap-4 py-4 md:gap-5 md:py-5"
                data-reveal
                style={`--reveal-delay:${(i % 2) * 100}ms`}
              >
                {item.img && (
                  <span class="block size-16 shrink-0 overflow-hidden rounded-full ring-2 ring-bg/70 ring-offset-2 ring-offset-ink md:size-20">
                    <Picture
                      src={item.img}
                      widths={item.widths}
                      sizes="80px"
                      formats={['avif', 'webp']}
                      alt={getAlt(item.motif!)}
                      loading="lazy"
                      class:list={['h-full w-full object-cover transition-transform duration-[var(--dur-slow)] ease-[var(--ease-brand)] group-hover:scale-110', item.soldOut && 'grayscale']}
                    />
                  </span>
                )}
                <span class="min-w-0 flex-1">
                  <span class:list={['kreide-name block text-2xl leading-tight md:text-[1.75rem]', item.soldOut && 'kreide-durch']}>
                    {item.name}
                  </span>
                  {item.note && <span class="mt-1 block font-mono text-sm leading-snug text-bg/80">{item.note}</span>}
                  {item.soldOut && <span class="mt-1 block font-mono text-xs uppercase tracking-widest text-bg">Leider schon vergriffen</span>}
                </span>
              </li>
            ))}
          </ul>

          <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
            <p class="font-mono text-sm text-bg/80">Solange der Vorrat reicht — was weg ist, ist weg.</p>
            <a href="/karte" class="link-ul link-ul--light inline-flex min-h-11 items-center gap-2 font-mono text-sm text-bg">
              Ganze Karte ansehen
              <svg class={arrowIcon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
)}

<style>
  /* Holzrahmen aus den Kruste-Tönen, leicht gemasert */
  .tafel-rahmen {
    background:
      repeating-linear-gradient(
        92deg,
        color-mix(in srgb, var(--color-primary-deep) 30%, transparent) 0 2px,
        transparent 2px 9px
      ),
      linear-gradient(135deg, var(--color-primary), var(--color-primary-deep));
    box-shadow: 0 24px 50px -30px color-mix(in srgb, var(--color-ink) 70%, transparent);
  }
  /* Kreidestaub: zwei weiche Schleier auf der Tafel */
  .tafel::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(60% 40% at 15% 20%, color-mix(in srgb, var(--color-bg) 7%, transparent), transparent 70%),
      radial-gradient(50% 50% at 85% 85%, color-mix(in srgb, var(--color-bg) 5%, transparent), transparent 70%);
  }
  .kreide-titel,
  .kreide-name {
    font-family: var(--font-display);
    font-style: italic;
    font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 48;
    letter-spacing: -0.01em;
  }
  .kreide-zeile {
    border-bottom: 2px dashed color-mix(in srgb, var(--color-bg) 22%, transparent);
  }
  /* Kreidestrich durchs Vergriffene */
  .kreide-durch {
    text-decoration: line-through;
    text-decoration-thickness: 3px;
    text-decoration-color: color-mix(in srgb, var(--color-bg) 85%, transparent);
  }
</style>
