---
/**
 * Gästestimmen Alt 3 „Gastraum mit Siegel": echtes Foto des Gastraums, darauf ein rundes
 * Terrazzo-Siegel mit der Google-Note (Umschrift per SVG-textPath). Rechts die Zitate wie in einer
 * Zeitschrift, durch Linien getrennt. Platzhalter-Zitate bleiben wie in Live sichtbar markiert.
 */
import Figure from '../../../variants/a-krume/components/Figure.astro';
import Stars from './Stars.astro';
import { rating, googleHref, getTestimonials, PLACEHOLDER_LABEL } from './data';
import { linkArrow, arrowIcon } from '../../../variants/a-krume/lib/ui';

const testimonials = await getTestimonials();
const umschrift = `${rating.count} ${rating.source}-Bewertungen · ${rating.count} ${rating.source}-Bewertungen · `.toUpperCase();
---

<section class="bg-bg py-14 md:py-24" aria-labelledby="st-alt3-title">
  <div class="mx-auto max-w-[1440px] px-4 md:px-8">
    <div class="grid grid-cols-1 items-center gap-14 md:grid-cols-12 md:gap-8">
      <div class="relative md:col-span-5" data-reveal>
        <Figure motif="gastraum" aspect="aspect-[4/5]" sizes="(min-width: 768px) 40vw, 92vw" hover class="mr-10 md:mr-14" />

        <div class="siegel absolute -bottom-8 right-0 size-40 md:-bottom-10 md:size-48" role="img" aria-label={`Note ${rating.display} von 5 aus ${rating.count} ${rating.source}-Bewertungen`}>
          <span class="tz-surface absolute inset-0 rounded-full" style="--tz-pos: 30% 70%" aria-hidden="true"></span>
          <svg class="siegel__ring absolute inset-0 h-full w-full text-ink" viewBox="0 0 200 200" aria-hidden="true">
            <defs>
              <path id="st-alt3-ring" d="M100 100 m-80 0 a80 80 0 1 1 160 0 a80 80 0 1 1 -160 0" />
            </defs>
            <text class="font-mono" font-size="12.5" letter-spacing="1.5" fill="currentColor">
              <textPath href="#st-alt3-ring" textLength="500" lengthAdjust="spacing">{umschrift}</textPath>
            </text>
          </svg>
          <span class="absolute inset-[23%] grid place-items-center rounded-full bg-paper text-center shadow-[inset_0_0_0_1px_var(--color-bg-alt)]" aria-hidden="true">
            <span>
              <span class="block font-display text-[2.4rem] leading-none md:text-5xl">{rating.display}</span>
              <Stars fill={rating.fill} class="mt-1.5 h-3.5 md:h-4" />
            </span>
          </span>
        </div>
      </div>

      <div class="md:col-span-6 md:col-start-7" data-reveal style="--reveal-delay:100ms">
        <p class="font-mono text-xs uppercase tracking-[0.25em] text-ink-soft">Was Gäste sagen</p>
        <span class="tz-rule mt-3" aria-hidden="true"></span>
        <h2 id="st-alt3-title" class="mt-3 text-[clamp(2rem,4.5vw,3.25rem)] leading-[1.05]">
          {rating.display} von 5, sagen {rating.count} Gäste bei {rating.source}
        </h2>

        <ul class="mt-8 flex flex-col" role="list">
          {testimonials.map((t) => (
            <li class="border-t border-ink/15 py-7 last:border-b">
              <figure class="m-0 grid grid-cols-[auto_1fr] gap-x-5">
                <span class="font-display text-6xl leading-[0.7] text-primary" aria-hidden="true">“</span>
                <div>
                  {t.isPlaceholder && (
                    <p class="mb-3 font-mono text-[11px] uppercase tracking-widest text-ink-soft">{PLACEHOLDER_LABEL}</p>
                  )}
                  <blockquote class:list={['font-display text-xl italic leading-snug md:text-2xl', t.isPlaceholder && 'text-ink-soft']}>{t.quote}</blockquote>
                  <figcaption class="mt-3 font-mono text-sm uppercase tracking-widest text-ink-soft">{t.author}</figcaption>
                </div>
              </figure>
            </li>
          ))}
        </ul>

        <a href={googleHref} target="_blank" rel="noopener" class:list={[linkArrow, 'mt-6']}>
          Alle Bewertungen auf {rating.source}
          <svg class={arrowIcon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .siegel {
    transform: rotate(-8deg);
    filter: drop-shadow(0 12px 18px color-mix(in srgb, var(--color-ink) 30%, transparent));
    transition: transform var(--dur-slow) var(--ease-brand);
  }
  .siegel:hover {
    transform: rotate(12deg) scale(1.03);
  }
  .siegel__ring text {
    paint-order: stroke;
    stroke: color-mix(in srgb, var(--color-paper) 85%, transparent);
    stroke-width: 3px;
  }
</style>
