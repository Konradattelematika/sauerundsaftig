---
/** Kurzer Beispiel-Abschnitt über der Fußzeile, damit der Übergang sichtbar ist. */
import site from '../../../../data/site.json';
---

<main class="bg-bg">
  <section class="mx-auto max-w-[1440px] px-4 pb-14 pt-10 md:px-8 md:pb-20 md:pt-14">
    <p class="font-mono text-[11px] uppercase tracking-widest text-ink-soft">Letzter Abschnitt der Seite — darunter die Fußzeile</p>
    <h2 class="mt-6 text-[clamp(2rem,5vw,3.25rem)]">Fast alles bei uns beginnt mit Sauerteig.</h2>
    <p class="prose-measure mt-4 text-lg text-ink-soft">{site.subline}</p>
  </section>
</main>
