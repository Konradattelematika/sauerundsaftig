---
/** Zeitstrahl Alt 2 „Spur zum Wischen": horizontale Scroll-Snap-Karten nach Tageszeit. */
import { STAGES, parseRange, spokenTime } from './stages';

const cards = STAGES.map((stage, index) => {
  const minute = parseRange(stage.time).start;
  const tone = minute >= 21 * 60 || minute < 6 * 60 ? 'nacht' : minute < 9 * 60 ? 'morgen' : 'tag';
  return { ...stage, tone, number: String(index + 1).padStart(2, '0') };
});
---

<section class="bg-bg py-14 md:py-24" aria-labelledby="zeit-alt2-title">
  <div class="mx-auto max-w-[1440px] px-4 md:px-8">
    <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
      <div class="max-w-3xl">
        <p><span class="tz-tag">18 Stunden Sauerteig</span></p>
        <h2 id="zeit-alt2-title" class="mt-4 text-[clamp(2.25rem,5vw,3.75rem)] leading-[1.02]">Vom Nachmittag in den Morgen</h2>
        <p class="prose-measure mt-4 text-lg text-ink-soft">Wisch Schritt für Schritt durch die Backstube. Blau markiert die Nacht, Sanddorn den neuen Morgen.</p>
      </div>
      <p class="font-mono text-xs uppercase tracking-widest text-ink-soft">Wischen für mehr →</p>
    </div>
  </div>

  <div class="spur mt-10 overflow-x-auto md:mt-14" data-reveal style="--reveal-delay:120ms">
    <ol class="spur-track" role="list">
      {cards.map((stage) => (
        <li class:list={['spur-karte', `spur-karte--${stage.tone}`]}>
          <div class="flex items-center justify-between gap-4">
            <span class="font-mono text-xs uppercase tracking-[0.2em] opacity-70">Schritt {stage.number}</span>
            <span class="spur-punkt" aria-hidden="true"></span>
          </div>
          <p class="mt-10 font-mono text-lg uppercase tracking-widest" aria-label={spokenTime(stage.time)}>{stage.time}</p>
          <h3 class="mt-3 text-3xl leading-tight">{stage.title}</h3>
          <p class="mt-4 leading-relaxed opacity-80">{stage.text}</p>
        </li>
      ))}
      <li class="spur-ende tz-surface" aria-label="Nach 18 Stunden: bereit für die Theke">
        <p class="font-mono text-xs uppercase tracking-[0.2em]">Das Ergebnis</p>
        <p class="mt-3 font-display text-5xl">18 h</p>
        <p class="mt-3 text-lg">Vom ersten Handgriff bis zum ersten Schnitt.</p>
      </li>
    </ol>
  </div>
</section>

<style>
  .spur { scroll-snap-type: x mandatory; scroll-padding-inline: max(1rem, calc((100vw - 1440px) / 2 + 2rem)); scrollbar-width: thin; }
  .spur-track { display: flex; align-items: stretch; gap: 1rem; width: max-content; padding: 0.25rem max(1rem, calc((100vw - 1440px) / 2 + 2rem)) 1.25rem; }
  .spur-karte,
  .spur-ende { width: min(82vw, 340px); min-height: 390px; flex: 0 0 auto; scroll-snap-align: start; border-radius: var(--radius-card); padding: 1.4rem; }
  .spur-karte { position: relative; border: 1px solid color-mix(in srgb, var(--color-ink) 14%, transparent); background: var(--color-paper); color: var(--color-ink); }
  .spur-karte::after { content: ''; position: absolute; left: 1.4rem; right: -1.05rem; top: 3.7rem; height: 2px; background: currentColor; opacity: 0.18; }
  .spur-punkt { position: relative; z-index: 1; display: block; width: 0.8rem; height: 0.8rem; border-radius: 999px; background: currentColor; box-shadow: 0 0 0 5px var(--color-paper); }
  .spur-karte--nacht { background: var(--color-secondary); color: white; }
  .spur-karte--nacht .spur-punkt { box-shadow: 0 0 0 5px var(--color-secondary); }
  .spur-karte--morgen { border-top: 8px solid var(--color-accent); }
  .spur-ende { display: grid; align-content: center; background-color: #b9b6ad; background-image: var(--tz-url); background-size: 620px auto; color: var(--color-ink); }
  @media (min-width: 768px) {
    .spur-track { gap: 1.25rem; }
    .spur-karte, .spur-ende { width: 360px; min-height: 420px; padding: 1.7rem; }
    .spur-karte::after { left: 1.7rem; right: -1.3rem; }
  }
</style>
