---
/** Live: die echte Liste src/variants/a-krume/components/MenuItemsList.astro mit echten Einträgen. */
import MenuItemsList from '../../../variants/a-krume/components/MenuItemsList.astro';
import Rahmen from './parts/Rahmen.astro';
import { previewSections } from './parts/items';

const sections = await previewSections();
---

<Rahmen
  eyebrow="Live-Version"
  title="Liste mit Punktlinie"
  lead="Name links, Preis rechts, dazwischen eine gepunktete Linie. Beschreibung und Allergene darunter, Veggie und Signature als kleine Marken. Sechs echte Einträge aus Frühstück und Kuchen."
>
  <div class="flex flex-col gap-12">
    {sections.map((s, i) => (
      <section class="grid grid-cols-1 gap-6 md:grid-cols-12 md:gap-10">
        <div class="md:col-span-4">
          <p class="font-mono text-xs uppercase tracking-[0.25em] text-ink-soft">0{i + 1} · Sektion</p>
          <h2 class="mt-3 text-[clamp(1.75rem,4vw,2.5rem)]">{s.title}</h2>
          <p class="prose-measure mt-3 text-ink-soft">{s.intro}</p>
        </div>
        <div class="md:col-span-8">
          <MenuItemsList items={s.items} />
        </div>
      </section>
    ))}
  </div>
</Rahmen>
