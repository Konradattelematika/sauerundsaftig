---
/** Generische Sektion „Zeitstrahl" (s. definition.mjs) — Markup 1:1 aus /sauerteig übernommen. */
import Timeline from '../../../variants/a-krume/components/Timeline.astro';
import { editSection } from '../../index';
import type { Section } from '../../types';

interface Stage {
  time: string;
  title: string;
  text: string;
}
interface Props {
  section: Section<{ stages: Stage[] }>;
}
const { section } = Astro.props;
const f = section.fields;
---

<section class="bg-bg-alt py-14 md:py-24" {...editSection(section)}>
  <div class="mx-auto max-w-[1440px] px-4 md:px-8">
    <Timeline stages={f.stages ?? []} />
  </div>
</section>
