---
/** /gastgeber „Warum das hilft" (s. definition.mjs). Markup 1:1 aus gastgeber.astro. */
import { editAttrs, editSection } from '../../index';
import type { Section } from '../../types';

interface Props {
  section: Section<{ eyebrow: string; title: string; text: string }>;
}
const { section } = Astro.props;
const f = section.fields;
---

<section class="bg-bg py-14 md:py-24" {...editSection(section)}>
  <div class="mx-auto max-w-[1440px] px-4 md:px-8">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-12">
      <div class="md:col-span-6" data-reveal>
        <p class="font-mono text-xs uppercase tracking-widest text-ink-soft" {...editAttrs(section, 'eyebrow')}>{f.eyebrow}</p>
        <h2 class="mt-3 text-[clamp(2rem,4vw,2.75rem)]" {...editAttrs(section, 'title')}>{f.title}</h2>
      </div>
      <div class="md:col-span-6" data-reveal style="--reveal-delay:100ms">
        <p class="prose-measure text-lg text-ink-soft" {...editAttrs(section, 'text')}>{f.text}</p>
      </div>
    </div>
  </div>
</section>
