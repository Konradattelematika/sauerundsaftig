---
/** /ueber-mich „Und dann war da plötzlich diese Urkunde" (s. definition.mjs). Markup 1:1 aus ueber-mich.astro. */
import { editAttrs, editSection, rich } from '../../index';
import type { Section } from '../../types';

interface Props {
  section: Section<{
    year: string;
    title: string;
    text: string;
    cardLabel: string;
    cardTitleLine1: string;
    cardTitleLine2: string;
    cardRegion: string;
    cardSource: string;
  }>;
}
const { section } = Astro.props;
const f = section.fields;
---

<section class="bg-bg py-14 md:py-24" {...editSection(section)}>
  <div class="mx-auto max-w-[1440px] px-4 md:px-8">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-12 md:items-center">
      <div class="md:col-span-7" data-reveal>
        <p class="font-mono text-xs uppercase tracking-[0.25em] text-ink-soft" {...editAttrs(section, 'year')}>{f.year}</p>
        <h2 class="mt-4 text-[clamp(2.25rem,5.5vw,4.25rem)]" {...editAttrs(section, 'title')}>{f.title}</h2>
        <p
          class="prose-measure mt-6 text-lg text-ink-soft md:text-xl"
          {...editAttrs(section, 'text', 'rich')}
          set:html={rich(f.text, { linkClass: 'link-ul text-ink' })}
        />
      </div>
      <div class="md:col-span-4 md:col-start-9" data-reveal style="--reveal-delay:100ms">
        <div class="tz-mat max-w-sm">
          <div class="bg-paper px-6 py-8 text-center md:px-8 md:py-10">
            <p class="font-mono text-[11px] uppercase tracking-[0.3em] text-ink-soft" {...editAttrs(section, 'cardLabel')}>{f.cardLabel}</p>
            <p class="mt-4 font-display text-3xl leading-tight md:text-4xl">
              <span {...editAttrs(section, 'cardTitleLine1')}>{f.cardTitleLine1}</span><br /><span {...editAttrs(section, 'cardTitleLine2')}>{f.cardTitleLine2}</span>
            </p>
            <p class="mt-3 font-mono text-sm uppercase tracking-widest text-ink-soft" {...editAttrs(section, 'cardRegion')}>{f.cardRegion}</p>
            <p class="mt-2 font-mono text-[11px] uppercase tracking-widest text-ink-soft/80" {...editAttrs(section, 'cardSource')}>{f.cardSource}</p>
            <span class="tz-rule mx-auto mt-6" aria-hidden="true"></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
