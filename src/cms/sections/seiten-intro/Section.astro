---
/** Generische Sektion „Seiten-Intro" (s. definition.mjs) — Markup 1:1 aus /vorbestellen, /shop. */
import SectionIntro from '../../../variants/a-krume/components/SectionIntro.astro';
import { editSection } from '../../index';
import type { Section } from '../../types';

interface Props {
  section: Section<{ eyebrow?: string; title: string; intro?: string; background?: 'bg' | 'bg-alt' }>;
}
const { section } = Astro.props;
const f = section.fields;
---

<section class:list={[f.background === 'bg-alt' ? 'bg-bg-alt' : 'bg-bg', 'py-14 md:py-24']} {...editSection(section)}>
  <div class="mx-auto max-w-[1440px] px-4 md:px-8">
    <SectionIntro
      as="h1"
      size="lg"
      eyebrow={f.eyebrow || undefined}
      title={f.title}
      intro={f.intro || undefined}
      rule
      cms={{ section, eyebrow: 'eyebrow', title: 'title', intro: 'intro' }}
    />
  </div>
</section>
