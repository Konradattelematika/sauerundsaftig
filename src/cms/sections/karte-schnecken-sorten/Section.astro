---
/**
 * Sektion „Karte-Schnecken-Sorten" (s. definition.mjs) — Markup 1:1 aus src/pages/karte/schnecken.astro
 * (die drei Sorten-Blöcke plus die zwei Prozess-Absätze dazwischen). Die drei Layouts unterscheiden
 * sich bewusst (Bildposition, Versatz, Textausrichtung) — das ist fester Teil des Signature-Designs,
 * nicht editierbar; nur Bild/Name/Beschreibung/Preis kommen aus den Feldern.
 */
import Figure from '../../../variants/a-krume/components/Figure.astro';
import { formatMenuPrice } from '../../../lib/format';
import { editAttrs, editSection, media } from '../../index';
import type { MediaRef, Section } from '../../types';

interface Item {
  media: MediaRef;
  name: string;
  description?: string;
  price?: number;
  priceIsPlaceholder?: boolean;
}
interface Props {
  section: Section<{ items: Item[]; textAfterFirst?: string; textAfterSecond?: string }>;
}
const { section } = Astro.props;
const f = section.fields;
const [pistazie, lotus, haselnuss] = f.items;
const badge = (i: number, name: string) => `0${i + 1} · ${name}`;
---

<section class="bg-bg-alt py-14 md:py-24" {...editSection(section)}>
  <div class="mx-auto max-w-[1440px] px-4 md:px-8">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-12 md:items-center">
      <div class="md:col-span-7" data-reveal>
        <Figure
          motif={media(pistazie.media)!.id}
          alt={media(pistazie.media)!.alt}
          aspect="aspect-[4/5]"
          sizes="(min-width: 768px) 55vw, 100vw"
          loading="eager"
          fetchpriority="high"
          mat="offset"
          hover
        />
      </div>
      <div class="relative z-10 md:col-span-4 md:col-start-8 md:-ml-16 md:mt-16" data-reveal style="--reveal-delay:100ms">
        <div class="rounded-card bg-paper p-6 md:p-8 md:shadow-[0_1px_0_0_rgba(36,27,20,0.08)]">
          <p class="font-mono text-xs uppercase tracking-widest text-ink-soft">{badge(0, pistazie.name)}</p>
          <h2 class="mt-2 text-3xl" {...editAttrs(section, 'items.0.name')}>{pistazie.name}</h2>
          <p class="prose-measure mt-3 text-ink-soft" {...editAttrs(section, 'items.0.description')}>{pistazie.description}</p>
          <p class="mt-4 font-mono text-base tabular">{formatMenuPrice(pistazie.price, pistazie.priceIsPlaceholder ?? true)}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="bg-bg py-14 md:py-20">
  <div class="mx-auto max-w-[1440px] px-4 md:px-8">
    <p class="prose-measure font-display text-2xl md:text-3xl" data-reveal {...editAttrs(section, 'textAfterFirst')}>
      {f.textAfterFirst}
    </p>
  </div>
</section>

<section class="bg-bg-alt py-14 md:py-24">
  <div class="mx-auto max-w-[1440px] px-4 md:px-8">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-12 md:items-center">
      <div class="md:order-2 md:col-span-7" data-reveal>
        <Figure motif={media(lotus.media)!.id} alt={media(lotus.media)!.alt} aspect="aspect-[4/5]" sizes="(min-width: 768px) 55vw, 100vw" hover />
      </div>
      <div class="md:order-1 md:col-span-4 md:col-start-1 md:mt-16 md:mr-[-4rem]" data-reveal style="--reveal-delay:100ms">
        <div class="rounded-card bg-paper p-6 text-right md:p-8">
          <p class="font-mono text-xs uppercase tracking-widest text-ink-soft">{badge(1, lotus.name)}</p>
          <h2 class="mt-2 text-3xl" {...editAttrs(section, 'items.1.name')}>{lotus.name}</h2>
          <p class="prose-measure ml-auto mt-3 text-ink-soft" {...editAttrs(section, 'items.1.description')}>{lotus.description}</p>
          <p class="mt-4 font-mono text-base tabular">{formatMenuPrice(lotus.price, lotus.priceIsPlaceholder ?? true)}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="bg-bg py-14 md:py-20">
  <div class="mx-auto max-w-[1440px] px-4 md:px-8">
    <p class="prose-measure font-display text-2xl md:text-3xl" data-reveal {...editAttrs(section, 'textAfterSecond')}>
      {f.textAfterSecond}
    </p>
  </div>
</section>

<section class="bg-bg-alt py-14 md:py-24">
  <div class="mx-auto max-w-[1440px] px-4 md:px-8">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-12 md:items-center">
      <div class="md:col-span-7" data-reveal>
        <Figure motif={media(haselnuss.media)!.id} alt={media(haselnuss.media)!.alt} aspect="aspect-[4/5]" sizes="(min-width: 768px) 55vw, 100vw" />
      </div>
      <div class="relative z-10 md:col-span-4 md:col-start-8 md:-ml-16 md:mt-16" data-reveal style="--reveal-delay:100ms">
        <div class="rounded-card bg-paper p-6 md:p-8">
          <p class="font-mono text-xs uppercase tracking-widest text-ink-soft">{badge(2, haselnuss.name)}</p>
          <h2 class="mt-2 text-3xl" {...editAttrs(section, 'items.2.name')}>{haselnuss.name}</h2>
          <p class="prose-measure mt-3 text-ink-soft" {...editAttrs(section, 'items.2.description')}>{haselnuss.description}</p>
          <p class="mt-4 font-mono text-base tabular">{formatMenuPrice(haselnuss.price, haselnuss.priceIsPlaceholder ?? true)}</p>
        </div>
      </div>
    </div>
  </div>
</section>
