---
/** Sektion „Shop-In-Planung" (s. definition.mjs) — Markup 1:1 aus src/pages/shop.astro. */
import SectionIntro from '../../../variants/a-krume/components/SectionIntro.astro';
import { editAttrs, editSection } from '../../index';
import type { Section } from '../../types';

interface Item {
  title: string;
  text?: string;
}
interface Props {
  section: Section<{ eyebrow?: string; title: string; badgeLabel?: string; items: Item[] }>;
}
const { section } = Astro.props;
const f = section.fields;
---

<section class="bg-bg-alt py-14 md:py-24" {...editSection(section)}>
  <div class="mx-auto max-w-[1440px] px-4 md:px-8">
    <SectionIntro
      eyebrow={f.eyebrow || undefined}
      title={f.title}
      class="mb-10 md:mb-14"
      cms={{ section, eyebrow: 'eyebrow', title: 'title' }}
    />
    <div class="grid grid-cols-1 gap-8 border-t border-ink/10 pt-8 md:grid-cols-3 md:gap-10">
      {f.items.map((item, i) => (
        <div data-reveal style={`--reveal-delay:${(i % 3) * 100}ms`}>
          <p class="font-mono text-xs uppercase tracking-widest text-ink-soft" {...editAttrs(section, 'badgeLabel')}>{f.badgeLabel}</p>
          <h2 class="mt-2 text-2xl" {...editAttrs(section, `items.${i}.title`)}>{item.title}</h2>
          <p class="prose-measure mt-3 text-ink-soft" {...editAttrs(section, `items.${i}.text`)}>{item.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
