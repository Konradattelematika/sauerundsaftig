---
/**
 * Sektion „cover" (s. definition.mjs) — Markup 1:1 aus der bisherigen Startseite (Magazin-Cover):
 * links H1+Subline+Status+CTAs, rechts hochformatiges Bild im versetzten Terrazzo-Passepartout.
 */
import Figure from '../../../variants/a-krume/components/Figure.astro';
import OpeningStatus from '../../../components/shared/OpeningStatus.astro';
import Button from './Button.astro';
import { editAttrs, editSection, media, shown, tokens } from '../../index';
import type { LinkValue, MediaRef, Section } from '../../types';

interface Fields {
  eyebrow?: string;
  title: string;
  subline?: string;
  showOpeningStatus?: boolean;
  buttons?: { link: LinkValue; icon?: '' | 'arrow' | 'external' }[];
  image?: MediaRef | null;
  caption?: string;
  captionAside?: string;
  band?: boolean;
}
interface Props {
  section: Section<Fields>;
}
const { section } = Astro.props;
const f = section.fields;
const img = media(f.image);
const buttons = (f.buttons ?? []).map((b, i) => ({ ...b, i })).filter((b) => shown(b.link));
const caption = f.caption?.trim() || img?.alt || '';
const aside = tokens(f.captionAside);
---

<section class="bg-bg pb-14 pt-8 md:pb-24 md:pt-14" {...editSection(section)}>
  <div class="mx-auto max-w-[1440px] px-4 md:px-8">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-12 md:items-center md:gap-6">
      <div class="order-2 md:order-1 md:col-span-5">
        {f.eyebrow && <p data-reveal><span class="tz-tag" {...editAttrs(section, 'eyebrow')}>{tokens(f.eyebrow)}</span></p>}
        <h1 class="mt-5 text-[clamp(2.5rem,7vw,4.75rem)] leading-[1.05]" data-reveal style="--reveal-delay:100ms" {...editAttrs(section, 'title')}>
          {f.title}
        </h1>
        {f.subline && (
          <p class="prose-measure mt-5 text-lg text-ink-soft md:text-xl" data-reveal style="--reveal-delay:200ms" {...editAttrs(section, 'subline')}>
            {tokens(f.subline)}
          </p>
        )}
        {f.showOpeningStatus && (
          <div class="mt-6" data-reveal style="--reveal-delay:200ms">
            <OpeningStatus size="lg" />
          </div>
        )}
        {buttons.length > 0 && (
          <div class="mt-8 flex flex-wrap gap-4" data-reveal style="--reveal-delay:200ms">
            {buttons.map((b) => (
              <Button link={b.link} icon={b.icon} attrs={editAttrs(section, `buttons.${b.i}.link`, 'link')} />
            ))}
          </div>
        )}
      </div>

      {img && (
        <div class="order-1 md:order-2 md:col-span-7 md:pl-6">
          <div class="hero-zoom-frame tz-offset">
            <div class="overflow-hidden rounded-card bg-bg-alt" {...editAttrs(section, 'image', 'media')}>
              <Figure
                motif={img.id}
                alt={img.alt}
                aspect="aspect-[4/5] md:aspect-[3/4]"
                sizes="(min-width: 768px) 55vw, 100vw"
                loading="eager"
                fetchpriority="high"
                imgClass="hero-zoom-img h-full w-full object-cover"
              />
            </div>
          </div>
          {(caption || aside) && (
            <p class="mt-4 flex items-center justify-between gap-4 font-mono text-[12px] uppercase tracking-widest text-ink-soft md:mt-6">
              <span {...editAttrs(section, 'caption')}>{caption}</span>
              {aside && <span class="hidden shrink-0 sm:inline" {...editAttrs(section, 'captionAside')}>{aside}</span>}
            </p>
          )}
        </div>
      )}
    </div>
  </div>
</section>

{f.band && <span class="tz-band" aria-hidden="true"></span>}

<style>
  .hero-zoom-frame {
    display: block;
  }
  :global(.hero-zoom-img) {
    animation: hero-zoom 1200ms var(--ease-brand) both;
    transform-origin: center;
  }
  @keyframes hero-zoom {
    from {
      transform: scale(1.04);
    }
    to {
      transform: scale(1);
    }
  }
</style>
