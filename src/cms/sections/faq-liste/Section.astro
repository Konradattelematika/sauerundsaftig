---
/**
 * Generische Sektion „FAQ-Liste" (s. definition.mjs) — Markup 1:1 aus /faq übernommen.
 * Fragen/Antworten kommen aus collections.faq (visible-Filter, Reihenfolge = Sammlung).
 * `todoKunde` ist kein eigenes Feld im SiteDoc (types.ts gehört dem Orchestrator) — hier als
 * lokale Erweiterung des FaqItem-Typs gelesen, ohne types.ts anzufassen.
 */
import SectionIntro from '../../../variants/a-krume/components/SectionIntro.astro';
import { cms, editSection, rich } from '../../index';
import type { FaqItem, Section } from '../../types';

interface Props {
  section: Section<{ eyebrow?: string; title: string; intro?: string }>;
}
const { section } = Astro.props;
const f = section.fields;

type FaqItemWithBadge = FaqItem & { todoKunde?: string };
const entries = (cms().collections.faq as FaqItemWithBadge[]).filter((e) => e.visible);
---

<section class="bg-bg py-14 md:py-24" {...editSection(section)}>
  <div class="mx-auto max-w-[1440px] px-4 md:px-8">
    <SectionIntro
      as="h1"
      size="lg"
      eyebrow={f.eyebrow || undefined}
      title={f.title}
      intro={f.intro || undefined}
      rule
      class="mb-10 md:mb-14"
      cms={{ section, eyebrow: 'eyebrow', title: 'title', intro: 'intro' }}
    />

    <div class="mx-auto max-w-3xl divide-y divide-ink/10 border-t border-ink/10">
      {entries.map((entry, i) => (
        <details class="faq-item group py-2" data-reveal style={`--reveal-delay:${(i % 4) * 100}ms`}>
          <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 py-4 text-lg md:text-xl">
            <span class="flex flex-wrap items-center gap-3">
              {entry.question}
              {entry.todoKunde && (
                <span class="rounded-full border border-accent-ink/40 px-2 py-0.5 font-mono text-[11px] uppercase tracking-wide text-accent-ink">
                  folgt
                </span>
              )}
            </span>
            <span class="faq-icon shrink-0 font-mono text-2xl text-ink-soft" aria-hidden="true">+</span>
          </summary>
          <div class="prose-measure pb-5 text-ink-soft" set:html={rich(entry.answer, { blocks: true })} />
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
  }
  .faq-icon {
    transition: transform var(--dur-fast) var(--ease-brand);
  }
</style>
