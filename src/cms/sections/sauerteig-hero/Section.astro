---
/** Sektion „Sauerteig-Hero" (s. definition.mjs) — Markup 1:1 aus src/pages/sauerteig/index.astro. */
import SectionIntro from '../../../variants/a-krume/components/SectionIntro.astro';
import { editSection } from '../../index';
import type { Section } from '../../types';

interface Stat {
  label: string;
  value: number;
}
interface Props {
  section: Section<{ eyebrow?: string; title: string; intro?: string; stats: Stat[] }>;
}
const { section } = Astro.props;
const f = section.fields;
---

<section class="bg-bg py-14 md:py-24" {...editSection(section)}>
  <div class="mx-auto max-w-[1440px] px-4 md:px-8">
    <SectionIntro
      as="h1"
      size="lg"
      eyebrow={f.eyebrow || undefined}
      title={f.title}
      intro={f.intro || undefined}
      rule
      cms={{ section, eyebrow: 'eyebrow', title: 'title', intro: 'intro' }}
    />

    <dl class="mt-10 grid grid-cols-3 gap-4 border-t border-ink/10 pt-8 md:mt-16 md:gap-8" data-reveal style="--reveal-delay:100ms">
      {f.stats.map((s, i) => (
        <div>
          <dt class="font-mono text-xs uppercase tracking-widest text-ink-soft">{s.label}</dt>
          <dd class="mt-1 font-display text-4xl md:text-5xl">
            <span data-countup={s.value}>{s.value}</span>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>
