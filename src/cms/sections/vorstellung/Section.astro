---
/**
 * Sektion „vorstellung" (s. definition.mjs) — Markup 1:1 aus dem Josie-Teaser der bisherigen Startseite:
 * Porträt im versetzten Passepartout, typografischer Gruß, Textlink.
 */
import Figure from '../../../variants/a-krume/components/Figure.astro';
import Button from '../cover/Button.astro';
import { editAttrs, editSection, media, rich, shown } from '../../index';
import { hasPhoto } from '../../../lib/images';
import type { LinkValue, MediaRef, Section } from '../../types';

interface Fields {
  image?: MediaRef | null;
  placeholderNote?: string;
  eyebrow?: string;
  title: string;
  text?: string;
  link?: LinkValue;
  background?: 'bg' | 'bg-alt';
}
interface Props {
  section: Section<Fields>;
}
const { section } = Astro.props;
const f = section.fields;
const img = media(f.image);
const isPlaceholder = img ? !hasPhoto(img.id) : false;
---

<section class:list={[f.background === 'bg' ? 'bg-bg' : 'bg-bg-alt', 'py-14 md:py-24']} {...editSection(section)}>
  <div class="mx-auto max-w-[1440px] px-4 md:px-8">
    <div class="grid grid-cols-1 items-center gap-10 md:grid-cols-12">
      {img && (
        <div class="md:col-span-4 md:col-start-2" {...editAttrs(section, 'image', 'media')}>
          <Figure
            motif={img.id}
            alt={img.alt}
            aspect="aspect-[4/5]"
            sizes="(min-width: 1024px) 30vw, (min-width: 768px) 40vw, 80vw"
            mat="offset-left"
            reveal
            revealKind="image"
            hover
            class="max-w-[420px]"
          />
          {isPlaceholder && f.placeholderNote && (
            <p class="mt-3 font-mono text-[11px] uppercase tracking-widest text-ink-soft" {...editAttrs(section, 'placeholderNote')}>{f.placeholderNote}</p>
          )}
        </div>
      )}
      <div class="md:col-span-6 md:col-start-7" data-reveal style="--reveal-delay:100ms">
        {f.eyebrow && <p class="font-mono text-xs uppercase tracking-[0.25em] text-ink-soft" {...editAttrs(section, 'eyebrow')}>{f.eyebrow}</p>}
        <span class="tz-rule mt-3" aria-hidden="true"></span>
        <h2 class="mt-4 text-[clamp(2.25rem,5.5vw,4rem)]" {...editAttrs(section, 'title')}>{f.title}</h2>
        {f.text && (
          <p class="prose-measure mt-5 text-lg text-ink-soft md:text-xl" {...editAttrs(section, 'text', 'rich')} set:html={rich(f.text, { linkClass: 'link-ul text-ink' })} />
        )}
        {f.link && shown(f.link) && (
          <Button link={f.link} variant="link" icon="arrow" class="mt-6" attrs={editAttrs(section, 'link', 'link')} />
        )}
      </div>
    </div>
  </div>
</section>
