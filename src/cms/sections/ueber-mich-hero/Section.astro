---
/** /ueber-mich Hero (s. definition.mjs). Markup 1:1 aus ueber-mich.astro (inkl. Terrazzo-Band danach). */
import Figure from '../../../variants/a-krume/components/Figure.astro';
import { hasPhoto } from '../../../lib/images';
import { editAttrs, editSection, media } from '../../index';
import type { Section } from '../../types';

interface Props {
  section: Section<{
    tag: string;
    line1: string;
    line2: string;
    name: string;
    lead: string;
    image: string | { media: string; alt?: string };
    captionLabel: string;
  }>;
}
const { section } = Astro.props;
const f = section.fields;
const img = media(f.image);
const portraitIsPlaceholder = !img || !hasPhoto(img.id);
---

<section class="about-hero overflow-x-clip bg-bg pb-14 pt-10 md:pb-24 md:pt-14" {...editSection(section)}>
  <div class="mx-auto max-w-[1440px] px-4 md:px-8">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-12 md:gap-x-6">
      <div class="flex flex-col md:col-span-5 md:min-h-full">
        <p data-reveal><span class="tz-tag" {...editAttrs(section, 'tag')}>{f.tag}</span></p>
        <h1 class="about-title mt-6 text-[clamp(3.25rem,8.5vw,8.5rem)] leading-[0.9] md:mt-8" data-reveal style="--reveal-delay:100ms">
          <span {...editAttrs(section, 'line1')}>{f.line1}</span><br /><span {...editAttrs(section, 'line2')}>{f.line2}</span><br /><span class="tz-text" {...editAttrs(section, 'name')}>{f.name}</span>
        </h1>
        <p class="prose-measure mt-8 text-lg text-ink-soft md:mt-auto md:pt-10 md:text-xl" data-reveal style="--reveal-delay:200ms" {...editAttrs(section, 'lead')}>
          {f.lead}
        </p>
      </div>
      <div class="md:col-span-7 md:pl-6 lg:col-span-6 lg:col-start-7 lg:pl-0">
        <div data-parallax="0.04" {...editAttrs(section, 'image', 'media')}>
          {img && (
            <Figure
              motif={img.id}
              alt={img.alt}
              aspect="aspect-[4/5]"
              sizes="(min-width: 1440px) 680px, (min-width: 768px) 55vw, 100vw"
              loading="eager"
              fetchpriority="high"
              mat="offset"
              reveal
              revealKind="image"
              class="about-portrait"
            />
          )}
        </div>
        <p class="mt-4 flex flex-wrap items-center justify-between gap-x-6 gap-y-1 font-mono text-[12px] uppercase tracking-widest text-ink-soft md:mt-6">
          <span {...editAttrs(section, 'captionLabel')}>{f.captionLabel}</span>
          {portraitIsPlaceholder && <span>Platzhalter — Porträt folgt</span>}
        </p>
      </div>
    </div>
  </div>
</section>

<span class="tz-band" aria-hidden="true"></span>

<style>
  /* Headline-Stapel: keine automatische Silbentrennung im Namen, Zeilen sind manuell gesetzt */
  .about-title {
    hyphens: manual;
    -webkit-hyphens: manual;
  }
</style>
