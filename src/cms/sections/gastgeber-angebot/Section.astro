---
/** /gastgeber „Das Angebot" (s. definition.mjs). Markup 1:1 aus gastgeber.astro. */
import Figure from '../../../variants/a-krume/components/Figure.astro';
import { editAttrs, editSection, media } from '../../index';
import type { Section } from '../../types';

interface Item {
  title: string;
  text: string;
}
interface Props {
  section: Section<{ label: string; items: Item[]; note: string; image: string | { media: string; alt?: string } }>;
}
const { section } = Astro.props;
const f = section.fields;
const img = media(f.image);
---

<section class="bg-bg-alt py-14 md:py-24" {...editSection(section)}>
  <div class="mx-auto max-w-[1440px] px-4 md:px-8">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-12">
      <div class="md:col-span-7">
        <p class="font-mono text-xs uppercase tracking-widest text-ink-soft" data-reveal {...editAttrs(section, 'label')}>{f.label}</p>
        <div class="mt-6 grid grid-cols-1 gap-8 sm:grid-cols-2">
          {f.items.map((item, i) => (
            <div class="rounded-card border border-ink/10 bg-paper p-6" data-reveal style={`--reveal-delay:${(i % 2) * 100}ms`}>
              <h2 class="text-xl" {...editAttrs(section, `items.${i}.title`)}>{item.title}</h2>
              <p class="prose-measure mt-2 text-ink-soft" {...editAttrs(section, `items.${i}.text`)}>{item.text}</p>
            </div>
          ))}
        </div>
        <p class="prose-measure mt-6 font-mono text-sm text-ink-soft" {...editAttrs(section, 'note')}>{f.note}</p>
      </div>
      <div class="md:col-span-5" data-reveal style="--reveal-delay:100ms" {...editAttrs(section, 'image', 'media')}>
        {img && <Figure motif={img.id} alt={img.alt} aspect="aspect-[4/5]" sizes="(min-width: 768px) 35vw, 100vw" mat="flat" hover />}
      </div>
    </div>
  </div>
</section>
