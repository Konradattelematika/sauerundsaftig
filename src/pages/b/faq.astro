---
/**
 * /faq — Fragen aus der Collection als natives <details>-Accordion,
 * ruhige Serif-Fragen (VARIANT-BRIEF Routen: „<details>-Accordion (nativ, kein JS nötig)").
 * FAQPage-JSON-LD über faqPage() aus lib/schema-org.ts.
 */
import { getCollection } from 'astro:content';
import Layout from '../../variants/b-salzhaff/Layout.astro';
import SectionLabel from '../../variants/b-salzhaff/components/SectionLabel.astro';
import { telHref } from '../../lib/format';
import site from '../../data/site.json';
import { faqPage, breadcrumbs } from '../../lib/schema-org';

const base = '/b';
const entries = (await getCollection('faq')).sort((a, b) => a.data.order - b.data.order);

/** Antworten sind reine Prosa (keine Markdown-Auszeichnung) — Absätze als <p> für die JSON-LD-Antwort. */
function toAnswerHtml(body: string): string {
  return body
    .trim()
    .split(/\n{2,}/)
    .map((p) => `<p>${p.trim()}</p>`)
    .join('');
}

const jsonLd = [
  faqPage(entries.map((e) => ({ question: e.data.question, answerHtml: toAnswerHtml(e.body ?? '') }))),
  breadcrumbs([
    { name: 'Start', url: `${Astro.site}${base}` },
    { name: 'FAQ', url: `${Astro.site}${base}/faq` },
  ]),
];
---

<Layout
  title="Fragen und Antworten — Sauer & Saftig"
  description="Häufige Fragen zu Öffnungszeiten, Reservierung, Karte und mehr — kurz beantwortet."
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-[1440px] px-4 pt-10 md:px-8 md:pt-16">
    <p class="font-mono text-[15px] uppercase tracking-widest text-ink-soft">Fragen</p>
    <h1 class="mt-4 font-display text-[clamp(2.6rem,7vw,5.5rem)] leading-[0.98]">Was du wissen willst</h1>
    <p class="mt-6 max-w-[60ch] text-xl text-ink-soft">
      Alles, was uns immer wieder gefragt wird. Fehlt etwas? Ruf uns an unter{' '}
      <a href={telHref(site.phone)} class="text-ink underline decoration-ink/30 underline-offset-4 hover:decoration-ink">{site.phoneDisplay}</a>.
    </p>
  </section>

  <section class="mx-auto max-w-[900px] px-4 py-16 md:px-8 md:py-24">
    <SectionLabel number="01" label="Fragen & Antworten" />
    <div class="mt-8">
      {entries.map((entry, i) => (
        <div class="border-t border-ink/20 py-2 last:border-b" data-reveal style={`--reveal-delay: ${Math.min(i, 8) * 50}ms`}>
          <details class="group py-4">
            <summary class="flex min-h-[44px] cursor-pointer list-none items-center justify-between gap-6 py-2">
              <span class="font-display text-2xl leading-snug text-ink md:text-3xl">{entry.data.question}</span>
              <span class="shrink-0 font-mono text-2xl text-ink-soft transition-transform duration-[var(--dur-fast)] ease-[var(--ease-brand)] group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <div class="mt-2 max-w-[64ch] pb-2 pl-0 text-xl text-ink-soft">
              <Fragment set:html={toAnswerHtml(entry.body ?? '')} />
              {entry.data.todoKunde && (
                <p class="mt-3 font-mono text-[15px] text-ink-soft">
                  folgt — {entry.data.todoKunde}
                </p>
              )}
            </div>
          </details>
        </div>
      ))}
    </div>
  </section>
</Layout>
