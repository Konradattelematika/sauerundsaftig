---
/**
 * /404 — Variantencharakter B „Salzhaff" (VARIANT-BRIEF Routen §/404): sehr ruhig,
 * große Serif-Zeile, Mono-Zeile "404", Links zu Karte und Startseite.
 * Astro emittiert diese Datei wegen des Ordnerpfads als /b/404/index.html
 * (nicht als Sonderfall /404.html) — passend zu deploy/nginx.conf.
 */
import Layout from '../../variants/b-salzhaff/Layout.astro';
import { btnPrimary, linkArrow, linkArrowIcon } from '../../variants/b-salzhaff/lib/ui';

const base = '/b';
---

<Layout title="Nicht gefunden — Sauer & Saftig" description="Diese Seite gibt es nicht." noindex>
  <section class="mx-auto flex min-h-[60vh] max-w-[1440px] flex-col justify-center px-4 py-20 md:px-8">
    <p class="font-mono text-[15px] uppercase tracking-widest text-ink-soft">404</p>
    <h1 class="mt-4 font-display text-[clamp(2.8rem,9vw,6.5rem)] leading-[0.98]">Nichts. Nur Luft.</h1>
    <p class="mt-6 max-w-[52ch] text-xl text-ink-soft">
      Diese Seite ist nicht da — vielleicht war sie es nie. Weiter geht es hier.
    </p>
    <div class="mt-10 flex flex-wrap items-center gap-6">
      <a href={`${base}/karte`} class={btnPrimary}>
        Zur Karte
      </a>
      <a href={base} class={linkArrow}>
        Zur Startseite
        <span class={linkArrowIcon} aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Layout>
