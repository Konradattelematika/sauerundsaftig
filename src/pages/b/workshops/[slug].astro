---
/**
 * /workshops/[slug] — Einzelkurs mit WorkshopBooking-Island (VARIANT-BRIEF §4.8,
 * getStaticPaths über die workshops-Collection).
 */
import { getCollection, render } from 'astro:content';
import Layout from '../../../variants/b-salzhaff/Layout.astro';
import WorkshopBooking from '../../../components/shared/WorkshopBooking.astro';
import MaskImage from '../../../variants/b-salzhaff/components/MaskImage.astro';
import SectionLabel from '../../../variants/b-salzhaff/components/SectionLabel.astro';
import { breadcrumbs, workshopEvent } from '../../../lib/schema-org';
import { linkBack } from '../../../variants/b-salzhaff/lib/ui';

export async function getStaticPaths() {
  const entries = await getCollection('workshops');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { title, subtitle, duration, price, isDraft, level, capacity, includes, dates } = entry.data;
const { Content } = await render(entry);
const base = '/b';
const next = dates[0];

const jsonLd = [
  breadcrumbs([
    { name: 'Start', url: `${Astro.site}${base}` },
    { name: 'Workshops', url: `${Astro.site}${base}/workshops` },
    { name: title, url: `${Astro.site}${base}/workshops/${entry.id}` },
  ]),
  ...(next
    ? [
        workshopEvent({
          title,
          subtitle,
          price,
          isDraft,
          date: next.date,
          time: next.time,
          duration,
          url: `${Astro.site}${base}/workshops/${entry.id}`,
        }),
      ]
    : []),
];
---

<Layout title={`${title} — Workshop — Sauer & Saftig`} description={subtitle} jsonLd={jsonLd}>
  <section class="mx-auto max-w-[1440px] px-4 pt-10 md:px-8 md:pt-16">
    <a href={`${base}/workshops`} class={linkBack}>
      ← Alle Workshops
    </a>
    <p class="mt-6 font-mono text-[15px] uppercase tracking-widest text-ink-soft">{level}</p>
    <h1 class="mt-4 font-display text-[clamp(2.4rem,6vw,5rem)] leading-[0.98]">{title}</h1>
    <p class="mt-6 max-w-[60ch] text-xl text-ink-soft">{subtitle}</p>
  </section>

  <section class="mt-12 md:mt-16">
    <MaskImage motif={entry.data.motif} class="aspect-[16/9] w-full" />
  </section>

  <div class="mx-auto grid max-w-[1440px] grid-cols-1 gap-16 px-4 py-16 md:grid-cols-[1.3fr_1fr] md:gap-20 md:px-8 md:py-24">
    <div>
      <SectionLabel number="01" label="Ablauf" />
      <div class="prose-measure mt-8 flex flex-col gap-5 text-ink">
        <Content />
      </div>

      <SectionLabel number="02" label="Inklusive" class="mt-14" />
      <ul class="mt-8 flex flex-col gap-1">
        {includes.map((inc: string) => (
          <li class="flex min-h-[44px] items-center border-t border-ink/20 py-3 last:border-b">{inc}</li>
        ))}
      </ul>
    </div>

    <div>
      <WorkshopBooking title={title} price={price} isDraft={isDraft} duration={duration} capacity={capacity} dates={dates} />
    </div>
  </div>
</Layout>
