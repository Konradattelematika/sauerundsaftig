---
/**
 * /besuch — wichtigste Seite für Persona 62+: Öffnungszeiten sehr groß,
 * Telefon riesig, Anfahrt/Parken/Barrierefreiheit vorsichtig formuliert.
 * Anfahrts-Richtungen bewusst nur als grobe Himmelsrichtung — nichts Genaues erfunden.
 */
import Layout from '../../variants/a-krume/Layout.astro';
import Breadcrumbs from '../../variants/a-krume/components/Breadcrumbs.astro';
import ClickToLoadMap from '../../components/shared/ClickToLoadMap.astro';
import OpeningStatus from '../../components/shared/OpeningStatus.astro';
import site from '../../data/site.json';
import { weekOverview, type Schedule } from '../../lib/opening-hours';
import { telHref, routeHref } from '../../lib/format';
import { localBusiness } from '../../lib/schema-org';
import { btnSecondary } from '../../variants/a-krume/lib/ui';

const base = '/a';
// site.json wird als generisches JSON typisiert (string[][] statt Tupel) — Cast wie in lib/schema-org.ts.
const week = weekOverview(site.openingHours as unknown as Schedule);
const phoneHref = telHref(site.phone);
const route = routeHref(site.address.street, site.address.zip, site.address.city);
const jsonLd = [localBusiness(String(Astro.site))];
---

<Layout
  title="Besuch — Öffnungszeiten, Anfahrt, Telefon | Sauer & Saftig"
  description="Öffnungszeiten, Adresse und Anreise nach Rerik, Dünenstraße 1. Reservierung nur telefonisch."
  jsonLd={jsonLd}
>
  <Breadcrumbs items={[{ label: 'Start', href: base }, { label: 'Besuch', href: `${base}/besuch` }]} />

  <section class="bg-bg py-14 md:py-24">
    <div class="mx-auto max-w-[1440px] px-4 md:px-8">
      <p class="font-mono text-xs uppercase tracking-[0.25em] text-ink-soft" data-reveal>Besuch</p>
      <span class="tz-rule mt-3" aria-hidden="true"></span>
      <h1 class="mt-4 text-[clamp(2.5rem,6vw,4.5rem)]" data-reveal style="--reveal-delay:100ms">
        Dünenstraße 1, Ostseebad Rerik
      </h1>
      <div class="mt-6" data-reveal style="--reveal-delay:200ms">
        <OpeningStatus size="lg" />
      </div>
      <p class="prose-measure mt-4 text-lg text-ink-soft" data-reveal style="--reveal-delay:200ms">
        Dienstag und Mittwoch backen wir nicht — plan deinen Besuch drumherum. Donnerstag bis Montag sind wir da.
      </p>
      <a
        href={phoneHref}
        class="mt-8 inline-flex min-h-11 items-center justify-center rounded-card bg-ink px-6 py-4 font-mono text-3xl text-bg transition-colors duration-[var(--dur-fast)] ease-[var(--ease-brand)] hover:bg-primary-deep md:text-4xl"
        data-reveal
        style="--reveal-delay:300ms"
      >
        {site.phoneDisplay}
      </a>
    </div>
  </section>

  <!-- Öffnungszeiten, sehr groß -->
  <section class="bg-bg-alt py-14 md:py-24">
    <div class="mx-auto max-w-[1440px] px-4 md:px-8">
      <p class="font-mono text-xs uppercase tracking-widest text-ink-soft" data-reveal>Öffnungszeiten</p>
      <table class="mt-6 w-full max-w-3xl border-collapse font-mono text-2xl md:text-3xl" data-reveal style="--reveal-delay:100ms">
        <caption class="sr-only">Wochenübersicht Öffnungszeiten</caption>
        <tbody>
          {week.map((d) => (
            <tr class="border-b border-ink/10">
              <th scope="row" class="py-4 pr-4 text-left font-normal text-ink-soft">{d.day}</th>
              <td class:list={['py-4 text-right tabular', d.hours === 'Ruhetag' && 'text-closed']}>{d.hours}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="prose-measure mt-6 text-lg text-ink-soft" data-reveal style="--reveal-delay:200ms">
        Zu Feiertagen wie Heiligabend und dem 1. Weihnachtstag bleibt bei uns geschlossen. Verlässlich ist immer
        der Stand hier auf der Website, nicht unbedingt Google oder Instagram.
      </p>
      <div class="mt-6 max-w-xl rounded-card border border-ink/15 bg-paper p-6" data-reveal style="--reveal-delay:200ms">
        <p class="font-mono text-xs uppercase tracking-widest text-ink-soft">Too Good To Go</p>
        <p class="mt-2 text-xl">
          Überraschungstüte, rund {site.tooGoodToGo.bagValue} € Warenwert für {site.tooGoodToGo.bagPrice} €.
        </p>
        <p class="mt-1 text-ink-soft">Verfügbarkeit und Abholzeit siehst du direkt in der App.</p>
      </div>
    </div>
  </section>

  <!-- Anfahrt -->
  <section class="bg-bg py-14 md:py-24">
    <div class="mx-auto max-w-[1440px] px-4 md:px-8">
      <p class="font-mono text-xs uppercase tracking-widest text-ink-soft" data-reveal>Anfahrt</p>
      <div class="mt-6" data-reveal style="--reveal-delay:100ms">
        <ClickToLoadMap />
      </div>
      <div class="prose-measure mt-6 text-lg text-ink-soft" data-reveal style="--reveal-delay:200ms">
        <p>
          Rerik liegt an der Ostseeküste zwischen Wismar und Kühlungsborn. Aus Richtung Kühlungsborn kommst du aus
          östlicher Richtung, aus Richtung Bad Doberan aus südlicher Richtung, aus Richtung Wismar aus westlicher
          Richtung — die Dünenstraße liegt nah an der Küste.
        </p>
        {/* TODO(kunde): genaue Wegbeschreibung/Beschilderung ab den Nachbarorten bestätigen, bevor wir konkreter werden. */}
        <p class="mt-3 font-mono text-sm">Am sichersten: kurz anrufen, wenn du dir bei der Anfahrt unsicher bist.</p>
      </div>
      <a href={route} target="_blank" rel="noopener" class:list={[btnSecondary, 'mt-6']}>
        Route in Maps starten
      </a>
    </div>
  </section>

  <!-- Vor Ort: Parken, Barrierefreiheit, Hunde, Reservierung, Zahlungsmittel -->
  <section class="bg-bg-alt py-14 md:py-24">
    <div class="mx-auto max-w-[1440px] px-4 md:px-8">
      <p class="font-mono text-xs uppercase tracking-widest text-ink-soft" data-reveal>Vor Ort</p>
      <div class="mt-8 grid grid-cols-1 gap-10 md:grid-cols-3">
        <div data-reveal>
          <h2 class="text-xl">Parken</h2>
          <p class="prose-measure mt-2 text-ink-soft">
            Parkmöglichkeiten in der Nähe haben wir noch nicht abschließend bestätigt. Ruf uns kurz an unter{' '}
            <a href={phoneHref} class="link-ul text-ink">{site.phoneDisplay}</a>,
            dann sagen wir dir, wo du am besten stehst.
          </p>
          {/* TODO(kunde): Parksituation Dünenstraße 1 bestätigen. */}
        </div>
        <div data-reveal style="--reveal-delay:100ms">
          <h2 class="text-xl">Barrierefreiheit</h2>
          <p class="prose-measure mt-2 text-ink-soft">
            Ob Café und Zugang barrierefrei sind, klären wir aktuell noch. Ruf am sichersten kurz vorher an, dann
            sagen wir dir genau, was vor Ort geht.
          </p>
          {/* TODO(kunde): Barrierefreiheit (Stufen, Türbreite, WC) prüfen und hier konkret ergänzen. */}
        </div>
        <div data-reveal style="--reveal-delay:200ms">
          <h2 class="text-xl">Hunde</h2>
          <p class="prose-measure mt-2 text-ink-soft">
            Das prüfen wir gerade noch. Ruf am besten kurz an, bevor du mit Hund bei uns vorbeikommst.
          </p>
          {/* TODO(kunde): Hunde-Regelung bestätigen. */}
        </div>
      </div>
      <div class="mt-10 grid grid-cols-1 gap-10 border-t border-ink/10 pt-8 md:grid-cols-3">
        <div data-reveal>
          <h2 class="text-xl">Reservierung</h2>
          <p class="prose-measure mt-2 text-ink-soft">
            Reservierungen laufen ausschließlich telefonisch — ruf uns unter{' '}
            <a href={phoneHref} class="link-ul text-ink">{site.phoneDisplay}</a>{' '}
            an und frag nach einem Tisch für deinen Termin.
          </p>
        </div>
        <div class="md:col-span-2" data-reveal style="--reveal-delay:100ms">
          <h2 class="text-xl">Zahlungsmittel</h2>
          <p class="prose-measure mt-2 text-ink-soft">
            Ob und mit welcher Karte du bei uns zahlen kannst, können wir dir gerade noch nicht mit Sicherheit
            sagen. Ruf am besten kurz an unter{' '}
            <a href={phoneHref} class="link-ul text-ink">{site.phoneDisplay}</a>,
            dann sagen wir dir aktuell, welche Zahlungsmittel bei uns gehen.
          </p>
          {/* TODO(kunde): Zahlungsmittel final bestätigen (site.json → paymentTodoKunde). */}
        </div>
      </div>
    </div>
  </section>
</Layout>
