---
/**
 * /karte/schnecken — SIGNATURE-SEITE, höchster Gestaltungsanspruch der Variante:
 * editorialer Aufmacher, 3 Sorten als 7/4-versetzte Bildblöcke, Prozess-Absätze,
 * Mono-Hinweisband, Querschnitt-Motiv, CTA Vorbestellen.
 */
import { getEntry } from 'astro:content';
import Layout from '../../../variants/a-krume/Layout.astro';
import Breadcrumbs from '../../../variants/a-krume/components/Breadcrumbs.astro';
import Figure from '../../../variants/a-krume/components/Figure.astro';
import { formatMenuPrice } from '../../../lib/format';
import { menuSchema } from '../../../lib/schema-org';

const base = '/a';
const schnecken = await getEntry('menu', 'schnecken');
const items = schnecken!.data.items;
const [pistazie, lotus, haselnuss] = items;

const jsonLd = [menuSchema([{ title: schnecken!.data.title, items }], String(Astro.site))];
---

<Layout
  title="Sauerteigschnecken — die Signature von Sauer & Saftig"
  description="Sauerteig statt Hefeteig, 18 Stunden Reifezeit, dreimal gefüllt: Pistazie, Lotus, Haselnuss. Ofenfrisch am Vormittag, solange der Vorrat reicht."
  jsonLd={jsonLd}
>
  <Breadcrumbs
    items={[
      { label: 'Start', href: base },
      { label: 'Karte', href: `${base}/karte` },
      { label: 'Schnecken', href: `${base}/karte/schnecken` },
    ]}
  />

  <section class="bg-bg py-14 md:py-24">
    <div class="mx-auto max-w-[1440px] px-4 md:px-8">
      <p class="font-mono text-xs uppercase tracking-[0.25em] text-ink-soft" data-reveal>Die Signature</p>
      <h1 class="mt-4 max-w-4xl text-[clamp(2.75rem,7vw,5.5rem)]" data-reveal style="--reveal-delay:100ms">
        {schnecken!.data.title}
      </h1>
      <p class="prose-measure mt-6 text-xl text-ink-soft md:text-2xl" data-reveal style="--reveal-delay:200ms">
        {schnecken!.data.intro}
      </p>
    </div>
  </section>

  <!-- Sorte 1: Bild links (7), Text rechts (4), Text überlappt leicht -->
  <section class="bg-bg-alt py-14 md:py-24">
    <div class="mx-auto max-w-[1440px] px-4 md:px-8">
      <div class="grid grid-cols-1 gap-8 md:grid-cols-12 md:items-center">
        <div class="md:col-span-7" data-reveal>
          <Figure
            motif="schnecke-pistazie-hoch"
            aspect="aspect-[4/5]"
            sizes="(min-width: 768px) 55vw, 100vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <div class="md:col-span-4 md:col-start-8 md:-ml-16 md:mt-16" data-reveal style="--reveal-delay:100ms">
          <div class="rounded-card bg-paper p-6 md:p-8 md:shadow-[0_1px_0_0_rgba(36,27,20,0.08)]">
            <p class="font-mono text-xs uppercase tracking-widest text-ink-soft">01 · Pistazie</p>
            <h2 class="mt-2 text-3xl">{pistazie.name}</h2>
            <p class="prose-measure mt-3 text-ink-soft">{pistazie.description}</p>
            <p class="mt-4 font-mono text-base tabular">{formatMenuPrice(pistazie.price, pistazie.priceIsPlaceholder)}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-bg py-14 md:py-20">
    <div class="mx-auto max-w-[1440px] px-4 md:px-8">
      <p class="prose-measure font-display text-2xl md:text-3xl" data-reveal>
        Sauerteig statt Hefe: Der Grundteig reift rund 18 Stunden, bevor er ausgerollt, gefüllt und aufgerollt wird.
        Was er dadurch verliert, ist Eile — was er gewinnt, ist Struktur und Säure, die die süße Füllung ausbalanciert.
      </p>
    </div>
  </section>

  <!-- Sorte 2: Text links (4), Bild rechts (7) -->
  <section class="bg-bg-alt py-14 md:py-24">
    <div class="mx-auto max-w-[1440px] px-4 md:px-8">
      <div class="grid grid-cols-1 gap-8 md:grid-cols-12 md:items-center">
        <div class="md:order-2 md:col-span-7" data-reveal>
          <Figure motif="schnecke-lotus" aspect="aspect-[4/5]" sizes="(min-width: 768px) 55vw, 100vw" />
        </div>
        <div class="md:order-1 md:col-span-4 md:col-start-1 md:mt-16 md:mr-[-4rem]" data-reveal style="--reveal-delay:100ms">
          <div class="rounded-card bg-paper p-6 text-right md:p-8">
            <p class="font-mono text-xs uppercase tracking-widest text-ink-soft">02 · Lotus</p>
            <h2 class="mt-2 text-3xl">{lotus.name}</h2>
            <p class="prose-measure ml-auto mt-3 text-ink-soft">{lotus.description}</p>
            <p class="mt-4 font-mono text-base tabular">{formatMenuPrice(lotus.price, lotus.priceIsPlaceholder)}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-bg py-14 md:py-20">
    <div class="mx-auto max-w-[1440px] px-4 md:px-8">
      <p class="prose-measure font-display text-2xl md:text-3xl" data-reveal>
        Jeden Morgen von Hand gedreht: Creme verteilen, aufrollen, schneiden — dann geht das Blech in den Ofen,
        bis die Ränder karamellisieren.
      </p>
    </div>
  </section>

  <!-- Sorte 3: Bild links (7), Text rechts (4) -->
  <section class="bg-bg-alt py-14 md:py-24">
    <div class="mx-auto max-w-[1440px] px-4 md:px-8">
      <div class="grid grid-cols-1 gap-8 md:grid-cols-12 md:items-center">
        <div class="md:col-span-7" data-reveal>
          <Figure motif="schnecke-haselnuss" aspect="aspect-[4/5]" sizes="(min-width: 768px) 55vw, 100vw" />
        </div>
        <div class="md:col-span-4 md:col-start-8 md:-ml-16 md:mt-16" data-reveal style="--reveal-delay:100ms">
          <div class="rounded-card bg-paper p-6 md:p-8">
            <p class="font-mono text-xs uppercase tracking-widest text-ink-soft">03 · Haselnuss</p>
            <h2 class="mt-2 text-3xl">{haselnuss.name}</h2>
            <p class="prose-measure mt-3 text-ink-soft">{haselnuss.description}</p>
            <p class="mt-4 font-mono text-base tabular">{formatMenuPrice(haselnuss.price, haselnuss.priceIsPlaceholder)}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Mono-Hinweisband — Verknappungssignal (Sanddorn, 2. von max. 2 Einsätzen) -->
  <section class="bg-accent py-6 text-white">
    <p class="text-center font-mono text-sm uppercase tracking-[0.2em]" data-reveal>
      {schnecken!.data.note}
    </p>
  </section>

  <section class="bg-bg py-14 md:py-24">
    <div class="mx-auto max-w-[1440px] px-4 md:px-8">
      <div class="grid grid-cols-1 gap-10 md:grid-cols-12 md:items-center">
        <div class="md:col-span-6" data-reveal>
          <Figure motif="schnecke-querschnitt" aspect="aspect-[4/5]" sizes="(min-width: 768px) 45vw, 100vw" />
        </div>
        <div class="md:col-span-5 md:col-start-8" data-reveal style="--reveal-delay:100ms">
          <p class="font-mono text-xs uppercase tracking-widest text-ink-soft">Im Querschnitt</p>
          <h2 class="mt-3 text-[clamp(2rem,4vw,2.75rem)]">Schicht für Schicht sichtbar</h2>
          <p class="prose-measure mt-4 text-lg text-ink-soft">
            Eng gerollt, damit die Creme in jeder Windung sitzt — sichtbar wird das erst beim Anschnitt.
          </p>
          <a
            href={`${base}/vorbestellen`}
            class="mt-8 inline-flex min-h-11 items-center justify-center rounded-card bg-accent px-6 py-3 font-mono text-sm text-white transition-colors duration-[var(--dur-fast)] ease-[var(--ease-brand)] hover:bg-accent-ink"
          >
            Vorbestellen
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
