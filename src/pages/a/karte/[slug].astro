---
/** Karten-Sektionsseiten: /karte/fruehstueck, /karte/kuchen, /karte/brot, /karte/kaffee. */
import { getCollection } from 'astro:content';
import Layout from '../../../variants/a-krume/Layout.astro';
import Breadcrumbs from '../../../variants/a-krume/components/Breadcrumbs.astro';
import SectionIntro from '../../../variants/a-krume/components/SectionIntro.astro';
import MenuItemsList from '../../../variants/a-krume/components/MenuItemsList.astro';
import Figure from '../../../variants/a-krume/components/Figure.astro';
import { menuSchema } from '../../../lib/schema-org';

export async function getStaticPaths() {
  const sections = await getCollection('menu');
  return sections
    .filter((s) => s.data.slug !== 'schnecken')
    .map((s) => ({ params: { slug: s.data.slug }, props: { section: s } }));
}

const { section } = Astro.props;
const base = '/a';

const HERO_MOTIF: Record<string, string> = {
  fruehstueck: 'fruehstueck',
  kuchen: 'kaesekuchen',
  brot: 'brot-anschnitt',
  kaffee: 'kaffee',
};
const heroMotif = HERO_MOTIF[section.data.slug] ?? 'fruehstueck';

const jsonLd = [menuSchema([{ title: section.data.title, items: section.data.items }], String(Astro.site))];
---

<Layout
  title={`${section.data.title} — Karte | Sauer & Saftig`}
  description={section.data.intro}
  jsonLd={jsonLd}
>
  <Breadcrumbs
    items={[
      { label: 'Start', href: base },
      { label: 'Karte', href: `${base}/karte` },
      { label: section.data.title, href: `${base}/karte/${section.data.slug}` },
    ]}
  />

  <section class="bg-bg py-14 md:py-24">
    <div class="mx-auto max-w-[1440px] px-4 md:px-8">
      <div class="grid grid-cols-1 gap-10 md:grid-cols-12 md:items-end">
        <div class="md:col-span-5">
          <SectionIntro as="h1" size="lg" eyebrow="Karte" title={section.data.title} intro={section.data.intro} rule />
          {section.data.note && <p class="prose-measure mt-4 font-mono text-sm text-ink-soft">{section.data.note}</p>}
        </div>
        <div class="md:col-span-6 md:col-start-8" data-reveal style="--reveal-delay:100ms">
          <Figure
            motif={heroMotif}
            aspect="aspect-[16/9]"
            sizes="(min-width: 768px) 45vw, 100vw"
            loading="eager"
            mat="flat"
            hover
          />
        </div>
      </div>

      <div class="mt-12 max-w-3xl md:mt-20">
        <MenuItemsList items={section.data.items} />
        <p class="mt-6 font-mono text-sm text-ink-soft">° Beispielpreise — die echte Karte kommt mit dem Küchen-Update.</p>
      </div>
    </div>
  </section>
</Layout>
