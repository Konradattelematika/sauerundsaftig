---
/**
 * /kontakt — Adresse, Telefon, Instagram, OpeningStatus, ClickToLoadMap.
 * Bewusst KEIN Kontaktformular (nicht angeschlossen) — ehrlicher Hinweis statt Mock.
 */
import Layout from '../../variants/a-krume/Layout.astro';
import Breadcrumbs from '../../variants/a-krume/components/Breadcrumbs.astro';
import ClickToLoadMap from '../../components/shared/ClickToLoadMap.astro';
import OpeningStatus from '../../components/shared/OpeningStatus.astro';
import site from '../../data/site.json';
import { telHref } from '../../lib/format';
import { localBusiness } from '../../lib/schema-org';
import { linkArrow, arrowIcon } from '../../variants/a-krume/lib/ui';

const base = '/a';
const phoneHref = telHref(site.phone);
const jsonLd = [localBusiness(String(Astro.site))];
---

<Layout
  title="Kontakt — Sauer & Saftig"
  description="Adresse, Telefon und Instagram von Sauer & Saftig, Dünenstraße 1, Ostseebad Rerik."
  jsonLd={jsonLd}
>
  <Breadcrumbs items={[{ label: 'Start', href: base }, { label: 'Kontakt', href: `${base}/kontakt` }]} />

  <section class="bg-bg py-14 md:py-24">
    <div class="mx-auto max-w-[1440px] px-4 md:px-8">
      <div class="grid grid-cols-1 gap-10 md:grid-cols-12">
        <div class="md:col-span-6" data-reveal>
          <p class="font-mono text-xs uppercase tracking-[0.25em] text-ink-soft">Kontakt</p>
          <span class="tz-rule mt-3" aria-hidden="true"></span>
          <h1 class="mt-4 text-[clamp(2.5rem,6vw,4rem)]">Sprich uns an</h1>
          <p class="prose-measure mt-5 text-lg text-ink-soft">
            {site.address.street}, {site.address.zip} {site.address.city}
          </p>
          <div class="mt-4"><OpeningStatus size="lg" /></div>
          <a
            href={phoneHref}
            class="mt-8 inline-flex min-h-11 items-center justify-center rounded-card bg-ink px-6 py-3 font-mono text-2xl text-bg transition-colors duration-[var(--dur-fast)] ease-[var(--ease-brand)] hover:bg-primary-deep"
          >
            {site.phoneDisplay}
          </a>
          <div class="mt-6">
            <a href={`https://www.instagram.com/${site.instagram}/`} target="_blank" rel="noopener" class={linkArrow}>
              @{site.instagram} auf Instagram
              <svg class={arrowIcon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
            </a>
          </div>

          <div class="mt-10 rounded-card border border-ink/15 bg-bg-alt p-5">
            <p class="font-mono text-xs uppercase tracking-widest text-ink-soft">Formular</p>
            <p class="prose-measure mt-2 text-ink-soft">
              Ein Kontaktformular ist hier noch nicht angeschlossen. Am schnellsten erreichst du uns telefonisch
              oder über Instagram — beides oben verlinkt.
            </p>
          </div>
        </div>

        <div class="md:col-span-6" data-reveal style="--reveal-delay:100ms">
          <ClickToLoadMap />
        </div>
      </div>
    </div>
  </section>
</Layout>
