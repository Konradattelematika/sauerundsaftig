---
/** /journal/[slug] — Artikel: Display-Titel, Body in prose-measure auf Papier, article-JSON-LD, 2 Weiterlese-Teaser. */
import { getCollection, render } from 'astro:content';
import Layout from '../../../variants/c-backstube/Layout.astro';
import DuotoneImage from '../../../variants/c-backstube/components/DuotoneImage.astro';
import { getAlt } from '../../../lib/images';
import { formatDate } from '../../../lib/format';
import { article, breadcrumbs } from '../../../lib/schema-org';
import { label, stamp } from '../../../variants/c-backstube/lib/ui';

export async function getStaticPaths() {
  const entries = await getCollection('journal');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { title, description, date, category, motif } = entry.data;
const { Content } = await render(entry);
const base = '/c';

const CATEGORY_LABELS: Record<string, string> = {
  backstube: 'Backstube',
  sauerteig: 'Sauerteig',
  rerik: 'Rerik',
};

const all = (await getCollection('journal')).sort((a, b) => (a.data.date < b.data.date ? 1 : -1));
const others = all.filter((e) => e.id !== entry.id);
const sameCategory = others.filter((e) => e.data.category === category);
const related = [...sameCategory, ...others.filter((e) => e.data.category !== category)].slice(0, 2);

const jsonLd = [
  article({ title, description, date, url: new URL(`${base}/journal/${entry.id}`, Astro.site).toString() }),
  breadcrumbs([
    { name: 'Start', url: new URL(base, Astro.site).toString() },
    { name: 'Journal', url: new URL(`${base}/journal`, Astro.site).toString() },
    { name: title, url: new URL(`${base}/journal/${entry.id}`, Astro.site).toString() },
  ]),
];
---

<Layout title={`${title} — Journal — Sauer & Saftig`} description={description} jsonLd={jsonLd}>
  <section class="bg-bg pb-6 pt-10 md:pt-14">
    <div class="mx-auto max-w-[1400px] px-4 md:px-8">
      <p class={label}>
        <a href={`${base}/journal`} class="underline-offset-4 hover:underline">Journal</a> / {CATEGORY_LABELS[category] ?? category}
      </p>
      <h1 class="mt-3 font-display text-[clamp(2.5rem,9vw,6rem)] font-extrabold uppercase leading-[0.9] text-ink">{title}</h1>
      <div class="mt-5 flex flex-wrap items-center gap-3">
        <span class={stamp}>{CATEGORY_LABELS[category] ?? category}</span>
        <span class="font-mono text-[15px] tabular text-ink-soft">{formatDate(date)}</span>
      </div>
    </div>
  </section>

  <section class="bg-secondary py-2">
    <DuotoneImage motif={motif} tone="bg-secondary" class="aspect-[21/9] w-full" alt={getAlt(motif)} priority />
  </section>

  <article class="bg-bg py-14 md:py-20" data-reveal>
    <div class="prose-measure mx-auto flex flex-col gap-5 px-4 text-lg text-ink-soft md:px-8">
      <Content />
    </div>
  </article>

  <section class="bg-bg-alt py-16 md:py-24" data-reveal>
    <div class="mx-auto max-w-[1400px] px-4 md:px-8">
      <p class={label}>Weiterlesen</p>
      <div class="mt-6 grid gap-6 md:grid-cols-2">
        {related.map((r) => (
          <a href={`${base}/journal/${r.id}`} class="group block border-2 border-ink bg-paper p-6">
            <span class={stamp}>{CATEGORY_LABELS[r.data.category] ?? r.data.category}</span>
            <p class="mt-4 font-display text-2xl font-extrabold uppercase leading-tight text-ink group-hover:underline">
              {r.data.title}
            </p>
            <p class="mt-2 text-base text-ink-soft">{r.data.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
