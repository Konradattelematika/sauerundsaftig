---
/** /impressum — rendert IMPRESSUM aus src/lib/legal.ts, TODO-Zeilen mit dezentem „folgt"-Stempel, noindex. */
import Layout from '../../variants/c-backstube/Layout.astro';
import { IMPRESSUM } from '../../lib/legal';
import { label, stamp } from '../../variants/c-backstube/lib/ui';
---

<Layout
  title="Impressum — Sauer & Saftig"
  description="Impressum von Sauer & Saftig, Café und Backstube in Rerik."
  noindex
>
  <section class="bg-bg py-16 md:py-24">
    <div class="mx-auto max-w-[900px] px-4 md:px-8">
      <p class={label}>Rechtliches</p>
      <h1 class="mt-2 font-display text-[clamp(2.5rem,8vw,5rem)] font-extrabold uppercase leading-[0.9] text-ink">Impressum.</h1>

      <div class="mt-10 flex flex-col gap-10">
        {IMPRESSUM.map((section) => (
          <div>
            <h2 class="font-display text-2xl font-extrabold uppercase text-ink md:text-3xl">{section.heading}</h2>
            <div class="prose-measure mt-4 flex flex-col gap-3">
              {section.paragraphs.map((p) =>
                p.startsWith('TODO(kunde)') ? (
                  <p class="flex flex-wrap items-center gap-3 text-lg italic text-ink-soft">
                    <span class={stamp}>folgt</span>
                    {p.replace('TODO(kunde): ', '')}
                  </p>
                ) : (
                  <p class="text-lg text-ink-soft">{p}</p>
                ),
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
