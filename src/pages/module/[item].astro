---
/**
 * Modul-Board — Detailseite eines Elements (/module/<id>): Frage, vier Optionen
 * (Live + Alternative 1–3) mit skalierter Vorschau, Desktop/Handy-Umschalter, Vollbild-Link,
 * Bewertung (Nein · Gut · Super gut), Kommentar, Entscheidung und Stimmen der anderen.
 * Desktop 2×2-Raster, mobil untereinander. Interaktion: src/module/board-client.ts.
 */
import BoardShell from '../../module/BoardShell.astro';
import { ITEMS, previewHref, itemHref, neighbors, toBoardData } from '../../module/catalog';
import { GROUP_LABELS, OPTION_LABELS, type ModuleItem } from '../../module/types';

export function getStaticPaths() {
  return ITEMS.map((item) => ({ params: { item: item.id }, props: { item } }));
}

interface Props {
  item: ModuleItem;
}
const { item } = Astro.props;
const { prev, next } = neighbors(item.id);
const data = {
  item: toBoardData(item),
  prev: prev ? { id: prev.id, title: prev.title } : undefined,
  next: next ? { id: next.id, title: next.title } : undefined,
};
const position = ITEMS.findIndex((i) => i.id === item.id) + 1;
// „Zu sehen auf"-Links immer auf die Live-Site: relativ würden "/" und "/besuch" auf
// module.sauerundsaftig.de die Board-Seiten selbst öffnen (Tool-Host löst erst /module/<pfad> auf).
const liveHref = (path: string) => new URL(path, Astro.site ?? 'https://sauerundsaftig.de').href;
---

<BoardShell title={`${item.title} — Modul-Board`} page="item" data={data}>
  <nav aria-label="Zurück" class="mb-6">
    <a href="/module" class="link-ul inline-flex min-h-11 items-center gap-2 font-mono text-sm text-ink">
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6" /></svg>
      Zur Übersicht
    </a>
  </nav>

  <header class="grid grid-cols-1 gap-6 md:grid-cols-12 md:gap-10">
    <div class="md:col-span-8">
      <p class="font-mono text-xs uppercase tracking-[0.25em] text-ink-soft">
        {GROUP_LABELS[item.group]} · {position} von {ITEMS.length}
      </p>
      <span class="tz-rule mt-3" aria-hidden="true"></span>
      <h1 class="mt-4 text-[clamp(2rem,5vw,3.25rem)]">{item.question}</h1>
      <p class="mt-3 text-lg text-ink-soft">
        <span class="font-display text-xl text-ink">{item.title}</span>
        {item.usedOn && item.usedOn.length > 0 && (
          <span class="block mt-1 text-base">
            Zu sehen auf:
            {item.usedOn.map((u, i) => (
              <>
                <a href={liveHref(u.path)} class="link-ul text-ink" target="_blank" rel="noopener">{u.label}</a>{i < item.usedOn!.length - 1 ? ', ' : ''}
              </>
            ))}
          </span>
        )}
      </p>
    </div>
    <div class="md:col-span-4 md:self-end">
      <p class="board-status rounded-card border border-ink/10 bg-paper px-4 py-3 text-sm" data-item-choice>
        Du hast dich hier noch nicht entschieden.
      </p>
    </div>
  </header>

  {item.kind === 'token' && (
    <p class="mt-6 flex items-start gap-3 rounded-card border border-ink/10 bg-bg-alt px-4 py-3 text-sm text-ink-soft">
      <svg class="mt-0.5 size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 8h.01M11 12h1v4h1" /></svg>
      <span>
        Die Vorschau zeigt eine <strong class="font-medium text-ink">Musterseite</strong> aus echten Bausteinen der Website
        (Kopfzeile, Bühne, Karte, Heute frisch, Schnecken, Besuch, Stimmen, Fußzeile) — so siehst du, wie sich
        die Wahl überall auswirkt. In der Vorschau kannst du scrollen.
      </span>
    </p>
  )}

  <!-- Optionen: Desktop 2×2, mobil untereinander -->
  <ul class="mt-8 grid grid-cols-1 gap-5 md:mt-10 md:grid-cols-2 md:gap-6" role="list">
    {item.options.map((option, idx) => {
      const href = previewHref(item.id, option.id);
      const isLive = option.id === 'live';
      return (
        <li>
          <article class="board-option h-full" data-option={option.id} aria-labelledby={`opt-${option.id}`}>
            <header class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
              <div>
                <span class:list={['board-label', isLive && 'board-label--live']}>{OPTION_LABELS[option.id]}</span>
                <h2 id={`opt-${option.id}`} class="mt-2 text-[clamp(1.5rem,3vw,2rem)] leading-tight">{option.title}</h2>
              </div>
              <span class="font-mono text-xs text-ink-soft" aria-hidden="true">{idx + 1}/4</span>
            </header>

            <div class="board-option__body flex flex-col gap-3">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <div class="board-seg" role="group" aria-label={`Ansicht der Vorschau „${option.title}"`}>
                  <button type="button" data-pv-set="desktop" aria-pressed="true">Desktop</button>
                  <button type="button" data-pv-set="phone" aria-pressed="false">Handy</button>
                </div>
                <a href={href} target="_blank" rel="noopener" class="board-btn board-btn--ghost board-btn--sm">
                  Vollbild ansehen
                  <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
                </a>
              </div>
              <div class="pv" data-pv data-pv-mode="desktop">
                <iframe
                  src={href}
                  title={`Vorschau: ${item.title} — ${option.title}`}
                  loading={idx === 0 ? 'eager' : 'lazy'}
                  width="1280"
                  height="800"
                ></iframe>
              </div>
              <p class="text-ink-soft">{option.summary}</p>
            </div>

            <div class="mt-auto flex flex-col gap-3 border-t border-ink/10 pt-4">
              <div>
                <p class="mb-2 font-mono text-[11px] uppercase tracking-[0.2em] text-ink-soft">Deine Bewertung</p>
                <div class="board-rate" role="group" aria-label={`Deine Bewertung für „${option.title}"`}>
                  <button type="button" data-rate="nein" aria-pressed="false" title="Abwählen — diese Möglichkeit kommt für dich nicht infrage">Nein</button>
                  <button type="button" data-rate="gut" aria-pressed="false">Gut</button>
                  <button type="button" data-rate="super" aria-pressed="false">Super gut</button>
                </div>
              </div>
              <div>
                <label for={`comment-${option.id}`} class="mb-2 block font-mono text-[11px] uppercase tracking-[0.2em] text-ink-soft">Dein Kommentar</label>
                <textarea id={`comment-${option.id}`} class="board-textarea" data-comment rows="3" placeholder="Was gefällt dir, was stört dich? (optional)"></textarea>
                <div class="mt-2 flex flex-wrap items-center justify-between gap-2">
                  <button type="button" class="board-btn board-btn--ghost board-btn--sm" data-comment-save>Kommentar speichern</button>
                  <span class="board-status" data-comment-status aria-live="polite"></span>
                </div>
              </div>
              <button type="button" class="board-btn board-choose w-full" data-choose aria-pressed="false">Das nehme ich</button>
              <div class="mt-1">
                <p class="mb-2 font-mono text-[11px] uppercase tracking-[0.2em] text-ink-soft">Stimmen der anderen</p>
                <div data-others><p class="board-status">Wird geladen …</p></div>
              </div>
            </div>
          </article>
        </li>
      );
    })}
  </ul>

  <!-- Vor / zurück -->
  <nav aria-label="Weitere Elemente" class="mt-10 grid grid-cols-1 gap-3 border-t border-ink/10 pt-6 sm:grid-cols-3 md:mt-14">
    <div>
      {prev && (
        <a href={itemHref(prev.id)} class="board-btn board-btn--ghost w-full sm:w-auto">
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6" /></svg>
          {prev.title}
        </a>
      )}
    </div>
    <div class="flex justify-center">
      <a href="/module" class="board-btn board-btn--ghost w-full sm:w-auto">Zur Übersicht</a>
    </div>
    <div class="flex sm:justify-end">
      {next && (
        <a href={itemHref(next.id)} class="board-btn board-btn--primary w-full sm:w-auto">
          Weiter: {next.title}
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      )}
    </div>
  </nav>
</BoardShell>
