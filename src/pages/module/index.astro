---
/**
 * Modul-Board — Übersicht (dist/module/index.html, auf module.sauerundsaftig.de unter "/").
 * Begrüßung für Josie, „So funktioniert's", Fortschritt, Gruppen mit Karten je Element
 * (Live-Vorschau verkleinert, Frage, Status + Chips der anderen — vom Client gefüllt).
 */
import BoardShell from '../../module/BoardShell.astro';
import { itemsByGroup, ITEMS, previewHref, itemHref, toBoardData } from '../../module/catalog';

const groups = itemsByGroup();
const data = { items: ITEMS.map(toBoardData) };
const GROUP_INTRO: Record<string, string> = {
  grundlagen: 'Farben, Schriften, Formen und Material — sie prägen jede Seite auf einmal.',
  komponenten: 'Die kleinen Bausteine, die überall wieder auftauchen.',
  bloecke: 'Die großen Abschnitte der Startseite und der Unterseiten.',
};
---

<BoardShell title="Modul-Board — Sauer & Saftig" page="index" data={data}>
  <!-- Begrüßung -->
  <section class="grid grid-cols-1 gap-8 md:grid-cols-12 md:gap-10">
    <div class="md:col-span-7">
      <p class="font-mono text-xs uppercase tracking-[0.25em] text-ink-soft">Für Josie</p>
      <span class="tz-rule mt-3" aria-hidden="true"></span>
      <h1 class="mt-4 text-[clamp(2.25rem,5.5vw,3.75rem)]">Deine Website, deine Entscheidungen.</h1>
      <p class="prose-measure mt-5 text-lg text-ink-soft md:text-xl">
        Für jeden Baustein der Website siehst du hier, was gerade live ist — und drei Alternativen.
        Schau dir alles in Ruhe an, sag uns, was dir gefällt, und wähl aus. Nichts davon ist in Stein
        gemeißelt: Jede Entscheidung kannst du später wieder ändern.
      </p>
    </div>
    <div class="md:col-span-5">
      <div class="rounded-card border border-ink/10 bg-paper p-5 md:p-6">
        <p class="font-mono text-xs uppercase tracking-[0.25em] text-ink-soft">So funktioniert's</p>
        <ol class="mt-4 flex flex-col gap-4">
          <li class="flex gap-4">
            <span class="grid size-9 shrink-0 place-items-center rounded-full bg-ink font-mono text-sm text-bg" aria-hidden="true">1</span>
            <div>
              <p class="font-display text-xl leading-tight">Ansehen</p>
              <p class="mt-1 text-ink-soft">Jedes Element hat vier Möglichkeiten: <strong class="font-medium text-ink">Live</strong> ist das, was gerade auf der Website steht, dazu drei Alternativen.</p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="grid size-9 shrink-0 place-items-center rounded-full bg-ink font-mono text-sm text-bg" aria-hidden="true">2</span>
            <div>
              <p class="font-display text-xl leading-tight">Bewerten</p>
              <p class="mt-1 text-ink-soft">Sag zu jeder Möglichkeit <em>Nein</em>, <em>Gut</em> oder <em>Super gut</em> — und schreib gern dazu, warum.</p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="grid size-9 shrink-0 place-items-center rounded-full bg-ink font-mono text-sm text-bg" aria-hidden="true">3</span>
            <div>
              <p class="font-display text-xl leading-tight">Entscheiden</p>
              <p class="mt-1 text-ink-soft">Tipp bei deinem Favoriten auf „Das nehme ich". Das wird dann umgesetzt.</p>
            </div>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <!-- Fortschritt -->
  <section class="mt-10 rounded-card border border-ink/10 bg-paper p-5 md:mt-14 md:p-6" aria-labelledby="fortschritt">
    <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
      <h2 id="fortschritt" class="font-display text-2xl md:text-3xl"><span data-progress-text>0 von {ITEMS.length} entschieden</span></h2>
      <p class="text-ink-soft" data-progress-hint>Fang einfach oben an — jede Entscheidung lässt sich später wieder ändern.</p>
    </div>
    <div class="board-progress mt-4" aria-hidden="true"><span data-progress-bar></span></div>
  </section>

  <!-- Gruppen -->
  {groups.map((group) => (
    <section class="mt-12 md:mt-16" aria-labelledby={`gruppe-${group.group}`}>
      <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-2 border-b border-ink/10 pb-4">
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.25em] text-ink-soft">{group.items.length} {group.items.length === 1 ? 'Element' : 'Elemente'}</p>
          <h2 id={`gruppe-${group.group}`} class="mt-2 text-[clamp(1.75rem,4vw,2.5rem)]">{group.label}</h2>
        </div>
        <p class="max-w-[44ch] text-ink-soft">{GROUP_INTRO[group.group]}</p>
      </div>
      <ul class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 md:gap-6" role="list">
        {group.items.map((item) => (
          <li>
            <article class="board-card h-full" data-item-card={item.id}>
              <div class="pv pv--thumb" data-pv data-pv-mode="desktop" data-pv-static data-pv-h="720">
                <iframe
                  src={previewHref(item.id, 'live')}
                  title={`Vorschau: ${item.title} — aktuell live`}
                  loading="lazy"
                  tabindex="-1"
                  aria-hidden="true"
                  width="1280"
                  height="720"
                ></iframe>
              </div>
              <div class="flex flex-1 flex-col px-1 pt-4">
                <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-ink-soft">{group.label}</p>
                <h3 class="mt-1 font-display text-2xl leading-tight">
                  <a href={itemHref(item.id)} class="board-card__link text-ink">{item.title}</a>
                </h3>
                <p class="mt-2 text-ink-soft">{item.question}</p>
                <div class="mt-4 flex flex-wrap items-center gap-2 pt-1">
                  <span data-item-status><span class="board-chip">Noch offen</span></span>
                  <ul class="flex flex-wrap items-center gap-1.5" data-item-chips aria-label="Stimmen der anderen" role="list"></ul>
                </div>
              </div>
            </article>
          </li>
        ))}
      </ul>
    </section>
  ))}

  {ITEMS.length === 0 && (
    <p class="mt-12 rounded-card border border-dashed border-ink/25 p-6 font-mono text-sm text-ink-soft">
      Noch keine Elemente im Katalog (src/module/items/&lt;id&gt;/meta.ts).
    </p>
  )}
</BoardShell>
