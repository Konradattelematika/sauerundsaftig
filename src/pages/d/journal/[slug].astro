---
/**
 * /journal/[slug] — Artikel, prose-measure auf bg-bg, article()-JSON-LD,
 * 2 Weiterlese-Teaser.
 */
import { getCollection, render } from 'astro:content';
import Layout from '../../../variants/d-fermentation/Layout.astro';
import KrumeImage from '../../../variants/d-fermentation/KrumeImage.astro';
import { formatDate } from '../../../lib/format';
import { article, breadcrumbs } from '../../../lib/schema-org';

export async function getStaticPaths() {
  const entries = await getCollection('journal');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { title, description, date, category, motif } = entry.data;
const { Content } = await render(entry);
const base = '/d';

const CATEGORY_LABELS: Record<string, string> = {
  backstube: 'Backstube',
  sauerteig: 'Sauerteig',
  rerik: 'Rerik',
};

const all = (await getCollection('journal')).sort((a, b) => b.data.date.localeCompare(a.data.date));
const more = all.filter((e) => e.id !== entry.id).slice(0, 2);

const jsonLd = [
  article({ title, description, date, url: `${Astro.site}${base}/journal/${entry.id}` }),
  breadcrumbs([
    { name: 'Start', url: `${Astro.site}${base}` },
    { name: 'Journal', url: `${Astro.site}${base}/journal` },
    { name: title, url: `${Astro.site}${base}/journal/${entry.id}` },
  ]),
];
---

<Layout title={`${title} — Journal — Sauer & Saftig`} description={description} jsonLd={jsonLd}>
  <article class="mx-auto max-w-6xl px-4 pt-14 pb-4 md:px-6">
    <a href={`${base}/journal`} class="link-grow inline-flex min-h-[44px] items-center gap-2 font-mono text-sm text-ink-soft">
      ← Journal
    </a>
    <p class="mt-6 font-mono text-sm tracking-widest text-primary uppercase" data-reveal>
      {CATEGORY_LABELS[category] ?? category} · {formatDate(date)}
    </p>
    <h1 class="mt-3 font-display text-[clamp(2.6rem,7vw,5.5rem)] leading-[0.98]" data-reveal>{title}</h1>
    <p class="mt-6 max-w-[60ch] text-xl text-ink-soft" data-reveal style="--reveal-delay: 80ms">{description}</p>
  </article>

  <section class="mt-10 md:mt-14" data-reveal>
    <div class="mx-auto max-w-6xl px-4 md:px-6">
      <KrumeImage motif={motif} shape={1} class="aspect-[16/9]" sizes="100vw" />
    </div>
  </section>

  <article class="prose-measure mx-auto flex max-w-[68ch] flex-col gap-5 bg-bg px-4 py-16 text-xl text-ink md:px-6 md:py-24">
    <Content />
  </article>

  {more.length > 0 && (
    <section class="border-t border-ink/10 bg-bg-alt py-16 md:py-24" aria-labelledby="weiter-h">
      <div class="mx-auto max-w-6xl px-4 md:px-6">
        <p id="weiter-h" class="font-mono text-sm tracking-widest text-primary uppercase" data-reveal>Weiterlesen</p>
        <ul class="mt-8 grid gap-8 md:grid-cols-2">
          {more.map((m, i) => (
            <li data-reveal style={`--reveal-delay: ${i * 90}ms`}>
              <a href={`${base}/journal/${m.id}`} class="group grid gap-3">
                <KrumeImage motif={m.data.motif} shape={((i % 3) + 1) as 1 | 2 | 3} class="aspect-[4/3]" sizes="(min-width: 768px) 45vw, 90vw" />
                <p class="font-mono text-sm text-primary uppercase">{CATEGORY_LABELS[m.data.category] ?? m.data.category}</p>
                <h2 class="font-display text-2xl group-hover:text-primary">{m.data.title}</h2>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</Layout>
