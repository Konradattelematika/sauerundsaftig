---
/** /datenschutz — rendert DATENSCHUTZ aus lib/legal.ts, noindex. */
import Layout from '../../variants/d-fermentation/Layout.astro';
import { DATENSCHUTZ } from '../../lib/legal';
import { breadcrumbs } from '../../lib/schema-org';

const base = '/d';
const jsonLd = [
  breadcrumbs([
    { name: 'Start', url: `${Astro.site}${base}` },
    { name: 'Datenschutz', url: `${Astro.site}${base}/datenschutz` },
  ]),
];
---

<Layout
  title="Datenschutz — Sauer & Saftig"
  description="Datenschutzerklärung: keine Cookies, kein Tracking, Kartendarstellung als Klick-to-Load."
  jsonLd={jsonLd}
  noindex
>
  <section class="mx-auto max-w-6xl px-4 pt-14 pb-4 md:px-6">
    <p class="font-mono text-sm tracking-widest text-primary uppercase" data-reveal>Rechtliches</p>
    <h1 class="mt-3 font-display text-[clamp(2.4rem,6vw,4.5rem)] leading-[0.98]" data-reveal>Datenschutz</h1>
  </section>

  <section class="mx-auto max-w-[900px] px-4 py-16 md:px-6 md:py-24">
    <div class="prose-measure flex flex-col gap-12">
      {DATENSCHUTZ.map((section, i) => (
        <div data-reveal style={`--reveal-delay: ${i * 60}ms`}>
          <p class="font-mono text-sm tracking-widest text-primary uppercase">{section.heading}</p>
          <div class="mt-4 flex flex-col gap-3">
            {section.paragraphs.map((p) =>
              p.startsWith('TODO(kunde)') ? (
                <p class="font-mono text-sm text-ink-soft">folgt — {p.replace(/^TODO\(kunde\):\s*/, '')}</p>
              ) : (
                <p class="text-xl text-ink-soft">{p}</p>
              ),
            )}
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>
