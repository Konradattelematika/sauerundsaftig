---
/** /kontakt — Adresse/Telefon/Instagram groß, OpeningStatus, ClickToLoadMap, kein Formular. */
import Layout from '../../variants/d-fermentation/Layout.astro';
import ClickToLoadMap from '../../components/shared/ClickToLoadMap.astro';
import OpeningStatus from '../../components/shared/OpeningStatus.astro';
import site from '../../data/site.json';
import { telHref } from '../../lib/format';
import { localBusiness, breadcrumbs } from '../../lib/schema-org';

const base = '/d';
const jsonLd = [
  localBusiness(String(Astro.site)),
  breadcrumbs([
    { name: 'Start', url: `${Astro.site}${base}` },
    { name: 'Kontakt', url: `${Astro.site}${base}/kontakt` },
  ]),
];
---

<Layout title="Kontakt — Sauer & Saftig" description="Adresse, Telefon und Instagram von Sauer & Saftig in Ostseebad Rerik." jsonLd={jsonLd}>
  <section class="mx-auto max-w-6xl px-4 pt-14 pb-4 md:px-6">
    <p class="font-mono text-sm tracking-widest text-primary uppercase" data-reveal>Kontakt</p>
    <h1 class="mt-3 font-display text-[clamp(2.8rem,9vw,6.5rem)] leading-[0.96]" data-reveal>Ruf einfach an.</h1>
    <p class="mt-6 max-w-[60ch] text-xl text-ink-soft" data-reveal style="--reveal-delay: 80ms">
      Am schnellsten erreichst du uns telefonisch — für Reservierung, Fragen zur Karte oder alles andere.
    </p>
    <div class="mt-6" data-reveal style="--reveal-delay: 120ms"><OpeningStatus size="lg" /></div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-2 md:gap-20">
      <div class="grid content-start gap-8">
        <div data-reveal>
          <p class="font-mono text-sm tracking-widest text-primary uppercase">Telefon</p>
          <a href={telHref(site.phone)} class="btn-glow mt-3 inline-flex min-h-[48px] items-center rounded-card bg-accent px-6 py-3 font-mono text-[clamp(1.6rem,5vw,2.6rem)] text-black">
            {site.phoneDisplay}
          </a>
        </div>
        <div data-reveal style="--reveal-delay: 60ms">
          <p class="font-mono text-sm tracking-widest text-primary uppercase">Adresse</p>
          <p class="mt-2 text-xl text-ink">{site.address.street}</p>
          <p class="text-xl text-ink">{site.address.zip} {site.address.city}</p>
        </div>
        <div data-reveal style="--reveal-delay: 120ms">
          <p class="font-mono text-sm tracking-widest text-primary uppercase">Instagram</p>
          <a
            href={`https://www.instagram.com/${site.instagram}/`}
            target="_blank"
            rel="noopener"
            class="link-grow mt-2 inline-flex min-h-[44px] items-center text-xl text-ink"
          >
            @{site.instagram}
          </a>
        </div>
        <div class="rounded-card border border-ink/15 bg-bg-alt p-6" data-reveal style="--reveal-delay: 180ms">
          <p class="text-xl">Wir sind noch in der Demo-Phase.</p>
          <p class="mt-2 text-ink-soft">
            Ein Kontaktformular gibt es hier bewusst noch nicht — ruf uns lieber direkt an, dann bekommst
            du sofort eine Antwort.
          </p>
        </div>
      </div>
      <div data-reveal style="--reveal-delay: 100ms">
        <ClickToLoadMap />
      </div>
    </div>
  </section>
</Layout>
