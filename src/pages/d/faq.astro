---
/** /faq — Fragen aus der Collection als <details>-Accordion, faqPage()-JSON-LD. */
import { getCollection } from 'astro:content';
import Layout from '../../variants/d-fermentation/Layout.astro';
import site from '../../data/site.json';
import { telHref } from '../../lib/format';
import { faqPage, breadcrumbs } from '../../lib/schema-org';

const base = '/d';
const entries = (await getCollection('faq')).sort((a, b) => a.data.order - b.data.order);

/** Antworten sind reine Prosa — Absätze als <p> für die JSON-LD-Antwort. */
function toAnswerHtml(body: string): string {
  return body
    .trim()
    .split(/\n{2,}/)
    .map((p) => `<p>${p.trim()}</p>`)
    .join('');
}

const jsonLd = [
  faqPage(entries.map((e) => ({ question: e.data.question, answerHtml: toAnswerHtml(e.body ?? '') }))),
  breadcrumbs([
    { name: 'Start', url: `${Astro.site}${base}` },
    { name: 'FAQ', url: `${Astro.site}${base}/faq` },
  ]),
];
---

<Layout
  title="Fragen und Antworten — Sauer & Saftig"
  description="Häufige Fragen zu Öffnungszeiten, Reservierung, Karte und mehr — kurz beantwortet."
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-6xl px-4 pt-14 pb-4 md:px-6">
    <p class="font-mono text-sm tracking-widest text-primary uppercase" data-reveal>Fragen</p>
    <h1 class="mt-3 font-display text-[clamp(2.8rem,9vw,6.5rem)] leading-[0.96]" data-reveal>Was du wissen willst.</h1>
    <p class="mt-6 max-w-[60ch] text-xl text-ink-soft" data-reveal style="--reveal-delay: 80ms">
      Fehlt etwas? Ruf uns an unter{' '}
      <a href={telHref(site.phone)} class="link-grow text-ink">{site.phoneDisplay}</a>.
    </p>
  </section>

  <section class="mx-auto max-w-[900px] px-4 py-16 md:px-6 md:py-24">
    <div class="d-faq">
      {entries.map((entry, i) => (
        <div class="border-t border-ink/15 last:border-b" data-reveal style={`--reveal-delay: ${Math.min(i, 8) * 50}ms`}>
          <details class="group py-2">
            <summary class="flex min-h-[44px] cursor-pointer list-none items-center justify-between gap-6 py-4">
              <span class="link-grow font-display text-2xl leading-snug text-ink md:text-3xl">{entry.data.question}</span>
              <span class="d-faq-indicator shrink-0 font-mono text-2xl text-primary" aria-hidden="true"></span>
            </summary>
            <div class="max-w-[64ch] pb-6 text-xl text-ink-soft">
              <Fragment set:html={toAnswerHtml(entry.body ?? '')} />
              {entry.data.todoKunde && (
                <p class="mt-3 font-mono text-sm text-ink-soft">folgt — {entry.data.todoKunde}</p>
              )}
            </div>
          </details>
        </div>
      ))}
    </div>
  </section>
</Layout>

<style>
  .d-faq-indicator::before {
    content: '+';
  }
  details[open] .d-faq-indicator::before {
    content: '−';
  }
</style>
