---
/** /karte — Übersicht aller 5 Sektionen mit Ankernavigation (VARIANT-BRIEF D §1). */
import { getCollection } from 'astro:content';
import Layout from '../../../variants/d-fermentation/Layout.astro';
import MenuSectionBlock from '../../../variants/d-fermentation/components/MenuSectionBlock.astro';
import MenuLegend from '../../../variants/d-fermentation/components/MenuLegend.astro';
import { MENU_SECTIONS } from '../../../lib/variants';
import { menuSchema, breadcrumbs } from '../../../lib/schema-org';

const base = '/d';
const all = await getCollection('menu');
const sections = MENU_SECTIONS.map((slug) => all.find((s) => s.data.slug === slug)).filter(
  (s): s is NonNullable<typeof s> => Boolean(s),
);

const jsonLd = [
  menuSchema(sections.map((s) => ({ title: s.data.title, items: s.data.items })), String(Astro.site)),
  breadcrumbs([
    { name: 'Start', url: `${Astro.site}${base}` },
    { name: 'Karte', url: `${Astro.site}${base}/karte` },
  ]),
];
---

<Layout
  title="Karte — Sauer & Saftig"
  description="Frühstück, Kuchen, Brot, Sauerteigschnecken und Kaffee — die Karte im Überblick."
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-6xl px-4 pt-14 pb-4 md:px-6">
    <p class="font-mono text-sm tracking-widest text-primary uppercase" data-reveal>Karte</p>
    <h1 class="mt-3 font-display text-[clamp(2.8rem,9vw,6.5rem)] leading-[0.96]" data-reveal>
      Was heute auf<br />den Tisch kommt.
    </h1>
    <div class="mt-6" data-reveal style="--reveal-delay: 80ms">
      <MenuLegend />
    </div>

    <nav aria-label="Sprung zu Sektionen" class="mt-8 flex flex-wrap gap-x-6 gap-y-3" data-reveal style="--reveal-delay: 140ms">
      {sections.map((s) => (
        <a href={`#${s.data.slug}`} class="link-grow flex min-h-[44px] items-center font-mono text-sm text-ink">
          {s.data.title}
        </a>
      ))}
    </nav>
  </section>

  <div class="mx-auto flex max-w-6xl flex-col gap-16 px-4 py-16 md:gap-24 md:px-6 md:py-24">
    {sections.map((s) => (
      <MenuSectionBlock section={s} as="h2" />
    ))}
  </div>

  <section class="border-t border-ink/10 bg-bg-alt py-16" aria-label="Zur Signature-Seite">
    <div class="mx-auto max-w-6xl px-4 text-center md:px-6" data-reveal>
      <p class="font-mono text-sm tracking-widest text-primary uppercase">Unsere Signature</p>
      <h2 class="mt-3 font-display text-3xl md:text-5xl">Die Sauerteigschnecke, ausführlich</h2>
      <a href={`${base}/karte/schnecken`} class="link-grow mt-6 inline-flex text-xl text-primary">Alles über die Schnecke →</a>
    </div>
  </section>
</Layout>
