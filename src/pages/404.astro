---
/** Root-404 (außerhalb der Varianten) — nginx liefert sie für unbekannte Pfade ohne /a|b|c-Prefix. */
import SeoHead from '../components/shared/SeoHead.astro';
---

<!doctype html>
<html lang="de">
  <head>
    <SeoHead title="Seite nicht gefunden — Sauer & Saftig" description="Diese Seite gibt es nicht." noindex />
  </head>
  <body>
    <main>
      <img src="/brand/logo-lockup-ink-640.png" alt="Sauer & Saftig — Brot und Kuchen" width="180" height="130" />
      <h1>Diese Seite ist wie ein Sauerteig ohne Fütterung.</h1>
      <p>Nicht mehr da. Aber die Übersicht der drei Design-Varianten wartet.</p>
      <a href="/">Zur Übersicht</a>
    </main>
    <style>
      * { box-sizing: border-box; margin: 0; }
      body {
        background: #faf8f4; color: #1c1917;
        font-family: -apple-system, 'Segoe UI', Roboto, sans-serif; line-height: 1.6;
        min-height: 100vh; display: grid; place-items: center;
      }
      main { text-align: center; padding: 32px; max-width: 56ch; display: grid; gap: 16px; justify-items: center; }
      img { height: auto; }
      h1 { font-size: clamp(1.6rem, 4vw, 2.4rem); line-height: 1.2; }
      a {
        background: #1c1917; color: #faf8f4; text-decoration: none;
        padding: 12px 22px; border-radius: 6px; min-height: 44px; display: inline-flex; align-items: center;
      }
      a:focus-visible { outline: 3px solid #b45309; outline-offset: 3px; }
    </style>
  </body>
</html>
