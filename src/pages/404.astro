---
/**
 * /404 — Variante A. Baut nach dist/404.html — der Server liefert sie für unbekannte Pfade (Status 404).
 * Inhalt aus der CMS-Systemseite `nicht-gefunden` (system: true → nicht über die CMS-Route ausgeliefert):
 * SEO aus page.seo, Sektionen über SectionList (Typ „nicht-gefunden": Text + Links zu Karte und Startseite).
 */
import { getImage as astroGetImage } from 'astro:assets';
import Layout from '../variants/a-krume/Layout.astro';
import SectionList from '../cms/SectionList.astro';
import { cms, page as cmsPage, plain } from '../cms';
import { getImage } from '../lib/images';

const page = cmsPage('nicht-gefunden');
const seo = page.seo;

let ogImage: string | undefined;
const ogRef = seo.ogImage ?? cms().settings.seoDefaults?.ogImage ?? null;
if (ogRef?.media) {
  const img = await astroGetImage({ src: getImage('a', ogRef.media), width: 1200, format: 'jpg', quality: 80 });
  ogImage = img.src;
}
---

<Layout
  title={seo.title}
  description={plain(seo.description)}
  ogImage={ogImage}
  ogTitle={seo.ogTitle || undefined}
  ogDescription={seo.ogDescription || undefined}
  canonical={seo.canonical || undefined}
  noindex
>
  <SectionList page={page} />
</Layout>
