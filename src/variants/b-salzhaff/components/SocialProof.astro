---
/** Social Proof: Google-Rating + 2 klar ausgegraute Platzhalter-Zitate. */
import { getCollection } from 'astro:content';
import site from '../../../data/site.json';
import SectionLabel from './SectionLabel.astro';

const testimonials = (await getCollection('testimonials')).sort((a, b) => a.data.order - b.data.order);
---

<section class="mx-auto max-w-[1440px] px-4 py-16 md:px-8 md:py-28">
  <SectionLabel number="03" label="Stimmen" />
  <div class="mt-8 flex flex-wrap items-baseline gap-x-4 gap-y-2">
    <p class="font-display text-[clamp(2rem,5vw,3.5rem)]">{site.rating.value} ★</p>
    <p class="text-xl text-ink-soft">{site.rating.count} Google-Bewertungen</p>
  </div>

  <div class="mt-10 grid grid-cols-1 gap-8 md:grid-cols-2">
    {testimonials.map((t) => (
      <blockquote
        class:list={[
          'rounded-card border border-ink/15 p-6',
          t.data.isPlaceholder ? 'bg-bg-alt text-ink-soft' : 'bg-paper text-ink',
        ]}
        data-reveal
      >
        {t.data.isPlaceholder && (
          <p class="mb-3 font-mono text-[15px] uppercase tracking-widest text-ink-soft">Platzhalter — TODO(kunde)</p>
        )}
        <p class="text-xl">„{t.data.quote}"</p>
        <footer class="mt-3 font-mono text-[15px] text-ink-soft">{t.data.author}</footer>
      </blockquote>
    ))}
  </div>
</section>
