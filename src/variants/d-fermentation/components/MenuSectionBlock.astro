---
/**
 * Eine Karten-Sektion (Frühstück/Kuchen/Brot/Schnecken/Kaffee) als Zeilenliste:
 * Name/Beschreibung links, Preis rechts Mono mit °, veggie/vegan als
 * Mono-Text-Badges (VARIANT-BRIEF D §Routen /karte, /karte/<sektion>).
 */
import type { CollectionEntry } from 'astro:content';
import { formatMenuPrice } from '../../../lib/format';

interface Props {
  section: CollectionEntry<'menu'>;
  /** h1 auf den Sektionsseiten, h2 in der Kartenübersicht */
  as?: 'h1' | 'h2';
  kicker?: string;
}
const { section, as: Heading = 'h2', kicker = 'Karte' } = Astro.props;
const { title, intro, note, items } = section.data;
---

<div id={section.data.slug} class="scroll-mt-28">
  <p class="font-mono text-sm tracking-widest text-primary uppercase" data-reveal>{kicker}</p>
  <Heading class="mt-2 font-display text-3xl md:text-5xl" data-reveal>{title}</Heading>
  <p class="mt-4 max-w-[60ch] text-xl text-ink-soft" data-reveal>{intro}</p>
  {note && (
    <p class="mt-2 max-w-[60ch] font-mono text-sm text-primary" data-reveal>
      {note}
    </p>
  )}

  <ul class="mt-8 divide-y divide-ink/10 border-t border-ink/10">
    {items.map((item, i) => (
      <li class="flex flex-wrap items-start justify-between gap-x-6 gap-y-2 py-5" data-reveal style={`--reveal-delay: ${Math.min(i, 6) * 40}ms`}>
        <div class="grid gap-1.5">
          <p class="text-lg text-ink">
            {item.name}
            {item.highlight && <span class="ml-2 align-middle font-mono text-xs tracking-widest text-primary uppercase">Signature</span>}
          </p>
          {item.description && <p class="max-w-[52ch] text-ink-soft">{item.description}</p>}
          {(item.veggie || item.vegan || item.seasonal) && (
            <div class="flex flex-wrap gap-2">
              {item.veggie && (
                <span class="rounded-card border border-ink/25 px-2 py-0.5 font-mono text-xs text-ink-soft">vegetarisch</span>
              )}
              {item.vegan && (
                <span class="rounded-card border border-ink/25 px-2 py-0.5 font-mono text-xs text-ink-soft">vegan</span>
              )}
              {item.seasonal && <span class="font-mono text-xs text-primary">{item.seasonal}</span>}
            </div>
          )}
          {item.allergens.length > 0 && (
            <p class="font-mono text-xs text-ink-soft">Allergene: {item.allergens.join(', ')}</p>
          )}
        </div>
        {item.price !== undefined && (
          <p class="shrink-0 font-mono text-lg tabular text-ink">
            {formatMenuPrice(item.price, item.priceIsPlaceholder, item.priceSuffix)}
          </p>
        )}
      </li>
    ))}
  </ul>
</div>
