---
/** Signature-Block „Schnecke" für die Startseite — 3 Sorten, Link zur Signature-Seite. */
import { getEntry } from 'astro:content';
import Figure from './Figure.astro';

interface Props {
  base: string;
}
const { base } = Astro.props;
const schnecken = await getEntry('menu', 'schnecken');
---

{schnecken && (
  <section class="bg-bg py-14 md:py-24">
    <div class="mx-auto max-w-[1440px] px-4 md:px-8">
      <div class="grid grid-cols-1 gap-10 md:grid-cols-12 md:items-center">
        <div class="md:col-span-5 md:order-2" data-reveal>
          <p class="font-mono text-xs uppercase tracking-[0.25em] text-ink-soft">Die Signature</p>
          <h2 class="mt-3 text-[clamp(2rem,5vw,3.5rem)]">{schnecken.data.title}</h2>
          <p class="prose-measure mt-4 text-lg text-ink-soft">{schnecken.data.intro}</p>
          <ul class="mt-6 flex flex-col gap-2 font-mono text-sm uppercase tracking-widest text-ink-soft">
            {schnecken.data.items.map((it) => <li>{it.name}</li>)}
          </ul>
          <a
            href={`${base}/karte/schnecken`}
            class="mt-8 inline-flex min-h-11 items-center justify-center rounded-card border-2 border-ink px-5 py-2.5 font-mono text-sm text-ink transition-colors duration-[var(--dur-fast)] ease-[var(--ease-brand)] hover:bg-ink hover:text-bg"
          >
            Zur Signature-Seite
          </a>
        </div>
        <div class="grid grid-cols-2 gap-4 md:col-span-7 md:order-1" data-reveal style="--reveal-delay:100ms">
          <Figure
            motif="schnecke-pistazie-hoch"
            aspect="aspect-[4/5]"
            sizes="(min-width: 1024px) 30vw, 45vw"
            class="col-span-2 sm:col-span-1"
          />
          <Figure motif="schnecke-blech" aspect="aspect-[4/5]" sizes="(min-width: 1024px) 30vw, 45vw" class="hidden sm:block" />
        </div>
      </div>
    </div>
  </section>
)}
