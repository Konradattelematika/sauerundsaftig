---
/** Signature-Block „Schnecke" für die Startseite — 3 Sorten, Link zur Signature-Seite. */
import { getEntry } from 'astro:content';
import Figure from './Figure.astro';
import { btnSecondary, arrowIcon } from '../lib/ui';

interface Props {
  base: string;
}
const { base } = Astro.props;
const schnecken = await getEntry('menu', 'schnecken');
---

{schnecken && (
  <section class="bg-bg py-14 md:py-24">
    <div class="mx-auto max-w-[1440px] px-4 md:px-8">
      <div class="grid grid-cols-1 gap-10 md:grid-cols-12 md:items-center">
        <div class="md:col-span-5 md:order-2" data-reveal>
          <p class="font-mono text-xs uppercase tracking-[0.25em] text-ink-soft">Die Signature</p>
          <span class="tz-rule mt-3" aria-hidden="true"></span>
          <h2 class="mt-3 text-[clamp(2rem,5vw,3.5rem)]">{schnecken.data.title}</h2>
          <p class="prose-measure mt-4 text-lg text-ink-soft">{schnecken.data.intro}</p>
          <ol class="mt-6 flex flex-col divide-y divide-ink/10 border-y border-ink/10 font-mono text-sm uppercase tracking-widest text-ink-soft">
            {schnecken.data.items.map((it, i) => (
              <li class="flex items-center gap-4 py-3">
                <span class="text-ink/50">0{i + 1}</span>
                <span class="text-ink">{it.name}</span>
              </li>
            ))}
          </ol>
          <a href={`${base}/karte/schnecken`} class:list={[btnSecondary, 'mt-8 px-5 py-2.5']}>
            Zur Signature-Seite
            <svg class={arrowIcon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
        </div>
        <div class="grid grid-cols-2 gap-4 md:col-span-7 md:order-1 md:gap-6">
          <Figure
            motif="schnecke-pistazie-hoch"
            aspect="aspect-[4/5]"
            sizes="(min-width: 1024px) 30vw, 45vw"
            class="col-span-2 sm:col-span-1"
            reveal
            revealKind="image"
            hover
          />
          <div class="hidden sm:block sm:pt-12" data-parallax="0.05">
            <Figure motif="schnecke-blech" aspect="aspect-[4/5]" sizes="(min-width: 1024px) 30vw, 45vw" reveal revealKind="image" revealDelay={100} hover />
          </div>
        </div>
      </div>
    </div>
  </section>
)}
