---
/**
 * Footer Variante A: Terrazzo-Band als Übergang (Material „Theke"), dunkler Abschluss
 * (bg-ink), NAV_FOOTER + „Über mich" (nur A), NAV_LEGAL, Öffnungszeiten kompakt,
 * Instagram, TGTG-Zeile, Claim.
 */
import Logo from '../../../components/shared/Logo.astro';
import site from '../../../data/site.json';
import { NAV_FOOTER, NAV_LEGAL } from '../../../lib/variants';
import { weekOverview, type Schedule } from '../../../lib/opening-hours';
import { telHref } from '../../../lib/format';

interface Props {
  base: string;
}
const { base } = Astro.props;
const week = weekOverview(site.openingHours as unknown as Schedule);
const phoneHref = telHref(site.phone);
// „Über mich" (Josie) gibt es nur in Variante A — direkt hinter „Über uns" einsortieren
const footerNav = NAV_FOOTER.flatMap((item) =>
  item.path === '/ueber-uns' ? [item, { label: 'Über mich', path: '/ueber-mich' }] : [item],
);
---

<footer class="bg-ink text-bg">
  <span class="tz-band" aria-hidden="true"></span>
  <div class="mx-auto grid max-w-[1440px] gap-10 px-4 py-16 md:grid-cols-12 md:gap-8 md:px-8 md:py-24">
    <div class="md:col-span-4">
      <Logo variant="lockup" tone="light" width={170} loading="lazy" />
      <p class="mt-5 font-display text-2xl">{site.claim}</p>
      <p class="mt-3 max-w-[32ch] text-bg/70">{site.subline}</p>
      <a
        href={`https://www.instagram.com/${site.instagram}/`}
        target="_blank"
        rel="noopener"
        class="link-ul link-ul--light mt-5 inline-flex min-h-11 items-center gap-2 font-mono text-sm"
      >
        @{site.instagram} auf Instagram
        <svg class="arrow-icon size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
      </a>
    </div>

    <nav aria-label="Footer-Navigation" class="md:col-span-3">
      <p class="font-mono text-xs uppercase tracking-widest text-bg/60">Mehr</p>
      <ul class="mt-4 flex flex-col gap-3">
        {footerNav.map((item) => (
          <li>
            <a href={`${base}${item.path}`} class="link-ul link-ul--light inline-flex min-h-8 items-center text-bg/90 hover:text-bg">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="md:col-span-5">
      <p class="font-mono text-xs uppercase tracking-widest text-bg/60">Öffnungszeiten</p>
      <dl class="mt-4 grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 font-mono text-xl text-bg/90">
        {week.map((d) => (
          <>
            <dt class="text-bg/60">{d.short}</dt>
            <dd class="tabular">{d.hours}</dd>
          </>
        ))}
      </dl>
      <a href={phoneHref} class="link-ul link-ul--light mt-5 inline-flex min-h-11 items-center font-mono text-xl">
        {site.phoneDisplay}
      </a>
      <p class="mt-4 max-w-[38ch] text-sm text-bg/70">
        Bei Too Good To Go dabei: Überraschungstüte für {site.tooGoodToGo.bagPrice} € statt rund {site.tooGoodToGo.bagValue} € Warenwert, solange Vorrat reicht.
      </p>
    </div>
  </div>

  <div class="border-t border-bg/15">
    <div class="mx-auto flex max-w-[1440px] flex-wrap items-center justify-between gap-3 px-4 py-6 font-mono text-xs uppercase tracking-widest text-bg/60 md:px-8">
      <p>© {new Date().getFullYear()} {site.name} · Dünenstraße 1, {site.address.city}</p>
      <ul class="flex flex-wrap items-center gap-5">
        {NAV_LEGAL.map((item) => (
          <li><a href={`${base}${item.path}`} class="inline-flex min-h-8 items-center transition-colors duration-[var(--dur-fast)] hover:text-bg">{item.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
</footer>
