---
/**
 * Social Proof: Google-Rating + 2 Testimonial-Platzhalter, klar als Platzhalter
 * markiert (isPlaceholder) — keine erfundenen Zitate.
 */
import { getCollection } from 'astro:content';
import site from '../../../data/site.json';

const testimonials = (await getCollection('testimonials')).sort((a, b) => a.data.order - b.data.order);
---

<section class="bg-bg py-14 md:py-24">
  <div class="mx-auto max-w-[1440px] px-4 md:px-8">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-12">
      <div class="md:col-span-4" data-reveal>
        <p class="font-mono text-xs uppercase tracking-[0.25em] text-ink-soft">Was Gäste sagen</p>
        <p class="mt-3 font-display text-[clamp(2.5rem,6vw,4rem)] leading-none">{site.rating.value.toLocaleString('de-DE')} <span class="text-accent-ink">★</span></p>
        <p class="mt-2 text-lg text-ink-soft">{site.rating.count} Google-Bewertungen</p>
        <span class="tz-rule mt-4" aria-hidden="true"></span>
      </div>
      <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 md:col-span-8">
        {testimonials.map((t, i) => (
          <li
            class:list={[
              'rounded-card border border-dashed border-ink/25 bg-bg-alt p-6',
              t.data.isPlaceholder && 'opacity-70',
            ]}
            data-reveal
            style={`--reveal-delay:${(i % 2) * 100}ms`}
          >
            {t.data.isPlaceholder && (
              <p class="mb-3 font-mono text-[11px] uppercase tracking-widest text-ink-soft">Platzhalter — echtes Zitat folgt</p>
            )}
            <p class="font-display text-xl">„{t.data.quote}"</p>
            <p class="mt-3 font-mono text-sm text-ink-soft">{t.data.author}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
