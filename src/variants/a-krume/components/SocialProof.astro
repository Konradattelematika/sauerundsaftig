---
/**
 * Social Proof: Google-Rating + echte Gästezitate (CMS-Sammlung „Gästestimmen"). Platzhalter-Zitate
 * (isPlaceholder) werden auf der öffentlichen Seite nicht gezeigt — solange keine echten da sind,
 * steht nur das Rating. Texte als Props (Standard = bisherige Texte): CMS-Sektion „stimmen" und Modul-Board.
 */
import { cms } from '../../../cms';
import site from '../../../data/site.json';

interface Props {
  eyebrow?: string;
  /** {anzahl} = Zahl der Bewertungen aus den Einstellungen */
  countLabel?: string;
  tone?: 'bg' | 'bg-alt';
  /** CMS-Editor-Marker je Element (root, eyebrow, countLabel) — nur im Editor-Build befüllt */
  edit?: Record<string, Record<string, string>>;
}
const { eyebrow = 'Was Gäste sagen', countLabel = '{anzahl} Google-Bewertungen', tone = 'bg', edit = {} } = Astro.props;

const testimonials = cms().collections.testimonials.filter((t) => !t.isPlaceholder);
const countText = countLabel.replaceAll('{anzahl}', String(site.rating.count));
---

<section class:list={[tone === 'bg-alt' ? 'bg-bg-alt' : 'bg-bg', 'py-14 md:py-24']} {...edit.root}>
  <div class="mx-auto max-w-[1440px] px-4 md:px-8">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-12">
      <div class:list={[testimonials.length ? 'md:col-span-4' : 'md:col-span-12']} data-reveal>
        {eyebrow && <p class="font-mono text-xs uppercase tracking-[0.25em] text-ink-soft" {...edit.eyebrow}>{eyebrow}</p>}
        <p class="mt-3 font-display text-[clamp(2.5rem,6vw,4rem)] leading-none">{site.rating.value.toLocaleString('de-DE')} <span class="text-accent-ink">★</span></p>
        {countText && <p class="mt-2 text-lg text-ink-soft" {...edit.countLabel}>{countText}</p>}
        <span class="tz-rule mt-4" aria-hidden="true"></span>
      </div>
      {testimonials.length > 0 && (
      <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 md:col-span-8">
        {testimonials.map((t, i) => (
          <li
            class:list={[
              'rounded-card border border-dashed border-ink/25 bg-bg-alt p-6',
              t.isPlaceholder && 'opacity-70',
            ]}
            data-reveal
            style={`--reveal-delay:${(i % 2) * 100}ms`}
          >
            {t.isPlaceholder && (
              <p class="mb-3 font-mono text-[11px] uppercase tracking-widest text-ink-soft">Platzhalter — echtes Zitat folgt</p>
            )}
            <p class="font-display text-xl">„{t.quote}“</p>
            <p class="mt-3 font-mono text-sm text-ink-soft">{t.author}</p>
          </li>
        ))}
      </ul>
      )}
    </div>
  </div>
</section>
