---
/**
 * „Heute frisch"-Board aus der CMS-Sammlung „Aus der Backstube" (collections.heuteFrisch) —
 * editorial statt Karten: Datum als Mono-Zeile, Motive mit sanfter Hover-Bewegung, Namen in
 * Fraunces, soldOut als Badge + durchgestrichene Notiz. Gestaffeltes data-reveal.
 * Texte kommen als Props (Standard = bisherige Texte): CMS-Sektion „heute-frisch" und Modul-Board.
 */
import { cms } from '../../../cms';
import { formatDate } from '../../../lib/format';
import Figure from './Figure.astro';

interface Props {
  eyebrow?: string;
  title?: string;
  /** {datum} = Datum der Sammlung */
  dateLine?: string;
  soldOutLabel?: string;
  tone?: 'bg' | 'bg-alt';
  /** CMS-Editor-Marker je Element (root, eyebrow, title, dateLine, soldOutLabel) — nur im Editor-Build befüllt */
  edit?: Record<string, Record<string, string>>;
}
const {
  eyebrow = 'Aus der Backstube',
  title = 'Eine Auswahl aus unserem Ofen',
  dateLine = 'Stand {datum}',
  soldOutLabel = 'Vergriffen',
  tone = 'bg-alt',
  edit = {},
} = Astro.props;

type Item = { name: string; note?: string; motif?: string; soldOut?: boolean };
const today = cms().collections.heuteFrisch as { date: string; items: Item[] } | undefined;
const dateText = today ? dateLine.replaceAll('{datum}', formatDate(today.date)) : '';
---

{today && (
  <section class:list={[tone === 'bg' ? 'bg-bg' : 'bg-bg-alt', 'py-14 md:py-24']} {...edit.root}>
    <div class="mx-auto max-w-[1440px] px-4 md:px-8">
      <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-3 border-b border-ink/10 pb-6" data-reveal>
        <div>
          {eyebrow && <p class="font-mono text-xs uppercase tracking-[0.25em] text-ink-soft" {...edit.eyebrow}>{eyebrow}</p>}
          <h2 class="mt-3 text-[clamp(2rem,5vw,3.25rem)]" {...edit.title}>{title}</h2>
        </div>
        {dateText && <p class="font-mono text-sm uppercase tracking-widest text-ink-soft" {...edit.dateLine}>{dateText}</p>}
      </div>
      <ol class="mt-8 grid grid-cols-2 items-end gap-x-4 gap-y-8 md:mt-12 md:gap-x-6 lg:grid-cols-4" role="list">
        {today.items.map((item, i) => (
          <li
            class:list={['group', item.soldOut && 'opacity-60']}
            data-reveal
            style={`--reveal-delay:${(i % 4) * 100}ms`}
          >
            {item.motif && (
              <Figure
                motif={item.motif}
                aspect={i === 0 ? 'aspect-square lg:aspect-[4/5]' : 'aspect-square'}
                sizes="(min-width: 1024px) 22vw, 45vw"
                hover
                class="mb-4"
              />
            )}
            <p class="flex items-start justify-between gap-2">
              <span class="font-display text-xl leading-tight md:text-2xl">
                <span class="mr-2 font-mono text-xs text-ink-soft align-middle">0{i + 1}</span>{item.name}
              </span>
              {item.soldOut && (
                <span class="shrink-0 rounded-full border border-closed px-2 py-0.5 font-mono text-[11px] uppercase tracking-wide text-closed" {...edit.soldOutLabel}>
                  {soldOutLabel}
                </span>
              )}
            </p>
            {item.note && (
              <p class:list={['mt-1 font-mono text-sm text-ink-soft', item.soldOut && 'line-through']}>{item.note}</p>
            )}
          </li>
        ))}
      </ol>
    </div>
  </section>
)}
