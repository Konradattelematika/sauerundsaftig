---
/** "Heute frisch"-Board aus der heuteFrisch-Collection, mit Datum + soldOut-Markierung. */
import { getCollection } from 'astro:content';
import { formatDate } from '../../../lib/format';
import Figure from './Figure.astro';

const entries = await getCollection('heuteFrisch');
const today = entries[0];
---

{today && (
  <section class="bg-bg-alt py-14 md:py-24">
    <div class="mx-auto max-w-[1440px] px-4 md:px-8">
      <div data-reveal>
        <p class="font-mono text-xs uppercase tracking-[0.25em] text-ink-soft">Heute frisch</p>
        <h2 class="mt-3 text-[clamp(2rem,5vw,3.25rem)]">Was heute aus dem Ofen kommt</h2>
        <p class="prose-measure mt-4 text-lg text-ink-soft">{formatDate(today.data.date)}</p>
      </div>
      <ul class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {today.data.items.map((item, i) => (
          <li
            class:list={['rounded-card border border-ink/10 bg-paper p-5', item.soldOut && 'opacity-60']}
            data-reveal
            style={`--reveal-delay:${(i % 3) * 100}ms`}
          >
            {item.motif && (
              <Figure motif={item.motif} aspect="aspect-square" sizes="(min-width: 1024px) 22vw, 45vw" class="mb-4" />
            )}
            <p class="flex items-start justify-between gap-2 text-lg">
              <span>{item.name}</span>
              {item.soldOut && (
                <span class="shrink-0 rounded-full border border-closed px-2 py-0.5 font-mono text-[11px] uppercase tracking-wide text-closed">
                  Vergriffen
                </span>
              )}
            </p>
            {item.note && (
              <p class:list={['mt-1 font-mono text-sm text-ink-soft', item.soldOut && 'line-through']}>{item.note}</p>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
