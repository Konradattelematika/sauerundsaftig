---
/**
 * Basis-Layout Variante A „Krume" — Editorial Warm.
 * Bindet Tokens (a.css), Header/Footer, Sticky-Bar, Motion und View-Transitions.
 * Jede Seite der Live-Site (Variante A im Wurzelpfad) nutzt dieses Layout.
 */
import '../../styles/a.css';
import { ClientRouter } from 'astro:transitions';
import SeoHead from '../../components/shared/SeoHead.astro';
import StickyBar from '../../components/shared/StickyBar.astro';
import Motion from '../../components/shared/Motion.astro';
import Header from './components/Header.astro';
import Footer from './components/Footer.astro';
import { terrazzoCssUrl } from '../../lib/textures';
import EditBridge from '../../cms/EditBridge.astro';
import { editBuild } from '../../cms';

interface Props {
  title: string;
  description: string;
  jsonLd?: object[];
  ogImage?: string;
  noindex?: boolean;
  ogTitle?: string;
  ogDescription?: string;
  canonical?: string;
}
const { title, description, jsonLd = [], ogImage, noindex = false, ogTitle, ogDescription, canonical } = Astro.props;
const base = '';
// Material Theke: eine optimierte Textur-URL fuer alle .tz-*-Klassen (s. styles/a-terrazzo.css)
const tzUrl = await terrazzoCssUrl();
---

<!doctype html>
<html lang="de" style={`--tz-url:${tzUrl}`}>
  <head>
    <SeoHead title={title} description={description} jsonLd={jsonLd} ogImage={ogImage} noindex={noindex} ogTitle={ogTitle} ogDescription={ogDescription} canonical={canonical} />
    <ClientRouter />
  </head>
  <body class="has-sticky-bar">
    <a class="skip-link" href="#main">Zum Inhalt springen</a>
    <Header base={base} />
    <main id="main">
      <slot />
    </main>
    <Footer base={base} />
    <StickyBar base={base} />
    <Motion />
    {editBuild && <EditBridge />}
  </body>
</html>
