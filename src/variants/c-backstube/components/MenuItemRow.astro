---
/**
 * Eine Karten-Position: Name, Beschreibung, Preis (Mono, groß), Veggie/Vegan-Stempel,
 * Allergene dezent, Saison-Hinweis. Für helle UND dunkle Sektionsflächen nutzbar (Prop `onDark`).
 */
import { formatMenuPrice } from '../../../lib/format';
import { stamp } from '../lib/ui';

interface Item {
  name: string;
  description?: string;
  price?: number;
  priceIsPlaceholder: boolean;
  priceSuffix?: string;
  veggie: boolean;
  vegan: boolean;
  allergens: string[];
  seasonal?: string;
  highlight: boolean;
}
interface Props {
  item: Item;
  onDark?: boolean;
}
const { item, onDark = false } = Astro.props;
const textMuted = onDark ? 'text-paper/80' : 'text-ink-soft';
const border = onDark ? 'border-paper/25' : 'border-ink/15';
---

<li class:list={['menu-item-row border-b py-6 first:pt-0 last:border-b-0 last:pb-0', border]}>
  <div class="flex flex-wrap items-start justify-between gap-x-6 gap-y-2">
    <div class="min-w-0 flex-1">
      <p class="font-display text-2xl font-extrabold uppercase leading-tight md:text-[1.75rem]">
        {item.name}
        {item.highlight && <span class="ml-2 align-middle text-accent-ink" aria-hidden="true">★</span>}
      </p>
      {item.description && <p class={`mt-1.5 max-w-[52ch] text-base ${textMuted}`}>{item.description}</p>}

      <div class="mt-3 flex flex-wrap items-center gap-2">
        {item.veggie && <span class={stamp}>Veggie</span>}
        {item.vegan && <span class={stamp}>Vegan</span>}
        {item.seasonal && <span class={stamp}>{item.seasonal}</span>}
      </div>

      {item.allergens.length > 0 && (
        <p class={`mt-2 font-mono text-[15px] ${textMuted}`}>Enthält: {item.allergens.join(', ')}</p>
      )}
    </div>

    <p class="shrink-0 whitespace-nowrap font-mono text-xl tabular md:text-2xl">
      {formatMenuPrice(item.price, item.priceIsPlaceholder, item.priceSuffix)}
    </p>
  </div>
</li>
